// covers: expr.logic.1

test "logic" {
    true && false  // => false
    ;
    false || true  // => true
    ;
    false && 1 / 0 == 0  // => false
    ;
    true || 1 / 0 == 0  // => true
    ;
    true && 1 / 1 == 1  // => true
}

test "the right operand runs when needed" {
    false || 1 / 0 == 0;  //~ trap
}
