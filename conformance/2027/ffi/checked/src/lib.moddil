// covers: ffi.types.1, ffi.export.1, ffi.extern.1

extern "C" {
    fn takes_text(s: &str) -> i32;          //~ E0222
    fn gives_vec() -> Vec<u8>;              //~ E0222
    fn has_body(x: i32) -> i32 { x }        //~ E0222
    fn abs(x: i32) -> i32;
}

fn outside() -> i32 {
    abs(-1)                                 //~ E0218
}

#[export]                                   //~ E0222
pub fn suspends() with suspend {}

#[export]
pub fn text(s: &str) {}                     //~ E0222
