// covers: ffi.types.1, ffi.export.1, ffi.extern.1, ffi.types.2

/// Not `#[repr(C)]`, so its layout is the compiler's: it does not cross C by value.
pub struct Loose {
    pub a: i32,
}

extern "C" {
    fn takes_text(s: &str) -> i32;          //~ E0222
    fn gives_vec() -> Vec<u8>;              //~ E0222
    fn has_body(x: i32) -> i32 { x }        //~ E0222
    fn by_value(l: Loose) -> i32;           //~ E0222
    fn abs(x: i32) -> i32;
}

fn outside() -> i32 {
    abs(-1)                                 //~ E0218
}

#[export]                                   //~ E0222
pub fn suspends() with suspend {}

#[export]
pub fn text(s: &str) {}                     //~ E0222
