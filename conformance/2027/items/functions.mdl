// covers: item.fn.decl.1, item.fn.params.1, item.fn.body.1

fn gcd(a: int, b: int) -> int {
    if b == 0 { a } else { gcd(b, a % b) }
}

fn nothing() {}

fn ignore(_: int, mut n: int) -> int {
    n = n * 2;
    n
}

test "functions" {
    gcd(48, 18)               // => 6
    ;
    nothing()                 // => ()
    ;
    ignore(1, 21)             // => 42
}
