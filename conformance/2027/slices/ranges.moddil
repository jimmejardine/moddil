// covers: expr.slice.1

fn sum(xs: &[int]) -> int {
    let mut s = 0;
    for x in xs {
        s += *x;
    }
    s
}

test "a range of an array, a slice or a Vec is a slice" {
    let a = [1, 2, 3, 4, 5];
    sum(&a[1..3])  // => 5
    ;
    sum(&a[..2])  // => 3
    ;
    sum(&a[3..])  // => 9
    ;
    sum(&a[..])  // => 15
    ;
    sum(&a[1..=3])  // => 9
    ;
    let s: &[int] = &a[1..];
    let t = &s[1..3];
    t.len()  // => 2
    ;
    t[0]  // => 3
    ;
    let v = Vec::from_array([10, 20, 30]);
    sum(&v[1..])  // => 50
}

test "a part borrowed with &mut changes the whole" {
    let mut a = [1, 2, 3, 4];
    let part = &mut a[1..3];
    part[0] = 20;
    part[1] = 30;
    a  // => [1, 20, 30, 4]
    ;
    let mut v = Vec::from_array([1, 2, 3]);
    let w = &mut v[..2];
    w[1] = 9;
    v.len()  // => 3
    ;
    v[1]  // => 9
}

test "split_at and split_at_mut" {
    let a = [1, 2, 3, 4];
    let (l, r) = a.split_at(1);
    sum(l) * 100 + sum(r)  // => 109
    ;
    let mut b = [1, 2, 3, 4];
    let (x, y) = b.split_at_mut(2);
    x[0] = y[1];
    y[0] = 7;
    b  // => [4, 2, 7, 4]
}

test "slicing out of bounds traps" {
    let a = [1, 2, 3];
    let n = 4;
    sum(&a[1..n])  //~ trap
}
