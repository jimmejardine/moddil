// covers: generic.1, generic.infer.1, generic.bound.1

struct Pair<A, B> { first: A, second: B }
struct Label { id: int }

fn id<T>(x: T) -> T { x }
fn keep<T: Clone>(x: T) -> T { x }

fn too_few(p: Pair<int>) {}                         //~ E0404
fn too_many() -> int { id::<int, bool>(1) }         //~ E0404
fn unknown() { let x = None; }                      //~ E0405
fn unbounded<T>(a: T, b: T) -> bool { a == b }      //~ E0205
fn no_method<T>(x: T) -> T { x.clone() }            //~ E0403
fn not_clone() { keep(Label { id: 1 }); }           //~ E0402
