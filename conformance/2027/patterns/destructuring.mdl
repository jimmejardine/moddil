// covers: stmt.let.pattern.1, item.fn.params.2

struct Point { x: int, y: int }

fn add((a, b): (int, int)) -> int { a + b }
fn norm(Point { x, y }: Point) -> int { x * x + y * y }

test "let and parameters destructure" {
    let (a, (b, _)) = (1, (2, 3));
    a + b                       // => 3
    ;
    let Point { x, y: mut z } = Point { x: 4, y: 5 };
    z += x;
    z                           // => 9
    ;
    add((3, 4))                 // => 7
    ;
    norm(Point { x: 3, y: 4 })  // => 25
}
