// covers: pat.lit.1, pat.range.1, expr.match.exhaustive.1
// Integer literals and ranges match any integer type, and its range is what must be covered.

fn class(b: u8) -> int {
    match b {
        0 => 0,
        1..=127 => 1,
        128..200 => 2,
        200.. => 3,
    }
}

fn sign(x: i8) -> int {
    match x {
        -128..=-1 => -1,
        0 => 0,
        1..=127 => 1,
    }
}

fn wide(x: u128) -> int {
    match x {
        170141183460469231731687303715884105727 => 1,
        0..=9 => 2,
        _ => 3,
    }
}

/// Every `i128` is covered: down to its least value and up to its greatest.
fn signs(x: i128) -> int {
    match x {
        -170141183460469231731687303715884105728..=-1 => -1,
        0 => 0,
        1..=170141183460469231731687303715884105727 => 1,
    }
}

fn by_borrow(b: &u16) -> bool {
    match b {
        65535 => true,
        _ => false,
    }
}

test "literals and ranges at the matched type" {
    class(0)                                // => 0
    ;
    class(127)                              // => 1
    ;
    class(199)                              // => 2
    ;
    class(255)                              // => 3
    ;
    sign(-128)                              // => -1
    ;
    sign(0)                                 // => 0
    ;
    sign(127)                               // => 1
    ;
    wide(170141183460469231731687303715884105727)   // => 1
    ;
    wide(340282366920938463463374607431768211455)   // => 3
    ;
    wide(7)                                 // => 2
    ;
    let m: u16 = 65535;
    by_borrow(&m)                           // => true
    ;
    signs(-170141183460469231731687303715884105728) // => -1
    ;
    signs(170141183460469231731687303715884105727)  // => 1
}
