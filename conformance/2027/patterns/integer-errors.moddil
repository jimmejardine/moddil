// covers: pat.lit.1, expr.match.exhaustive.1

fn too_big(b: u8) -> int {
    match b {
        300 => 0,  //~ E0204
        _   => 1,
    }
}
fn too_low(b: u8) -> int {
    match b {
        -1 => 0,  //~ E0204
        _  => 1,
    }
}
fn range_past(b: i8) -> int {
    match b {
        0..=200 => 0,  //~ E0204
        _       => 1,
    }
}
fn not_an_integer(c: char) -> int {
    match c {
        3 => 0,  //~ E0201
        _ => 1,
    }
}
fn not_covered(b: u8) -> int {
    match b {  //~ E0208
        0..=254 => 0,
    }
}
// An `i128`'s greatest value, and a `u128`'s past `i128`'s, are values a match must cover.
fn no_top(x: i128) -> int {
    match x {  //~ E0208
        -170141183460469231731687303715884105728..=0 => 0,
        1..=170141183460469231731687303715884105726  => 1,
    }
}
fn no_upper_half(x: u128) -> int {
    match x {  //~ E0208
        0..=170141183460469231731687303715884105727 => 0,
    }
}
fn past_u128(x: u128) -> int {
    match x {
        340282366920938463463374607431768211456 => 0,  //~ E0204
        _                                       => 1,
    }
}
fn past_u64(x: u64) -> int {
    match x {
        18446744073709551616 => 0,  //~ E0204
        _                    => 1,
    }
}
fn upper_half_missing(x: u128) -> int {
    match x {  //~ E0208
        0..=340282366920938463463374607431768211454 => 0,
    }
}
