// covers: err.fail.1, err.set.1, err.question.1, err.test.1, prelude.result.1

struct TooBig { n: int }
enum Parse { Empty, Bad(int) }

fn check(n: int) -> int with fail(TooBig) {
    if n > 9 { fail(TooBig { n }); }
    n
}

fn parse(n: int) -> int with fail(Parse) {
    if n == 0 { fail(Parse::Empty); }
    if n < 0 { fail(Parse::Bad(n)); }
    n
}

fn both(n: int) -> int with fail(TooBig | Parse) {
    let a = parse(n)?;
    check(a)? + 1
}

fn reify(n: int) -> Result<int, TooBig> {
    try { check(n)? }
}

fn reflect(r: Result<int, TooBig>) -> int with fail(TooBig) {
    r? * 2
}

test "errors propagate with ?" {
    both(3)?                                // => 4
    ;
    reify(4)                                // => Ok(4)
    ;
    reify(12)                               // => Err(TooBig { n: 12 })
    ;
    let r = try { both(0)? };
    r                                       // => Err(Parse::Empty)
    ;
    try { both(-2)? }                       // => Err(Parse::Bad(-2))
    ;
    try { both(50)? }                       // => Err(TooBig { n: 50 })
    ;
    try { reflect(Ok(5))? }                 // => Ok(10)
    ;
    reify(1).is_ok()                        // => true
}

fn first(o: Option<int>) -> Option<int> {
    let n = o?;
    Some(n + 1)
}

test "? on Option" {
    first(Some(1))                          // => Some(2)
    ;
    first(None)                             // => None
    ;
    let x: Option<int> = None;
    try { x? + 1 }                          // => None
    ;
    try { Some(2)? * 3 }                    // => Some(6)
}

test "an error that escapes a test fails it" {
    check(5)?;
    check(10)?;                             //~ error
    assert(false);
}
