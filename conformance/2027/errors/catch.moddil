// covers: err.try.1, err.catch.1, err.bang.1, err.discard.1

struct TooBig { n: int }
enum Parse { Empty, Bad(int) }

fn check(n: int) -> int with fail(TooBig) {
    if n > 9 { fail(TooBig { n }); }
    n
}

fn parse(n: int) -> int with fail(Parse) {
    if n == 0 { fail(Parse::Empty); }
    if n < 0 { fail(Parse::Bad(n)); }
    n
}

fn both(n: int) -> int with fail(TooBig | Parse) {
    check(parse(n)?)?
}

fn handled(n: int) -> int {
    try { both(n)? } catch {
        TooBig(t) => t.n * 100,
        Parse::Empty => -1,
        Parse::Bad(b) => b * 10,
    }
}

fn partly(n: int) -> int with fail(Parse) {
    try { both(n)? } catch {
        TooBig(_) => 0,
    }
}

fn guarded(n: int) -> int {
    try { both(n)? } catch {
        TooBig(t) if t.n > 20 => 2,
        TooBig(_) => 1,
        _ => 0,
    }
}

test "catch handles what its arms match" {
    handled(5)                              // => 5
    ;
    handled(12)                             // => 1200
    ;
    handled(0)                              // => -1
    ;
    handled(-3)                             // => -30
    ;
    partly(15)?                             // => 0
    ;
    try { partly(-1)? }                     // => Err(Parse::Bad(-1))
    ;
    guarded(30)                             // => 2
    ;
    guarded(11)                             // => 1
    ;
    guarded(0)                              // => 0
}

test "?! says an error cannot happen" {
    check(3) ?! "3 is small"                // => 3
    ;
    let r: Result<int, TooBig> = Ok(1);
    r ?! "built as Ok"                      // => 1
    ;
    discard(try { check(20)? }, "only checking");
    check(30) ?! "wrong";                   //~ trap
}
