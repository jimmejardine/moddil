// covers: type.ptr.1, expr.unsafe.1, mod.caps.1

use core::cell::UnsafeCell;

fn outside(p: *mut int) -> int {
    *p  //~ E0218
}

fn without_the_capability(p: *mut int) -> int {
    unsafe("p points to an int") {  //~ E0219
        *p
    }
}

fn through_const(p: *const int) {
    unsafe("p points to an int") {  //~ E0219
        *p = 1;  //~ E0302
    }
}

fn shared_is_not_mut(x: &int) -> *mut int {
    x  //~ E0201
}
