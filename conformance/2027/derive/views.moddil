// covers: attr.derive.1

// A view derives as a struct does, from its fields: a borrow's field is copied, compared and
// hashed as what it points to.
#[derive(Clone, Copy, PartialEq, Eq)]
view Span {
    text: &str,
    at: int,
}

#[derive(Clone, Debug, PartialEq, PartialOrd, Hash)]
view Count {
    n: int,
    name: String,
}

test "a view derives Clone, Copy and PartialEq" {
    let s = "hello";
    let a = Span { text: s, at: 1 };
    let b = a;
    let c = a.clone();
    a == b && c == a                        // => true
    ;
    a == Span { text: "x", at: 1 }          // => false
}

test "a view derives Debug, PartialOrd and Hash" {
    let k = Count { n: 2, name: "two".to_string() };
    fmt"{k:?}"                              // => "Count { n: 2, name: \"two\" }"
    ;
    k.clone() == k                          // => true
    ;
    k < Count { n: 3, name: "a".to_string() } // => true
}
