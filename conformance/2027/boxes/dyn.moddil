// covers: type.box.dyn.1, expr.closure.stored.1

trait Shape {
    fn area(&self) -> int;
}

struct Square {
    side: int,
}
impl Shape for Square {
    fn area(&self) -> int {
        self.side * self.side
    }
}

struct Rect {
    w: int,
    h: int,
}
impl Shape for Rect {
    fn area(&self) -> int {
        self.w * self.h
    }
}

struct Loud {
    n: int,
}
impl Shape for Loud {
    fn area(&self) -> int {
        self.n
    }
}
impl Drop for Loud {
    fn drop(self) {
        log.info(fmt"dropped {self.n}");
    }
}

fn total(shapes: &Vec<Box<dyn Shape>>) -> int {
    let mut sum = 0;
    for s in shapes {
        sum += (**s).area();
    }
    sum
}

fn measure(s: &dyn Shape) -> int {
    s.area()
}

struct Missing;

fn lookup(x: int) -> int with fail(Missing) {
    if x == 0 { fail(Missing) }
    x
}

test "a box owns a value of any type with the trait" {
    let mut shapes: Vec<Box<dyn Shape>> = Vec::new();
    shapes.push(Box::new(Square { side: 3 }));
    shapes.push(Box::new(Rect { w: 2, h: 5 }));
    total(&shapes)  // => 19
    ;
    let b: Box<dyn Shape> = Box::new(Rect { w: 4, h: 4 });
    measure(&*b)  // => 16
}

test "a boxed value is dropped as its own type" {
    let b: Box<dyn Shape> = Box::new(Loud { n: 5 });
    (*b).area()  // => 5
}

test "a stored closure is called through its box" {
    let k = 10;
    let add: Box<dyn Fn(int) -> int> = Box::new(|x| x + k);
    add(5)  // => 15
    ;
    let mut fs: Vec<Box<dyn Fn(int) -> int>> = Vec::new();
    fs.push(Box::new(|x| x * 2));
    fs.push(Box::new(|x| x + 1));
    let mut y = 3;
    for f in &fs {
        y = (**f)(y);
    }
    y  // => 7
    ;
    let check: Box<dyn Fn(int) -> int with fail(Missing)> = Box::new(|x| lookup(x)?);
    check(4)?  // => 4
    ;
    try { check(0)? } catch {
        Missing => -1,
    }  // => -1
}

struct Token {
    n: int,
}

test "a stored closure called once gives up its box" {
    let t = Token { n: 4 };
    let f: Box<dyn FnOnce() -> int> = Box::new(|| {
        let Token { n } = t;
        n * 2
    });
    f()  // => 8
    ;
    let mut jobs: Vec<Box<dyn FnOnce() -> int>> = Vec::new();
    jobs.push(Box::new(|| 1));
    jobs.push(Box::new(|| 2));
    let mut sum = 0;
    while let Some(job) = jobs.pop() {
        sum += job();
    }
    sum  // => 3
}

fn make_counter() -> Box<dyn FnMut() -> int> {
    let mut n = 0;
    Box::new(|| {
        n += 1;
        n
    })
}

test "a stored closure keeps what it owns and changes" {
    let mut c = make_counter();
    c();
    c();
    c()  // => 3
}
