// covers: expr.closure.stored.1

trait Clock {
    fn now(&self) -> int;
}
struct Fixed {
    at: int,
}
impl Clock for Fixed {
    fn now(&self) -> int {
        self.at
    }
}
fn fixed(at: int) -> Fixed {
    Fixed { at }
}

fn now() -> int with clock: Clock {
    clock.now()
}

/// A stored closure's handler needs are met where it is written; one it owns is installed in it.
test "a stored closure installs the handlers it uses" {
    let inner: Box<dyn Fn() -> int> = Box::new(|| { with Clock = fixed(1) { now() } });
    with Clock = fixed(50) {
        inner()  // => 1
    }
}

fn sleeps() with suspend {
    yield_now();
}

/// A closure bound to a local, then boxed with the control effects it has: the box's calls
/// have them, the function that made it not.
fn boxed() -> Box<dyn Fn() -> int with suspend> {
    let c = || {
        sleeps();
        2
    };
    Box::new(c)
}

test "a closure bound to a local first is boxed with its effects" {
    let b = boxed();
    b()  // => 2
}
