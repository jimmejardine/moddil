// covers: expr.closure.stored.1

trait Clock { fn now(&self) -> int; }
struct Fixed { at: int }
impl Clock for Fixed { fn now(&self) -> int { self.at } }
fn fixed(at: int) -> Fixed { Fixed { at } }

fn now() -> int with clock: Clock { clock.now() }

/// A stored closure's handler needs are met where it is written; one it owns is installed in it.
test "a stored closure installs the handlers it uses" {
    let inner: Box<dyn Fn() -> int> = Box::new(|| {
        with Clock = fixed(1) { now() }
    });
    with Clock = fixed(50) {
        inner()                                      // => 1
    }
}
