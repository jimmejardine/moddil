// covers: gpu.1, gpu.test.1

use core::gpu;

// The tile a kernel draws: `core::gpu`'s, of 8 x 8 RGBA8 pixels.
type Tile = core::gpu::Tile<core::gpu::Rgba8, 8, 8>;

struct Params {
    n: int,
}

#[kernel]
fn draws(p: &Params, out: &mut Tile) {
    out.x = p.n;
}

test "a test has no GPU and no window" {
    // The kernel's WGSL is made by a compiler with a GPU back end; a test never dispatches it.
    let params = Params { n: 1 };
    let mut out: [u32; 4] = [0; 4];
    gpu::dispatch(gpu::source(&draws), gpu::bytes(&params), 2, 2, 8, 8, &mut out, 3)  // => 0
    ;
    // Nothing to show it on: `show` does nothing.
    gpu::show(&out, 2, 2);
    let mut words = [0; 8];
    gpu::frame(&mut words);
    words[7]  // => 1
}
