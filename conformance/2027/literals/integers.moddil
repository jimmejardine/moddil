// covers: expr.lit.int.1, expr.lit.int.2, expr.lit.bool.1, expr.lit.unit.1

test "integer literals" {
    1_000_000  // => 1000000
    ;
    0xff  // => 255
    ;
    0o17  // => 15
    ;
    0b1010_1010  // => 170
    ;
    -9223372036854775808  // => -9223372036854775808
    ;
    0x7fff_ffff_ffff_ffff  // => 9223372036854775807
}

test "other literals" {
    false  // => false
    ;
    ()  // => ()
}
