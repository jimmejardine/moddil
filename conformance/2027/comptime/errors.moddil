// covers: comptime.const-fn.2, comptime.static.1, comptime.block.1

trait Time { fn now(&self) -> int; }

fn plain(x: int) -> int { x }

const A: int = plain(1);                    //~ E1001

const fn now() -> int with clock: Time {    //~ E1002
    clock.now()
}

fn uses_block() -> int {
    const { plain(2) }                      //~ E1001
}

const LOCAL: &mut int = &mut 1;             //~ E1003

// A `const { }` block names no local of the body it is in.
fn names_a_local() -> int {
    let n = 1;
    const { n + 1 }                         //~ E0101
}
