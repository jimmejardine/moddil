// covers: comptime.tag.fields.2, comptime.tag.fields.3

use regex::re;

// A field is named as a struct's field is: `type` is a keyword.
fn keyword_group() -> bool {
    re"(?<type>a)".is_match("a")  //~ E1012
}

// A field's type is one the literal can read: `f64` is not yet.
fn float_group() -> bool {
    re"(?<x:f64>\d+)".is_match("1")  //~ E1012
}
