// covers: comptime.template.1, attr.derive-by.1

/// Describes a value: each field's, in order.
#[derive_by(describe)]
trait Describe {
    fn describe(&self) -> String;
}

const fn describe(t: type) -> Impl<Describe> {
    impl Describe for t {
        fn describe(&self) -> String {
            let mut out = String::new();
            inline for f in fields(t) {
                out.push_str(f.name);
                out.push_str("=");
                out.push_str(&self.[f].describe());
                out.push_str(";");
            }
            out
        }
    }
}

impl Describe for int {
    fn describe(&self) -> String {
        fmt"{self}"
    }
}

#[derive(Describe)]
struct Pair<T> {
    a: T,
    b: T,
}

#[derive(Describe)]
struct Labelled<T, const N: int> {
    value: T,
    count: int,
}

test "a template derives for a generic struct, its parameter bounded by the trait" {
    let p = Pair { a: 1, b: 2 };
    p.describe()  // => "a=1;b=2;"
    ;
    let q = Pair { a: Pair { a: 3, b: 4 }, b: Pair { a: 5, b: 6 } };
    q.describe()  // => "a=a=3;b=4;;b=a=5;b=6;;"
    ;
    let l: Labelled<int, 2> = Labelled { value: 7, count: 2 };
    l.describe()  // => "value=7;count=2;"
    ;
}
