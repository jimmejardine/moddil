// covers: borrow.reassign.1

enum Tree {
    Leaf(int),
    Branch(Vec<Tree>),
}

// Down the first branch to its leaf.
fn leftmost(t: &Tree) -> int {
    let mut at = t;
    loop {
        match at {
            Tree::Leaf(x)    => return *x,
            Tree::Branch(ts) => at = &ts[0],
        }
    }
}

struct Cell {
    value: int,
    next: Option<Box<Cell>>,
}

view Cursor {
    at: &Cell,
}

impl Cursor {
    // Moves to the next cell, giving whether there was one.
    fn advance(&mut self) -> bool {
        match &self.at.next {
            Some(n) => {
                self.at = &**n;
                true
            }
            None => false,
        }
    }
}

test "walking down through borrows" {
    let t = Tree::Branch([Tree::Branch([Tree::Leaf(7), Tree::Leaf(8)]), Tree::Leaf(9)]);
    leftmost(&t)  // => 7
    ;
    let list = Cell { value: 1, next: Some(Box::new(Cell { value: 2, next: None })) };
    let mut c = Cursor { at: &list };
    let mut total = c.at.value;
    while c.advance() {
        total += c.at.value;
    }
    total  // => 3
}
