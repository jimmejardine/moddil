// covers: expr.match.1, expr.match.type.1

enum Shape { Dot, Circle(int) }

fn zero() -> int { 0 }

fn first_match(n: int) -> int {
    match n {
        x if x > 10 => 2,
        x if x > 5 => 1,
        _ => 0,
    }
}

test "the first arm that matches, and whose guard holds, runs" {
    (first_match(20), first_match(7), first_match(1)) // => (2, 1, 0)
}

test "guards run only when the pattern matches" {
    match Shape::Dot {
        Shape::Circle(r) if 10 / r > 1 => 1,
        _ => 0,
    }                           // => 0
}

test "the scrutinee is evaluated once" {
    match 1 / zero() {          //~ trap
        _ => 0,
    };
}

test "an arm of type ! fits" {
    let n = match Shape::Circle(3) {
        Shape::Circle(r) => r,
        Shape::Dot => return,
    };
    n                           // => 3
}
