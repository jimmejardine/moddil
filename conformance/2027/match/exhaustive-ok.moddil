// covers: expr.match.exhaustive.1

enum Shape {
    Dot,
    Circle(int),
}
enum Never {}

fn sign(n: int) -> int {
    match n {
        -9223372036854775808..0 => -1,
        0                       => 0,
        1..                     => 1,
    }
}

fn both(a: bool, b: bool) -> int {
    match (a, b) {
        (true, true)                  => 3,
        (true, false) | (false, true) => 1,
        (false, false)                => 0,
    }
}

fn never(n: Never) -> int {
    match n {}
}

test "exhaustive matches" {
    (sign(-4), sign(0), sign(9), both(true, false))  // => (-1, 0, 1, 1)
}
