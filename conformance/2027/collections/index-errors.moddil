// covers: expr.index.trait.1

// Changing an element needs `IndexMut`: a type with only `Index` is read through it.
struct Ro {
    x: int,
}
impl Index for Ro {
    type Output = int;
    fn index(&self, i: int) -> &int {
        &self.x
    }
}

fn read(r: &Ro) -> int {
    r[0]
}

fn write(mut r: Ro) {
    r[0] = 1;  //~ E0205
}
