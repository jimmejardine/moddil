// covers: task.cancel.1, task.cancel.2, task.error.1

#[derive(Debug, Clone, PartialEq)]
struct Oops { n: int }

fn risky(x: int) -> int with fail(Oops) {
    if x > 0 {
        fail(Oops { n: x })
    }
    x
}


fn shown(r: Result<int, Oops>) -> int {
    match r {
        Ok(v) => v,
        Err(Oops { n }) => -n,
    }
}

test "a failing task given up cancels the others where they wait" {
    let mut cleaned = false;
    let mut reached = false;
    let (tx, rx) = channel::<int>(1);
    let r = try {
        scope(|s| {
            s.spawn(|| {
                defer {
                    cleaned = true;
                }
                rx.recv();                  // waits: nothing is ever sent
                reached = true;
            });
            s.spawn(|| risky(4)?)?;
            0
        })?
    };
    shown(r)                                // => -4
    ;
    cleaned                                 // => true
    ;
    reached                                 // => false
}

test "a failing body cancels its tasks" {
    let mut cleaned = 0;
    let r = try {
        scope(|s| {
            s.spawn(|| {
                defer {
                    cleaned += 1;
                }
                yield_now();
                cleaned += 10;
            });
            yield_now();
            risky(2)?
        })?
    };
    shown(r)                                // => -2
    ;
    cleaned                                 // => 1
}

test "a task still held keeps its error for its join" {
    let r = try {
        scope(|s| {
            let t = s.spawn(|| risky(5)?)?;
            yield_now();
            shown(try { t.join()? })
        })?
    };
    shown(r)                                // => -5
}

// A cancelled task's cleanup is not cancelled again: its `defer` waits, and then finishes.
test "cleanup runs to its end, even when it waits" {
    let mut cleaned = 0;
    let (tx, rx) = channel::<int>(1);
    let r = try {
        scope(|s| {
            s.spawn(|| {
                defer {
                    yield_now();
                    cleaned = 2;
                }
                rx.recv();
            });
            yield_now();
            risky(1)?
        })?
    };
    shown(r)                                // => -1
    ;
    cleaned                                 // => 2
}

// Not even an isolated scope catches a trap while unwinding: it ends the program.
test "a trap while unwinding ends the program" {
    let r = try {
        scope(|s| {
            s.spawn(|| {
                defer {
                    assert(false);          //~ trap
                }
                yield_now();
            });
            yield_now();
            risky(1)?
        }, isolate: true)?
    };
}

test "cancellation reaches the scopes inside" {
    let mut inner = false;
    let r = try {
        scope(|s| {
            s.spawn(|| scope(|t| {
                t.spawn(|| {
                    defer {
                        inner = true;
                    }
                    yield_now();
                    yield_now();
                });
            }));
            yield_now();
            risky(9)?
        })?
    };
    shown(r)                                // => -9
    ;
    inner                                   // => true
}

test "a cancelled send's value is dropped" {
    let held = 1.to_rc();
    let (tx, rx) = channel::<Rc<int>>(1);
    let r = try {
        tx.send(0.to_rc())?;                // the channel is full
        scope(|s| {
            let v = held.share();
            s.spawn(|| {
                tx.send(v)?;                // waits for room, and is cancelled
            })?;
            yield_now();
            risky(3)?
        })?
    };
    Rc::strong_count(&held)                 // => 1
}

// A join of a cancelled task is reached only by a task unwinding too, in its cleanup: it leaves
// that cleanup, and the unwinding goes on with the rest.
test "a cleanup that joins a cancelled task leaves that cleanup" {
    let mut before = false;
    let mut after = false;
    let mut later = false;
    let (tx, rx) = channel::<int>(1);
    let (tx2, rx2) = channel::<int>(1);
    let r = try {
        scope(|s| {
            let t = s.spawn(|| {
                rx.recv();                  // waits: nothing is sent, so it is cancelled
                1
            });
            defer {
                later = true;
            }
            defer {
                before = true;
                let v = t.join();           // a cancelled task: this cleanup is left
                after = true;
            }
            s.spawn(|| risky(2)?)?;
            rx2.recv();                     // waits, and is cancelled by the failure
            0
        })?
    };
    before                                  // => true
    ;
    after                                   // => false
    ;
    later                                   // => true
}
