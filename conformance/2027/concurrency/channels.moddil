// covers: task.channel.1, task.channel.2, task.channel.3

test "values arrive in order, and `None` once every sender is gone" {
    let mut got: Vec<int> = [];
    let (tx, rx) = channel::<int>(2);
    scope(|s| {
        // The sender is moved into its task, so the channel closes when the task ends.
        s.spawn(|| {
            let tx = tx;
            let mut i = 0;
            while i < 5 {
                tx.send(i)?!"the receiver is alive";
                i += 1;
            }
        });
        s.spawn(|| {
            loop {
                match rx.recv() {
                    Some(v) => got.push(v),
                    None => break,
                }
            }
        });
    });
    got                                     // => [0, 1, 2, 3, 4]
}

test "a sender is cloned, and the channel closes when the last goes" {
    let mut total = 0;
    let (tx, rx) = channel::<int>(0);
    let tx2 = tx.clone();
    scope(|s| {
        s.spawn(|| {
            let tx = tx;
            tx.send(1)?!"alive";
        });
        s.spawn(|| {
            let tx2 = tx2;
            tx2.send(2)?!"alive";
        });
        s.spawn(|| {
            while let Some(v) = rx.recv() {
                total += v;
            }
        });
    });
    total                                   // => 3
}

// Each task logs what it reached: with a capacity of 0, the sender goes on only once its value is
// received, so it logs 3 after the receiver's 2.
test "a send of a rendezvous waits for the value to be received" {
    let (tx, rx) = channel::<int>(0);
    let (log, seen) = channel::<int>(3);
    scope(|s| {
        s.spawn(|| {
            let tx = tx;
            log.send(1)?!"alive";
            tx.send(7)?!"alive";
            log.send(3)?!"alive";
        });
        s.spawn(|| {
            rx.recv();
            log.send(2)?!"alive";
        });
    });
    (seen.recv(), seen.recv(), seen.recv()) // => (Some(1), Some(2), Some(3))
}

test "a negative capacity traps" {
    channel::<int>(-1);                     //~ trap
}

struct Armed;
impl Drop for Armed { fn drop(self) { assert(false); } }

test "values left in a channel are dropped, for now without their destructors" {
    let (tx, rx) = channel::<Armed>(1);
    tx.send(Armed)?!"alive";
    drop(rx);
    drop(tx);
    0                                       // => 0
}

test "a send fails with `Closed` once the receiver is gone" {
    let (tx, rx) = channel::<int>(1);
    drop(rx);
    let r = try { tx.send(1)? };
    r                                       // => Err(Closed)
}

test "a receive no send can meet deadlocks" {
    let (tx, rx) = channel::<int>(1);
    rx.recv();                              //~ trap
    drop(tx);
}
