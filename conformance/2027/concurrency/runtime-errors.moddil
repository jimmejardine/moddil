// covers: task.runtime.1

fn helper() -> int {
    with Runtime = Runtime::seeded(1) {  //~ E0611
        1
    }
}

fn main() -> int {
    with Runtime = Runtime::seeded(1) {
        let f = || {
            with Runtime = Runtime::seeded(2) {  //~ E0611
                2
            }
        };
        with Runtime = Runtime::seeded(3) {  //~ E0611
            f() + helper()
        }
    }
}

test "a test runs under the runtime `moddil test` chooses" {
    with Runtime = Runtime::seeded(4) {  //~ E0611
        0
    }
}
