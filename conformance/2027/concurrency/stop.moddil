// covers: task.stop.1

// Each task sends its number when the stop reaches it, so the channel holds the order. The first
// task yields so that the second opens its scope before the first asks.
test "a stop reaches the inner scope's tasks first" {
    let (tx, rx) = channel::<int>(2);
    scope(|s| {
        s.spawn (|| {
            yield_now();
            stop_requested();
            tx.send(2) ?! "the receiver is alive";
        });
        s.spawn (|| scope(|inner| {
            inner.spawn (|| {
                stop_requested();
                tx.send(1) ?! "the receiver is alive";
            });
        }));
        s.stop();
    });
    (rx.recv(), rx.recv())  // => (Some(1), Some(2)) (in parallel, in any order)
}
