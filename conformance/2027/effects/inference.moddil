// covers: eff.infer.1, eff.need.1, err.set.1

pub trait Log {
    fn line(&self, n: int) -> int;
}
struct Doubling;
impl Log for Doubling {
    fn line(&self, n: int) -> int { n * 2 }
}

fn emit(n: int) -> int with log: Log { log.line(n) }

// Private functions need what they reach, without saying so, through recursion too.
fn countdown(n: int) -> int {
    if n == 0 { emit(1) } else { countdown(n - 1) + 1 }
}
fn even(n: int) -> int {
    if n == 0 { emit(10) } else { odd(n - 1) }
}
fn odd(n: int) -> int {
    if n == 0 { 0 } else { even(n - 1) }
}

// A method of an inherent impl is inferred too.
struct Counter { start: int }
impl Counter {
    fn run(&self) -> int { countdown(self.start) }
}

test "private functions infer their effects" {
    with Log = Doubling {
        countdown(3)                        // => 5
        ;
        even(4)                             // => 20
        ;
        Counter { start: 2 }.run()          // => 4
    }
}

// A private function's errors are inferred, and its callers mark its calls.
pub struct TooBig { n: int }
pub struct Negative;

fn check(n: int) -> int {
    if n > 9 { fail(TooBig { n }); }
    if n < 0 { fail(Negative); }
    n
}
fn twice(n: int) -> int { check(n)? * 2 }

test "private functions infer their errors" {
    try { twice(3)? }                       // => Ok(6)
    ;
    let r = try { twice(12)? } catch {
        TooBig(t) => t.n,
        Negative => -1,
    };
    r                                       // => 12
    ;
    try { twice(-5)? } catch { TooBig(_) => 0, Negative => -1 } // => -1
}

// A handler whose methods fail, used by a private function, adds its errors to the function's.
struct Full;
trait Sink {
    fn put(&self, n: int) with fail(Full);
}
struct Small { cap: int }
impl Sink for Small {
    fn put(&self, n: int) with fail(Full) {
        if n > self.cap { fail(Full); }
    }
}
fn fill(n: int) -> int with sink: Sink {
    sink.put(n)?;
    n
}

test "errors and effects are inferred together" {
    let s = Small { cap: 4 };
    with Sink = &s {
        try { fill(3)? }                    // => Ok(3)
        ;
        try { fill(9)? }                    // => Err(Full)
    }
}

fn unmarked() -> int { check(1) }                               //~ E0501
pub fn exposed() -> int { emit(1) }                             //~ E0603
pub fn exposed_error() -> int with fail(TooBig) { check(1)? }  //~ E0502
pub fn listed() -> int with Log, fail(TooBig | Negative) { emit(check(1)?) }
