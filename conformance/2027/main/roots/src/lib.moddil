// covers: main.root.1

use moddil::root::{Args, NetRoot, Stdio};

fn main(args: Args, stdio: Stdio, net: NetRoot) -> ExitCode {
    ExitCode::Ok
}

// The capabilities are values like any other: `main` passes them on.
fn serve(net: NetRoot) -> int { 0 }

fn main_body(args: Args, stdio: Stdio, net: NetRoot) -> int { serve(net) }
