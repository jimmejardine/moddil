// covers: own.drop.destructor.1, own.drop.partial.1, own.drop.1, own.copy.derive.1

struct Guard {
    armed: bool,
}
impl Drop for Guard {
    fn drop(self) {
        assert(!self.armed);
    }
}

struct Holder {
    g: Guard,
    n: int,
}
impl Drop for Holder {
    fn drop(self) {
        let Holder { g, n } = self;
    }
}

struct Wrap<T> {
    x: T,
}
struct Pair<T> {
    x: T,
}

impl Drop for Option<int> {  //~ E0411
    fn drop(self) {}
}
impl Drop for Wrap<int> {  //~ E0411
    fn drop(self) {}
}
impl<T: Clone> Drop for Pair<T> {  //~ E0411
    fn drop(self) {}
}

#[derive(Copy, Clone)]
struct Point {  //~ E0411
    x: int,
}
impl Drop for Point {
    fn drop(self) {}
}

fn call(g: Guard) {
    g.drop();  //~ E0412
}
fn call_path(g: Guard) {
    Drop::drop(g);  //~ E0412
}
