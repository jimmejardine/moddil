// covers: own.copy.derive.1

struct Label {
    id: int,
}

#[derive(Copy, Clone)]
struct Holder {  //~ E0311
    l: Label,
}

#[derive(Copy)]  //~ E0311
struct Bare;

#[derive(Copy, Clone)]
struct Big {  //~ E0312
    a: (int, int, int, int),
    b: (int, int, int, int, int),
}

#[derive(Copy, Clone)]
enum Wide {  //~ E0312
    A((int, int, int, int, int, int, int, int)),
}
