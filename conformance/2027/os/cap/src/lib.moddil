// covers: os.1, os.cap.1, os.test.1, os.clock.1

use core::os;

test "a test has no OS" {
    os::arg_count()                         // => 0
    ;
    os::listen(80)                          // => -1
    ;
    os::connect("localhost", 80)            // => -1
    ;
    os::random() > 0                        // => true
    ;
    os::wall_clock()                        // => 0
    ;
    os::incoming(0).recv().is_none()        // => true
    ;
    os::arrivals(0).recv().is_none()        // => true
}

test "a timeout outlasts the signals that never come" {
    let s = os::signals();
    select {
        n = s.recv() => n.unwrap_or(-1),
        _ = timer(Duration::seconds(1)).recv() => 0,
    }                                       // => 0
}
