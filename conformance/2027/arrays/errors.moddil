// covers: type.slice.1, expr.index.1, expr.index.2, generic.const.2, expr.array.1, expr.array.repeat.1, expr.array.from.1

fn by_value(s: [int]) {}                    //~ E0901

fn not_indexable(n: int) -> int {
    n[0]                                    //~ E0205
}

fn bad_index(a: [int; 2]) -> int {
    a[true]                                 //~ E0201
}

fn not_a_type<const N: int>(x: N) {}        //~ E0102

fn not_a_length<T>(a: [int; T]) {}          //~ E0201

struct Name { n: int }

fn mixed() { let a = [1, true]; }           //~ E0201
fn not_copy() { let a = [Name { n: 1 }; 2]; } //~ E0402
fn run_time(n: int) { let a = [0; n]; }     //~ E0201

// An array literal where another type is expected makes one only through `FromArrayLiteral`.
struct Plain { n: int }
fn not_from_array() { let p: Plain = [1, 2]; } //~ E0402
