// covers: attr.track-caller.1

#[track_caller]
fn positive(n: int) -> int {
    assert(n > 0);
    n
}

#[track_caller]
fn twice(n: int) -> int {
    positive(n) * 2
}

fn plain(n: int) -> int {
    assert(n > 0);  //~ trap
    n
}

test "a tracked function's trap is reported where it is called" {
    positive(3)  // => 3
    ;
    positive(-1);  //~ trap
}

test "through tracked callers, to the first untracked one" {
    twice(-1);  //~ trap
}

test "an untracked function's trap is reported in it" {
    plain(-1);
}

test "the prelude's arithmetic is tracked" {
    Add::add(9223372036854775807, 1);  //~ trap
}
