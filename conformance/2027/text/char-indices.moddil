// covers: text.find.2

test "each character with its position, by bytes on character boundaries" {
    let s = "aé😀b";
    let mut offsets: Vec<int> = Vec::new();
    let mut chars: Vec<char> = Vec::new();
    for (p, c) in s.char_indices() {
        offsets.push(p.offset());
        chars.push(c);
    }
    offsets                                 // => [0, 1, 3, 7]
    ;
    chars                                   // => ['a', 'é', '😀', 'b']
}

test "a String's positions slice it" {
    let t = "key=value".to_string();
    let mut eq = t.start();
    for (p, c) in t.char_indices() {
        if c == '=' {
            eq = p;
        }
    }
    &t[..eq]                                // => "key"
}
