// covers: text.pattern.1

test "contains takes text or a character" {
    "shorty".contains("ort")                // => true
    ;
    "shorty".contains('z')                  // => false
    ;
    "shorty".starts_with('s')               // => true
    ;
    let mut tail = String::new();
    tail.push_str("ty");
    "shorty".ends_with(&tail)               // => true
    ;
    tail.contains('y')                      // => true
}

const ALPHABET: &str = "abc";
type Code = String where self.chars().all(|c| ALPHABET.contains(c));

test "in a refinement" {
    let mut s = String::new();
    s.push_str("cab");
    let c = Code::new(s) ?! "from the alphabet";
    c.len()                                 // => 3
}
