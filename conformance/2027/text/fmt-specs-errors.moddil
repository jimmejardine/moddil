// covers: expr.fmt.spec.1, expr.fmt.spec.2, expr.fmt.spec.3

fn no_width(n: int) -> String {
    fmt"{n:>}"                              //~ E0902
}

fn not_a_spec(n: int) -> String {
    fmt"{n:abc}"                            //~ E0902
}

fn an_int_has_no_digits(n: int) -> String {
    fmt"{n:.2}"                             //~ E0902
}

fn zeros_are_for_numbers(s: &str) -> String {
    fmt"{s:08}"                             //~ E0902
}

fn debug_text_is_not_cut(s: &str) -> String {
    fmt"{s:.2?}"                            //~ E0902
}
