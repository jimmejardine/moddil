// covers: text.pos.1

fn by_int(s: &str) -> &str {
    &s[0..2]                                    //~ E0201
}

fn through(s: &str) -> &str {
    let p = s.find(' ') ?! "a space";
    &s[s.start()..=p]                           //~ E0201
}

fn unsized(xs: &[int]) {
    let part = xs[1..];                         //~ E0605
}

fn not_sliceable(n: int) {
    let x = &n[0..1];                           //~ E0205
}
