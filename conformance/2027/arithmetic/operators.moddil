// covers: expr.arith.ops.1, expr.arith.neg.1, expr.paren.1, expr.order.1

test "operators" {
    7 + 3  // => 10
    ;
    7 - 10  // => -3
    ;
    -7 * 3  // => -21
    ;
    7 / 2  // => 3
    ;
    -7 / 2  // => -3
    ;
    7 % 3  // => 1
    ;
    -7 % 3  // => -1
    ;
    7 % -3  // => 1
    ;
    -(2 + 3)  // => -5
    ;
    2 + 3 * 4  // => 14
    ;
    (2 + 3) * 4  // => 20
    ;
    10 - 2 - 3  // => 5
}

test "left to right" {
    let mut x = 1;
    x + {
        x = 10;
        x
    }  // => 11
}
