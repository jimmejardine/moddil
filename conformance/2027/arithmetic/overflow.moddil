// covers: expr.arith.overflow.1, trap.1

fn max() -> int { 9223372036854775807 }
fn min() -> int { -9223372036854775807 - 1 }

test "in range" {
    max() - 1 + 1             // => 9223372036854775807
    ;
    min() + 1 - 1             // => -9223372036854775808
}

test "addition" {
    max() + 1;                //~ trap
}

test "subtraction" {
    min() - 1;                //~ trap
}

test "multiplication" {
    let x = 4611686018427387904; x * 2; //~ trap
}

test "negation" {
    -min();                   //~ trap
}

test "division" {
    min() / -1;               //~ trap
}
