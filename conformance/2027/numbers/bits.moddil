// covers: num.bits.1

test "count_ones" {
    0.count_ones()  // => 0
    ;
    11.count_ones()  // => 3
    ;
    (-1).count_ones()  // => 64
    ;
    let least: int = -9223372036854775807 - 1;
    least.count_ones()  // => 1
    ;
    let a: i8 = -1;
    a.count_ones()  // => 8
    ;
    let b: i8 = -128;
    b.count_ones()  // => 1
    ;
    let c: u8 = 255;
    c.count_ones()  // => 8
    ;
    let d: u32 = 4294967295;
    d.count_ones()  // => 32
    ;
    let e: i128 = -1;
    e.count_ones()  // => 128
    ;
    let f: u16 = 0b1010_1010;
    f.count_ones()  // => 4
}
