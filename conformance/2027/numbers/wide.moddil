// covers: num.types.1, num.lit.1, num.ops.1
// `i128` and `u128` division, remainder and multiplication, and their traps: native code does
// the division and the overflow check in the runtime, as Cranelift cannot compile them.

test "i128 division and remainder round toward zero" {
    let a: i128 = -81000000000000000000000000000000000007;
    let b: i128 = 9000000000000000000;
    a / b  // => -9000000000000000000
    ;
    a % b  // => -7
    ;
    a * -1 / b  // => 9000000000000000000
}

test "the widest types' ends are written as literals" {
    let max: u128 = 340282366920938463463374607431768211455;
    max  // => 340282366920938463463374607431768211455
    ;
    let hex: u128 = 0xffff_ffff_ffff_ffff_ffff_ffff_ffff_ffff;
    max == hex  // => true
    ;
    let min: i128 = -170141183460469231731687303715884105728;
    min  // => -170141183460469231731687303715884105728
    ;
    let f: f64 = 340282366920938463463374607431768211455;
    f > 3.0e38  // => true
}

test "u128 division and remainder" {
    let max: u128 = 340282366920938463463374607431768211455;
    max / 3  // => 113427455640312821154458202477256070485
    ;
    max % 7  // => 3
}

test "a product that fits is exact" {
    let a: i128 = -9000000000000000000;
    a * 9000000000000000000  // => -81000000000000000000000000000000000000
    ;
    let u: u128 = 18446744073709551616;
    u * 3  // => 55340232221128654848
}

test "an i128 product that does not fit traps" {
    let a: i128 = 170141183460469231731687303715884105727;
    let b: i128 = 2;
    a * b;  //~ trap
}

test "a u128 product that does not fit traps" {
    let a: u128 = 340282366920938463463374607431768211455;
    let b: u128 = 2;
    a * b;  //~ trap
}

test "dividing by zero traps" {
    let a: u128 = 5;
    let b: u128 = 0;
    a % b;  //~ trap
}

test "the least i128 over -1 traps" {
    let a: i128 = -170141183460469231731687303715884105728;
    let b: i128 = -1;
    a / b;  //~ trap
}

test "literal arithmetic past i128 is done in its type" {
    let a: u128 = 340282366920938463463374607431768211455 - 1;
    a  // => 340282366920938463463374607431768211454
    ;
    let b: u128 = 170141183460469231731687303715884105727 + 1;
    b  // => 170141183460469231731687303715884105728
    ;
    let f: f64 = 170141183460469231731687303715884105727 * 4;
    f > 6.0e38  // => true
}

test "literal arithmetic past i128 overflows an i128" {
    let a: i128 = 170141183460469231731687303715884105727 + 1;  //~ trap
}

test "literal arithmetic past u128 overflows a u128" {
    let a: u128 = 340282366920938463463374607431768211455 + 1;  //~ trap
}

fn take(x: u128) -> u128 {
    x
}

fn below_max() -> u128 {
    340282366920938463463374607431768211455 - 1
}

fn returns_it() -> u128 {
    return 340282366920938463463374607431768211455 - 2;
}

struct Big(u128);

test "literal arithmetic past i128 as an argument or a result" {
    take(340282366920938463463374607431768211455 - 1)  // => 340282366920938463463374607431768211454
    ;
    take((170141183460469231731687303715884105727 + 1))  // => 170141183460469231731687303715884105728
    ;
    below_max()  // => 340282366920938463463374607431768211454
    ;
    returns_it()  // => 340282366920938463463374607431768211453
    ;
    let b = Big(170141183460469231731687303715884105727 * 2);
    b.0  // => 340282366920938463463374607431768211454
}

fn narrow(x: i128) -> i128 {
    x
}

test "literal arithmetic past i128 overflows an i128 argument" {
    narrow(170141183460469231731687303715884105727 + 1);  //~ trap
}

struct Holder;

impl Holder {
    fn keep(&self, x: u128) -> u128 {
        x
    }
}

test "literal arithmetic past i128 as a method's argument" {
    let h = Holder;
    h.keep(340282366920938463463374607431768211455 - 3)  // => 340282366920938463463374607431768211452
}
