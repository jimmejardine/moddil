// covers: num.types.1, num.lit.1, num.float.1, num.float.fn.1

fn half(x: f32) -> f32 { x / 2.0 }

test "f64 by default" {
    let x = 0.1;
    x + 0.2                                 // => 0.30000000000000004
}

test "f32 where it is written" {
    let x: f32 = 0.1;
    x + 0.2                                 // => 0.3
    ;
    half(3.0)                               // => 1.5
}

test "IEEE division and NaN" {
    let z: f64 = 0.0;
    1.0 / z                                 // => inf
    ;
    let n = z / z;
    n == n                                  // => false
    ;
    n.is_nan()                              // => true
    ;
    -0.0 == z                               // => true
}

test "the float functions" {
    let two: f64 = 2.0;
    two.sqrt()                              // => 1.4142135623730951
    ;
    let x: f32 = 2.0;
    x.sqrt()                                // => 1.4142135
    ;
    let a: f64 = 1.5;
    a.floor()                               // => 1.0
    ;
    a.max(4.0)                              // => 4.0
    ;
    a.clamp(0.0, 1.0)                       // => 1.0
    ;
    a.powi(2)                               // => 2.25
    ;
    let zero: f64 = 0.0;
    zero.cos()                              // => 1.0
}

test "floats in text" {
    let x: f32 = 1.25;
    fmt"{x}"                                // => "1.25"
}

test "f32 widens to f64" {
    let x: f32 = 0.5;
    let y: f64 = x;
    y * 2.0                                 // => 1.0
}

test "arithmetic on literals is exact, then typed" {
    let y: f32 = 0.1 * 3.0;
    y                                       // => 0.3
    ;
    let z: f64 = 0.1 + 0.2;
    z                                       // => 0.3
}
