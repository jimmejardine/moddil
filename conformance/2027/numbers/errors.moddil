// covers: num.lit.1, num.ops.1, num.widen.1

fn literals() {
    let a: u8 = 300;   //~ E0204
    let b: i8 = -129;  //~ E0204
    let c: u8 = -1;    //~ E0204
    let d: f32 = 1;
}

// The widest types' ends, and one past each.
fn wide_literals() {
    let a: i128 = 170141183460469231731687303715884105728;   //~ E0204
    let b: i128 = -170141183460469231731687303715884105729;  //~ E0204
    let c: u128 = 340282366920938463463374607431768211456;   //~ E0204
    let d: u128 = -1;                                        //~ E0204
    let e = 340282366920938463463374607431768211455;         //~ E0204
}

fn mixed(a: u8, b: u16) -> u16 {
    a + b  //~ E0201
}

fn narrow(x: int) -> i32 {
    x  //~ E0201
}

fn bits_on_floats(x: f64) -> f64 {
    x & 1.0  //~ E0205
}

fn negative_unsigned(x: u8) -> u8 {
    -x  //~ E0205
}

fn float_to_int(x: f64) -> int {
    x  //~ E0201
}

fn folded() -> u8 {
    200 + 100  //~ E0204
}
