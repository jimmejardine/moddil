// covers: stmt.let.uninit.1

struct Point {
    x: int,
    y: int,
}

fn size(wide: bool) -> int {
    let size;
    if wide {
        size = 80;
    } else {
        size = 40;
    }
    size
}

fn label(n: int) -> String {
    let s: String;
    match n {
        0 => s = "none".to_string(),
        _ => s = fmt"{n}",
    }
    s
}

// Dropped at the end of its block only on the path that gave it a value.
fn maybe(c: bool) -> int {
    let s: String;
    if c {
        s = "hi".to_string();
        if s.len() > 5 {
            return 0;
        }
    }
    1
}

test "let without a value" {
    maybe(true)  // => 1
    ;
    maybe(false)  // => 1
    ;
    size(true)  // => 80
    ;
    size(false)  // => 40
    ;
    label(0)  // => "none"
    ;
    label(3)  // => "3"
    ;
    let mut total = 0;
    for i in 0..3 {
        let x;
        x = i * 2;
        total += x;
    }
    total  // => 6
    ;
    let mut again;
    again = 1;
    again = again + 1;
    again  // => 2
    ;
    let mut names: Vec<String> = Vec::new();
    for i in 0..2 {
        let name;
        name = fmt"n{i}";
        names.push(name);
    }
    names.len()  // => 2
    ;
    let p;
    p = Point { x: 5, y: 1 };
    p.x + p.y  // => 6
}
