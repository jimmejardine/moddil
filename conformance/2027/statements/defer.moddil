// covers: stmt.defer.1

fn log(stop: bool) -> int {
    let mut log = 0;
    {
        defer { log = log * 10 + 1; }
        defer { log = log * 10 + 2; }
        if stop { return log; }
    }
    log
}

test "defer blocks run last first, after the return value" {
    log(false)                  // => 21
    ;
    log(true)                   // => 0
}

test "defer runs on break and continue" {
    let mut runs = 0;
    let mut i = 0;
    while i < 3 {
        i += 1;
        defer { runs += 1; }
        if i == 2 { continue; }
        if i == 3 { break; }
    }
    runs                        // => 3
}
