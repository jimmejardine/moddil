// covers: item.impl.same-name.1

struct Response {
    code: int,
}

impl Response {
    fn status(&self) -> int {
        self.code
    }
    fn status(&mut self) -> int {  //~ E0103
        self.code
    }
    fn new(code: int) -> Response {
        Response { code }
    }
    fn new() -> Response {  //~ E0103
        Response { code: 0 }
    }
}
