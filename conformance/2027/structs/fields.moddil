// covers: expr.field.1, expr.field.assign.1

struct Point {
    x: int,
    y: int,
}
struct Line {
    from: Point,
    to: Point,
}

test "assigning a field changes only that field" {
    let mut p = Point { x: 1, y: 2 };
    p.x = 10;
    p  // => Point { x: 10, y: 2 }
    ;
    p.y += p.x;
    p  // => Point { x: 10, y: 12 }
}

test "fields of fields" {
    let mut l = Line { from: Point { x: 0, y: 0 }, to: Point { x: 3, y: 4 } };
    l.to.y  // => 4
    ;
    l.from.x -= 1;
    l.from  // => Point { x: -1, y: 0 }
    ;
    let mut t = (1, (2, 3));
    t.1.0 = 20;
    t  // => (1, (20, 3))
}

test "compound assignment to a field traps like the operator" {
    let mut p = Point { x: 9223372036854775807, y: 0 };
    p.x += 1;  //~ trap
}
