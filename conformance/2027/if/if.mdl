// covers: expr.if.cond.1, expr.if.value.1, expr.if.no-else.1

fn sign(x: int) -> int {
    if x < 0 { -1 } else if x == 0 { 0 } else { 1 }
}

fn first_positive(a: int, b: int) -> int {
    if a > 0 { a } else { return b }
}

test "if" {
    sign(-5)                  // => -1
    ;
    sign(0)                   // => 0
    ;
    sign(9)                   // => 1
    ;
    first_positive(0, 2)      // => 2
    ;
    if false { 1; }           // => ()
}

test "only the branch taken runs" {
    if true { 1 } else { 1 / 0 }  // => 1
}
