// covers: expr.cmp.eq.1, expr.cmp.order.1

test "comparisons" {
    1 == 1  // => true
    ;
    1 != 1  // => false
    ;
    true == false  // => false
    ;
    () == ()  // => true
    ;
    -1 < 0  // => true
    ;
    2 <= 2  // => true
    ;
    2 > 3  // => false
    ;
    3 >= 4  // => false
}
