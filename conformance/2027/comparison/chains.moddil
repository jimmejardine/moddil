// covers: expr.cmp.chain.1

fn zero() -> int {
    0
}

test "chains" {
    let x = 5;
    0 <= x < 10  // => true
    ;
    0 <= x < 5  // => false
    ;
    10 > x >= 5 > zero()  // => true
}

test "each operand once, stopping at the first false" {
    let mut calls = 0;
    1 < {
        calls += 1;
        2
    } < 3  // => true
    ;
    calls  // => 1
    ;
    3 < 2 < 1 / 0  // => false
}
