// covers: expr.closure.fails.1

struct TooBig {
    n: int,
}

fn check(n: int) -> int with fail(TooBig) {
    if n > 9 {
        fail(TooBig { n });
    }
    n
}

fn apply(f: impl Fn(int) -> int, x: int) -> int {
    f(x)
}

// A call passing a closure that can fail can fail too, so it is marked.
fn unmarked() -> int {
    apply(|x| check(x)?, 1)  //~ E0501
}

// A closure that cannot fail makes the call one that cannot.
fn plain() -> int {
    apply(|x| x + 1, 1)
}
