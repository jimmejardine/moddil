// covers: expr.closure.result.1

struct Missing;
fn lookup(x: int) -> int with fail(Missing) {
    if x == 0 { fail(Missing) }
    x
}


fn adder(k: int) -> impl Fn(int) -> int {
    |x| x + k
}

fn counter() -> impl FnMut() -> int {
    let mut n = 0;
    || {
        n += 1;
        n
    }
}

fn greeting(name: String) -> impl FnOnce() -> String {
    || name
}

fn checked() -> (impl Fn(int) -> int with fail(Missing)) {
    |x| lookup(x)?
}

/// A closure it is given is moved into the one it returns, whose errors are its.
fn scaled<F: Fn(int) -> int with E, E>(f: F, k: int) -> (impl Fn(int) -> int with E) {
    |x| f(x) * k
}

test "a function returns a closure that owns what it captures" {
    let add2 = adder(2);
    add2(3)                                         // => 5
    ;
    let mut c = counter();
    c();
    c()                                             // => 2
    ;
    let g = greeting("hi".to_string());
    g()                                             // => "hi"
    ;
    let s = scaled(adder(1), 10);
    s(4)                                            // => 50
}

test "a returned closure's type names its effects" {
    let f = checked();
    f(5)?                                           // => 5
    ;
    try { f(0)? } catch { Missing => -1 }           // => -1
    ;
    let g = scaled(|x| lookup(x)?, 3);
    try { g(0)? } catch { Missing => -1 }           // => -1
}
