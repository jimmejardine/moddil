// covers: expr.closure.effects.2

struct Missing;
struct Bad;
trait Time {
    fn now(&self) -> int;
}

fn lookup(x: int) -> int with fail(Missing | Bad) {
    if x == 0 { fail(Missing) }
    if x < 0 { fail(Bad) }
    x
}

fn tolerant<F>(f: F, x: int) -> int
    where F: Fn(int) -> int with fail(Missing)
{
    try { f(x)? } catch {
        Missing => -1,
    }
}

/// It names the closure's errors but does not list them, so it must handle them (a private
/// function would infer them).
pub fn named<F: Fn(int) -> int with E, E>(f: F) -> int {
    f(1)  //~ E0501
}

fn timed(f: impl Fn() -> int with Time) -> int {  //~ E0609
    f()
}

fn pure<F: Fn(int) -> int with suspend>(f: F, x: int) -> int {
    f(x)
}

fn main() {
    tolerant(|x| lookup(x)?, 0);  //~ E0502
    pure(|x| lookup(x)?, 1);      //~ E0502
}
