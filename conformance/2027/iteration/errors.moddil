// covers: expr.for.2, iter.fails.1

fn not_iterable(n: int) {
    for x in n {}                           //~ E0402
}

fn refutable(xs: &[int]) {
    for 1 in xs {}                          //~ E0208
}

struct Odd;
fn even(x: int) -> int with fail(Odd) {
    if x % 2 == 1 { fail(Odd) }
    x
}

fn failing_loop() -> int with fail(Odd) {
    let mut sum = 0;
    for x in (0..4).map(|x| even(x)?) {                 //~ E0501
        sum += x;
    }
    sum
}

/// A generic function's errors include its iterator's.
pub fn total<I: Iterator<Item = int>>(it: I) -> int {
    let mut sum = 0;
    for x in it {                                       //~ E0501
        sum += x;
    }
    sum
}

// Whether `next` can fail is a type's not known yet: the literal's, which `Add` does not settle.
// So the type is asked for, rather than the call said to fail.
struct Twice<T> {
    v: T,
}

impl<T: Copy + Add<Output = T>> Iterator for Twice<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        Some(self.v + self.v)
    }
}

fn twice() {
    let mut t = Twice { v: 3 };
    t.next();                               //~ E0405
}
