// covers: iter.adapt.1, iter.collect.1

test "map and collect into a Vec" {
    let v: Vec<int> = (0..4).map(|i| i * i).collect();
    v.len()                                 // => 4
    ;
    v[3]                                    // => 9
}

test "filter keeps the items its closure holds for" {
    let v: Vec<int> = (0..10).filter(|x| *x % 3 == 0).collect();
    v.len()                                 // => 4
    ;
    v[1]                                    // => 3
}

test "collect into a String" {
    let s: String = "abc".chars().map(|c| if c == 'b' { 'x' } else { c }).collect();
    s                                       // => "axc"
}

test "adapters chain" {
    let n = (1..=5).map(|i| i * 2).filter(|x| *x > 4).count();
    n                                       // => 3
}

struct Odd { n: int }

fn even(x: int) -> int with fail(Odd) {
    if x % 2 == 1 { fail(Odd { n: x }) }
    x
}

test "a closure's error passes on through map" {
    let r = try {
        let v: Vec<int> = (0..4).map(|x| even(x)?)?.collect();
        v.len()
    } catch {
        Odd { n } => n * 100,
    };
    r                                       // => 100
}
