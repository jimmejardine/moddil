// covers: obs.log.1

fn total(xs: &Vec<int>) -> int {           // no effect to list for the log
    let mut n = 0;
    for x in xs {
        n += *x;
        log.debug(fmt"added {x}");
    }
    log.info(fmt"total {n}");
    if n > 100 {
        log.warn(fmt"large");
    }
    if n < 0 {
        log.error(fmt"negative");
    }
    n
}

test "the log is ambient and changes nothing" {
    let xs: Vec<int> = [1, 2, 3];
    total(&xs)                              // => 6
}

test "a local called log comes first" {
    let log = 5;
    log + 1                                 // => 6
}
