// covers: refine.trait.1

struct S;

impl Refined for S {                            //~ E0406
    type Base = int;
    fn refine(v: int) -> S with fail(RefinementError) { S }
}

fn needs<T: Refined>() -> Option<T> { None }

fn plain() -> Option<int> {
    needs::<int>()                              //~ E0402
}
