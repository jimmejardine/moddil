// covers: refine.trait.1, refine.trait.2

struct S;

impl Refined for S {  //~ E0406
    type Base = int;
    fn refine(v: int) -> S with fail(RefinementError) {
        S
    }
}

fn needs<T: Refined>() -> Option<T> {
    None
}

fn plain() -> Option<int> {
    needs::<int>()  //~ E0402
}

type Small = int where self < 10;

// Its base has `Clone` already (`refine.trait.2`).
impl Clone for Small {  //~ E0414
    fn clone(&self) -> Small {
        *self
    }
}
