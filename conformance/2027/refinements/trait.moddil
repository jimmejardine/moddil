// covers: refine.trait.1, refine.trait.2

type Small = int where self < 10;
type Word = String where self.len() <= 4;

/// Makes any refined value from its base, generically.
fn make<T: Refined>(v: T::Base) -> Option<T> {
    try { Some(T::refine(v)?) } catch {
        _ => None,
    }
}

/// The error a generic refinement gives.
fn why<T: Refined>(v: T::Base) -> String {
    try {
        T::refine(v)?;
        "fine".to_string()
    } catch {
        e => e.clause,
    }
}

test "a refinement implements `Refined`" {
    let s = make::<Small>(3);
    s.is_some()  // => true
    ;
    let t = make::<Small>(30);
    t.is_none()  // => true
    ;
    let w = make::<Word>("abc".to_string());
    w.unwrap_or(Word::new("x".to_string()) ?! "short").len()  // => 3
    ;
    why::<Small>(12)  // => "self < 10"
}

trait Named {
    fn name(&self) -> String;
}

type Weekday = int where self >= 1 && self <= 7;

// A trait the base does not implement (`refine.trait.2`).
impl Named for Weekday {
    fn name(&self) -> String {
        if *self == 1 { "Monday".to_string() } else { fmt"day {self}" }
    }
}

test "a refinement has the impls of its own of traits its base lacks" {
    let d = Weekday::new(1) ?! "a day";
    d.name()  // => "Monday"
    ;
    let e = Weekday::new(3) ?! "a day";
    e.name()  // => "day 3"
    ;
    e + 1  // => 4
}
