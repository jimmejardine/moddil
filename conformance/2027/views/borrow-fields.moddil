// covers: pat.mode.1, view.1

// A view's borrow field matched by a pattern that tests a value is matched through the borrow,
// as a local borrow is: the names bind borrows of the parts (`x` is a `&int`, so `*x` reads it).

enum Node {
    Leaf(int),
    Pair(int, int),
    Branch(Box<Node>),
}

view W {
    at: &Node,
}

view Outer {
    w: W,
}

fn first(n: &Node) -> int {
    match n {
        Node::Leaf(x)    => *x,
        Node::Pair(a, _) => *a,
        Node::Branch(_)  => 0,
    }
}

fn by_value(w: W) -> int {
    match w.at {
        Node::Leaf(x)    => *x,
        Node::Pair(a, _) => *a,
        Node::Branch(_)  => 0,
    }
}

fn through_borrow(w: &W) -> int {
    match w.at {
        Node::Leaf(x)    => *x,
        Node::Pair(a, _) => *a,
        Node::Branch(_)  => 0,
    }
}

fn nested(o: &Outer) -> int {
    match o.w.at {
        Node::Leaf(x)    => *x,
        Node::Pair(a, _) => *a,
        Node::Branch(_)  => 0,
    }
}

fn if_let(w: &W) -> int {
    if let Node::Pair(_, b) = w.at { *b } else { 0 }
}

impl W {
    fn get(&mut self) -> int {
        match self.at {
            Node::Leaf(x)    => *x,
            Node::Pair(a, _) => *a,
            Node::Branch(_)  => 0,
        }
    }
}

/// Down the branches to the leaf, the view's field reassigned at each step.
fn walk(n: &Node) -> int {
    let mut w = W { at: n };
    while let Node::Branch(b) = w.at {
        w.at = &**b;
    }
    match w.at {
        Node::Leaf(x)    => *x,
        Node::Pair(a, _) => *a,
        Node::Branch(_)  => 0,
    }
}

fn in_vec(ws: &Vec<W>) -> int {
    match ws[0].at {
        Node::Leaf(x)    => *x,
        Node::Pair(a, _) => *a,
        Node::Branch(_)  => 0,
    }
}

enum Tree<T> {
    Leaf(T),
    Pair(T, T),
}

view At<T> {
    at: &Tree<T>,
}

fn generic<T: Copy>(w: &At<T>) -> T {
    match w.at {
        Tree::Leaf(x)    => *x,
        Tree::Pair(a, _) => *a,
    }
}

test "a view's borrow field is matched through its borrow" {
    let leaf = Node::Leaf(7);
    let pair = Node::Pair(5, 6);
    first(&leaf)  // => 7
    ;
    by_value(W { at: &leaf })  // => 7
    ;
    through_borrow(&W { at: &pair })  // => 5
    ;
    nested(&Outer { w: W { at: &pair } })  // => 5
    ;
    if_let(&W { at: &pair })  // => 6
    ;
    let mut w = W { at: &leaf };
    w.get()  // => 7
    ;
    let deep = Node::Branch(Box::new(Node::Branch(Box::new(Node::Leaf(9)))));
    walk(&deep)  // => 9
    ;
    let mut ws: Vec<W> = Vec::new();
    ws.push(W { at: &pair });
    in_vec(&ws)  // => 5
    ;
    let t = Tree::Pair(3, 4);
    generic(&At { at: &t })  // => 3
}
