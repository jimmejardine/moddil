// covers: view.1, view.2, view.infect.1, view.borrow.1, generic.borrow.1, coll.vec.borrow.1

view Window {
    data: &[int],
    start: int,
}

impl Window {
    fn get(&self, i: int) -> int {
        self.data[self.start + i]
    }

    fn rest(&self) -> &[int] {
        self.data
    }
}

fn window(data: &[int], start: int) -> Window {
    Window { data, start }
}

fn first(xs: &[int]) -> Option<&int> {
    if xs.len() == 0 { None } else { Some(&xs[0]) }
}

fn id<T>(x: T) -> T {
    x
}

struct Wrap<T> {
    x: T,
}

test "a view holds borrows" {
    let a = [1, 2, 3, 4];
    let w = window(&a, 1);
    w.get(1)  // => 3
    ;
    w.rest().len()  // => 4
}

test "a borrow as a type argument" {
    let a = [5, 6];
    match first(&a) {
        Some(x) => *x,
        None    => 0,
    }  // => 5
    ;
    let n = 7;
    *id(&n)  // => 7
    ;
    let w = Wrap { x: &n };
    *w.x  // => 7
}

/// A tree of `Rc` nodes.
struct Node {
    value: int,
    left: Option<Rc<Node>>,
    right: Option<Rc<Node>>,
}

fn leaf(value: int) -> Option<Rc<Node>> {
    Some(Node { value, left: None, right: None }.to_rc())
}

fn node(value: int, left: Option<Rc<Node>>, right: Option<Rc<Node>>) -> Option<Rc<Node>> {
    Some(Node { value, left, right }.to_rc())
}

/// The tree's values in order: a stack of borrows of the nodes still to visit, each reached
/// through a borrow the view already holds.
view InOrder {
    stack: Vec<&Node>,
}

impl InOrder {
    fn descend(&mut self, t: &Option<Rc<Node>>) {
        let mut t = t;
        while let Some(n) = t {
            self.stack.push(&**n);
            t = &n.left;
        }
    }
}

impl Iterator for InOrder {
    type Item = &int;
    fn next(&mut self) -> Option<&int> {
        let n = self.stack.pop()?;
        self.descend(&n.right);
        Some(&n.value)
    }
}

test "a view holds a stack of borrows it reached through its own" {
    let t = node(4, node(2, leaf(1), leaf(3)), node(6, leaf(5), None));
    let mut it = InOrder { stack: Vec::new() };
    it.descend(&t);
    let mut out = 0;
    for x in it {
        out = out * 10 + *x;
    }
    out  // => 123456
}
