// covers: view.1, view.2, view.infect.1, generic.borrow.1

view Window {
    data: &[int],
    start: int,
}

impl Window {
    fn get(&self, i: int) -> int {
        self.data[self.start + i]
    }

    fn rest(&self) -> &[int] {
        self.data
    }
}

fn window(data: &[int], start: int) -> Window {
    Window { data, start }
}

fn first(xs: &[int]) -> Option<&int> {
    if xs.len() == 0 {
        None
    } else {
        Some(&xs[0])
    }
}

fn id<T>(x: T) -> T {
    x
}

struct Wrap<T> { x: T }

test "a view holds borrows" {
    let a = [1, 2, 3, 4];
    let w = window(&a, 1);
    w.get(1)                                // => 3
    ;
    w.rest().len()                          // => 4
}

test "a borrow as a type argument" {
    let a = [5, 6];
    match first(&a) {
        Some(x) => *x,
        None => 0,
    }                                       // => 5
    ;
    let n = 7;
    *id(&n)                                 // => 7
    ;
    let w = Wrap { x: &n };
    *w.x                                    // => 7
}
