// covers: expr.fmt.debug.1

#[derive(Debug)]
struct Point { x: int, y: int }

/// A view with borrow fields.
#[derive(Debug)]
view Pair {
    left: &Point,
    count: &int,
}

test "a view with borrow fields derives Debug" {
    let p = Point { x: 1, y: 2 };
    let n = 3;
    let v = Pair { left: &p, count: &n };
    fmt"{v:?}"                              // => "Pair { left: Point { x: 1, y: 2 }, count: 3 }"
    ;
    let r = &p;
    fmt"{r:?}"                              // => "Point { x: 1, y: 2 }"
}
