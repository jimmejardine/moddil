//! ## 2. A user-defined effect for storage
//!
//! - `Links` is an ordinary **trait**. Listed after `with` it becomes an **effect**: its
//!   implementation is chosen by whoever installs a handler, not by this code, and reaches every
//!   function below without being passed as an argument
//!   (`effects-and-capabilities.md`: Effects are traits passed implicitly).
//! - `create` and `follow` call `links` directly, so they bind the name (`with links: Links`);
//!   `app` and `serve` only pass the need on, so they write the bare `Links`.
//! - A production build would install a SQL-backed handler instead. That handler captures `Db`
//!   when it is built in `main`, so nothing that uses `Links` changes
//!   (`effects-and-capabilities.md`: Effects inside handlers).
//! - Tasks share the handler, so its state is in a **sync cell**, the only shared mutable state
//!   (`concurrency.md`: Shared mutable state). There is no `Send` or `Sync` to write
//!   (`concurrency.md`: No `Send` / `Sync`).
//! - `t.clone()` is a visible copy of the URL (`values.md`: `.clone()` is explicit).

use moddil::collections::Map;
use moddil::sync::Mutex;

use mod::types::{Code, LinkError, Target};

/// Where links are kept.
pub trait Links {
    fn get(&self, code: &Code) -> Option<Target> with suspend;
    fn put(&self, code: Code, target: Target) with suspend, fail(LinkError);
}

/// An in-memory handler for `Links`: used by `main` here, and by the tests.
pub struct MemoryLinks { map: Mutex<Map<Code, Target>> }

impl MemoryLinks {
    pub fn new() -> MemoryLinks { MemoryLinks { map: Mutex::new(Map::new()) } }
}

impl Links for MemoryLinks {
    fn get(&self, code: &Code) -> Option<Target> with suspend {
        self.map.lock().get(code).map(|t| t.clone())
    }
    fn put(&self, code: Code, target: Target) with suspend, fail(LinkError) {
        let mut map = self.map.lock();
        if map.contains_key(&code) { fail(LinkError::Taken(code)) }
        map.insert(code, target);
    }
}
