//! Shapes: a Python submodule, `stats.geo`, with a function and a class of its own.

/// The area of a `w` by `h` rectangle.
#[export(python)]
pub fn area(w: f64, h: f64) -> f64 {
    w * h
}

/// A rectangle: `stats.geo.Rect(w, h)`.
#[export(python)]
#[derive(Clone, Debug)]
pub struct Rect {
    pub w: f64,
    pub h: f64,
}

impl Rect {
    pub fn new(w: f64, h: f64) -> Rect {
        Rect { w, h }
    }

    /// The rectangle turned a quarter: it takes the rectangle by value.
    pub fn turned(self) -> Rect {
        Rect { w: self.h, h: self.w }
    }
}

/// A shape that cannot be: an error named as the root module's is, kept apart as
/// `stats.geo.StatsError`.
#[derive(Debug, Clone, PartialEq)]
pub struct StatsError {
    pub side: f64,
}

/// The side of a square of area `a`.
#[export(python)]
pub fn side(a: f64) -> f64 with fail(StatsError) {
    if a < 0.0 {
        fail(StatsError { side: a });
    }
    a.sqrt()
}
