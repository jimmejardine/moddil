//! zlib from Moddil (`reference/2027/interop.md`). The C library is compiled with the mod (its
//! manifest's `[c]` table) and reached through `extern "C"` bindings: to zlib itself where its
//! types are the same everywhere, and to a small C shim with fixed-width types where they are
//! not (`c/moddil_shim.c`: zlib's `uLong` is 32 bits on Windows and 64 elsewhere). Over them, a
//! typed API: compression in one go, checksums, a streaming `Deflater` that frees its C state
//! when it is dropped, and inflation through zlib's callbacks into Moddil (`inflateBack`).

/// zlib's state for streaming compression: only ever behind a pointer C gave.
pub struct ZStream {}

/// What a deflater has done, as C fills it in.
#[repr(C)]
#[derive(Copy, Clone, Debug)]
pub struct Stats {
    /// The bytes it has taken in.
    pub total_in: u64,
    /// The bytes it has given out.
    pub total_out: u64,
    /// The Adler-32 checksum of what it has taken in.
    pub adler: u32,
}

extern "C" {
    fn moddil_zlib_bound(len: u64) -> u64;
    fn moddil_zlib_compress(dst: *mut u8, dst_len: *mut u64, src: *const u8, src_len: u64, level: i32) -> i32;
    fn moddil_zlib_uncompress(dst: *mut u8, dst_len: *mut u64, src: *const u8, src_len: u64) -> i32;
    fn moddil_zlib_crc32(crc: u32, buf: *const u8, len: u64) -> u32;
    fn moddil_zlib_adler32(adler: u32, buf: *const u8, len: u64) -> u32;
    fn moddil_zlib_deflater_new(level: i32, status: *mut i32) -> *mut ZStream;
    fn moddil_zlib_deflate(s: *mut ZStream, input: *const u8, in_len: u64, out: *mut u8, out_cap: u64, out_len: *mut u64, finish: i32) -> i32;
    fn moddil_zlib_deflater_stats(s: *mut ZStream) -> Stats;
    fn moddil_zlib_deflater_end(s: *mut ZStream);
    fn moddil_zlib_inflate_back(input: fn(*mut (), *mut *const u8) -> u32, in_desc: *mut (), output: fn(*mut (), *mut u8, u32) -> i32, out_desc: *mut ()) -> i32;
    // zlib's own, whose types are the same everywhere: C strings, and its CRC table.
    fn zlibVersion() -> *const u8;
    fn zError(code: i32) -> *const u8;
    fn get_crc_table() -> *const u32;
}

/// A zlib error: its code (`Z_DATA_ERROR` is -3, `Z_BUF_ERROR` -5, and so on).
#[derive(Debug, Clone, PartialEq)]
pub struct ZlibError {
    pub code: int,
}

impl ZlibError {
    /// What zlib calls the error: "data error" for `Z_DATA_ERROR`, and so on.
    pub fn message(&self) -> String {
        let code = self.code.to::<i32>() ?! "zlib's codes are `i32`s";
        unsafe("zError gives a NUL-terminated string zlib keeps") {
            core::ffi::c_text(zError(code)).to_string()
        }
    }
}

/// zlib's version, as it gives it.
pub fn version() -> String {
    unsafe("zlibVersion gives a NUL-terminated string zlib keeps") {
        core::ffi::c_text(zlibVersion()).to_string()
    }
}

fn error(code: i32) -> ZlibError {
    ZlibError { code: code.to::<int>() ?! "an `i32` is an `int`" }
}

fn len(n: int) -> u64 {
    n.to::<u64>() ?! "a length is not negative"
}

fn count(n: u64) -> int {
    n.to::<int>() ?! "a buffer's length is an `int`"
}

/// `n` zero bytes.
fn zeros(n: int) -> Vec<u8> {
    let zero: u8 = 0;
    let v: Vec<u8> = [zero; n];
    v
}

/// The most bytes compressing `n` bytes can give.
pub fn bound(n: int) -> int {
    count(unsafe("zlib's compressBound reads nothing") {
        moddil_zlib_bound(len(n))
    })
}

/// `data`, compressed at `level` (0 to 9; 6 is zlib's default).
pub fn compress(data: &[u8], level: i32) -> Vec<u8> with fail(ZlibError) {
    // C reads no byte of an empty input, but its pointer must still point somewhere.
    let spare = zeros(1);
    let input = if data.is_empty() { spare.as_slice() } else { data };
    let mut out = zeros(bound(data.len()));
    let mut n = len(out.len());
    let code = unsafe("the buffers are as long as the lengths say, and live across the call") {
        moddil_zlib_compress(&mut out[0], &mut n, &input[0], len(data.len()), level)
    };
    if code != 0 {
        fail(error(code));
    }
    out.truncate(count(n));
    out
}

/// `data` uncompressed, which is `size` bytes long (as `compress` was given).
pub fn uncompress(data: &[u8], size: int) -> Vec<u8> with fail(ZlibError) {
    let spare = zeros(1);
    let input = if data.is_empty() { spare.as_slice() } else { data };
    let mut out = zeros(if size > 0 { size } else { 1 });
    let mut n = len(size);
    let code = unsafe("the buffers are as long as the lengths say, and live across the call") {
        moddil_zlib_uncompress(&mut out[0], &mut n, &input[0], len(data.len()))
    };
    if code != 0 {
        fail(error(code));
    }
    out.truncate(count(n));
    out
}

/// The CRC-32 of `data` (as `gzip` and PNG use it).
pub fn crc32(data: &[u8]) -> u32 {
    if data.is_empty() {
        return 0;
    }
    unsafe("the buffer is as long as the length says") {
        moddil_zlib_crc32(0, &data[0], len(data.len()))
    }
}

/// The CRC-32 of `data` as `crc32` gives it, worked out here from zlib's table of 256 values:
/// a C array, walked through its pointer.
pub fn crc32_by_table(data: &[u8]) -> u32 {
    let table = unsafe("get_crc_table gives zlib's table, which it keeps") {
        get_crc_table()
    };
    let all: u32 = 4294967295;
    let mut crc = all;
    for b in data.iter() {
        let byte: u32 = *b;
        let at: int = (crc ^ byte) & 255;
        let entry = unsafe("the table has 256 values, and `at` is below 256") {
            *core::ptr::add(table, at)
        };
        crc = entry ^ (crc >> 8);
    }
    crc ^ all
}

/// The input `pull` gives zlib: where the bytes are, how many, and whether they were given.
#[repr(C)]
struct Source {
    at: *const u8,
    len: u32,
    given: i32,
}

/// zlib asks for input: all of it, once, then none.
fn pull(desc: *mut (), buf: *mut *const u8) -> u32 {
    unsafe("inflateBack passes the source it was given, and where to put the input's address") {
        let s: *mut Source = core::ptr::cast_mut_to(desc);
        if (*s).given != 0 {
            0
        } else {
            (*s).given = 1;
            *buf = (*s).at;
            (*s).len
        }
    }
}

/// zlib gives a piece of output: it goes on the end of the sink.
fn push(desc: *mut (), buf: *mut u8, n: u32) -> i32 {
    let n: int = n;
    unsafe("inflateBack passes the sink it was given, and `n` bytes at `buf`") {
        let sink: *mut Vec<u8> = core::ptr::cast_mut_to(desc);
        for b in core::ffi::slice(buf, n).iter() {
            (*sink).push(*b);
        }
    }
    0
}

/// `data` (a zlib stream, as `compress` gives) uncompressed through zlib's `inflateBack`, which
/// calls `pull` for its input and `push` with its output.
pub fn uncompress_through_callbacks(data: &[u8]) -> Vec<u8> with fail(ZlibError) {
    // A zlib stream is a 2-byte header, the raw deflate stream, and a 4-byte checksum;
    // inflateBack reads the raw stream, and stops at its end.
    if data.len() < 6 {
        fail(error(-3));
    }
    let raw = &data[2..data.len()];
    let n = raw.len().to::<u32>() ?! "the data is shorter than 4 GiB";
    let mut source = Source { at: core::ffi::ptr_of(raw), len: n, given: 0 };
    let mut sink: Vec<u8> = Vec::new();
    let code = unsafe("inflateBack calls pull and push with these pointers, during the call only") {
        moddil_zlib_inflate_back(pull, core::ptr::cast_mut_to(&mut source), push, core::ptr::cast_mut_to(&mut sink))
    };
    if code != 1 {
        fail(error(code));
    }
    sink
}

/// The Adler-32 of `data` (as the zlib format uses it).
pub fn adler32(data: &[u8]) -> u32 {
    if data.is_empty() {
        return 1;
    }
    unsafe("the buffer is as long as the length says") {
        moddil_zlib_adler32(1, &data[0], len(data.len()))
    }
}

/// Compression a piece at a time: what `write` and `finish` give, joined, is the zlib stream
/// of everything written. Its C state is freed when it is dropped.
pub struct Deflater {
    stream: *mut ZStream,
}

impl Deflater {
    /// A deflater compressing at `level`.
    pub fn new(level: i32) -> Deflater with fail(ZlibError) {
        let mut status: i32 = 0;
        let stream = unsafe("zlib's deflateInit, its state kept behind the pointer") {
            moddil_zlib_deflater_new(level, &mut status)
        };
        if status != 0 {
            fail(error(status));
        }
        Deflater { stream }
    }

    /// Compresses `data`: the bytes of the stream it gives so far (perhaps none).
    pub fn write(&mut self, data: &[u8]) -> Vec<u8> with fail(ZlibError) {
        self.step(data, 0)?
    }

    /// Ends the stream: its last bytes.
    pub fn finish(&mut self) -> Vec<u8> with fail(ZlibError) {
        let nothing: Vec<u8> = Vec::new();
        self.step(nothing.as_slice(), 1)?
    }

    fn step(&mut self, data: &[u8], finish: i32) -> Vec<u8> with fail(ZlibError) {
        let spare = zeros(1);
        let input = if data.is_empty() { spare.as_slice() } else { data };
        let mut out = zeros(bound(data.len()) + 64);
        let cap = len(out.len());
        let mut n: u64 = 0;
        let code = unsafe("the buffers are as long as the lengths say, and live across the call") {
            moddil_zlib_deflate(self.stream, &input[0], len(data.len()), &mut out[0], cap, &mut n, finish)
        };
        if code < 0 {
            fail(error(code));
        }
        out.truncate(count(n));
        out
    }

    /// What it has done so far: a `#[repr(C)]` struct C gives by value.
    pub fn stats(&self) -> Stats {
        unsafe("the stream is the deflater's own, alive until it is dropped") {
            moddil_zlib_deflater_stats(self.stream)
        }
    }
}

impl Drop for Deflater {
    fn drop(self) {
        unsafe("zlib's deflateEnd, then the state is freed; nothing uses the pointer after") {
            moddil_zlib_deflater_end(self.stream);
        }
    }
}

/// `s`'s bytes.
fn bytes(s: &str) -> Vec<u8> {
    let mut v = Vec::new();
    for b in s.as_bytes().iter() {
        v.push(*b);
    }
    v
}

test "a text compresses and comes back" {
    let text = bytes("the quick brown fox jumps over the lazy dog, the quick brown fox again");
    let packed = try { compress(text.as_slice(), 9)? } catch {
        _ => Vec::new(),
    };
    assert(packed.len() > 0 && packed.len() < text.len());
    let back = try { uncompress(packed.as_slice(), text.len())? } catch {
        _ => Vec::new(),
    };
    assert(back == text);
}

test "the checksums are the known ones" {
    let text = bytes("The quick brown fox jumps over the lazy dog");
    assert(crc32(text.as_slice()) == 1095738169);
    assert(adler32(text.as_slice()) == 1541148634);
    assert(crc32(Vec::new().as_slice()) == 0);
}

test "zlib's callbacks into Moddil inflate the stream" {
    let text = bytes("the quick brown fox jumps over the lazy dog, the quick brown fox again");
    let packed = try { compress(text.as_slice(), 9)? } catch {
        _ => Vec::new(),
    };
    let back = try { uncompress_through_callbacks(packed.as_slice())? } catch {
        _ => Vec::new(),
    };
    assert(back == text);
}

test "zlib's strings and table, read through its pointers" {
    assert(version().as_str() == "1.3.1");
    assert(error(-3).message().as_str() == "data error");
    let text = bytes("The quick brown fox jumps over the lazy dog");
    assert(crc32_by_table(text.as_slice()) == crc32(text.as_slice()));
}

test "corrupt data is an error" {
    let junk = bytes("this is not a zlib stream");
    let code = try {
        uncompress(junk.as_slice(), 100)?;
        0
    } catch {
        e => e.code,
    };
    assert(code == -3);
}

test "a stream in pieces uncompresses to the whole" {
    let a = bytes("streaming, ");
    let b = bytes("a piece at a time");
    let mut whole = a.clone();
    for x in b.iter() {
        whole.push(*x);
    }
    let packed = try {
        let mut d = Deflater::new(6)?;
        let mut out = d.write(a.as_slice())?;
        let more = d.write(b.as_slice())?;
        for x in more.iter() {
            out.push(*x);
        }
        let last = d.finish()?;
        for x in last.iter() {
            out.push(*x);
        }
        let s = d.stats();
        assert(s.total_in == 28 && s.total_out == len(out.len()) && s.adler == adler32(whole.as_slice()));
        out
    } catch {
        _ => Vec::new(),
    };
    let back = try { uncompress(packed.as_slice(), whole.len())? } catch {
        _ => Vec::new(),
    };
    assert(back == whole);
}
