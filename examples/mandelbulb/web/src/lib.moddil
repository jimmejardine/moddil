// Mandelbulb flight in the browser: the GPU kernel, and one frame of flight
// (`specs/examples/mandelbulb.md`). `main` (in `main.moddil`) runs the frame loop: for each
// animation frame it reads the input, moves the camera and draws.
//
// Everything that decides what is drawn is in Moddil, and the camera and the fractal are the pure
// `mandelbulb` mod, shared with the CPU preview and the tests. The kernel is ordinary Moddil,
// lowered to WGSL for the GPU, and run tile by tile on the CPU simulator where there is none.

use mandelbulb::{Camera, Input, Params, Quality, Vec3, fly, march, shade};
use gpu::{Gpu, Image, Rgba8, Tile};

/// Everything the kernel reads: one frame's camera, fractal and quality.
#[derive(Clone)]
pub struct Scene {
    pub camera: Camera,
    pub params: Params,
    pub quality: Quality,
    pub light: Vec3,
    pub width: int,
    pub height: int,
}

impl Scene {
    /// The scene the flight starts with, drawn `width` x `height`.
    pub fn start(width: int, height: int) -> Scene {
        Scene {
            camera: Camera::start(),
            params: Params::classic(),
            quality: Quality::standard(),
            light: Vec3::new(-0.5, 0.7, -0.5).normalized(),
            width,
            height,
        }
    }
}

/// One program instance draws one 8 × 8 tile of the image: it ray-marches each of its pixels with
/// the same `march` and `shade` the CPU preview uses.
#[kernel]
pub fn render(scene: &Scene, out: &mut Tile) {
    let mut py = 0;
    while py < 8 {
        let mut px = 0;
        while px < 8 {
            let ray = scene.camera.ray(out.x + px, out.y + py, scene.width, scene.height);
            let hit = march(ray, scene.params, scene.quality);
            let brightness = shade(hit, scene.params, scene.quality, scene.light);
            out.set(px, py, Rgba8::grey(brightness));
            px += 1;
        }
        py += 1;
    }
}

/// A frame budget of 60 fps, with some room: slower frames lower the quality.
const BUDGET: f32 = 0.018;

/// One frame: moves the camera by `input` over `dt` seconds, adapts the quality to how long the
/// frame took, and draws the scene into `image`.
pub fn frame(scene: Scene, input: Input, dt: f32, image: &mut Image) -> Scene with Gpu, suspend {
    let mut next = scene;
    next.camera = fly(next.camera, input, next.params, dt);
    next.width = image.width();
    next.height = image.height();
    if dt > BUDGET && next.quality.max_steps > 32 {
        next.quality.max_steps -= 8;
    } else if dt < BUDGET * 0.6 && next.quality.max_steps < 256 {
        next.quality.max_steps += 8;
    }
    gpu::launch(render, &next, image);
    next
}

// Golden images, drawn by the kernel on the CPU simulator: the same on every machine.

/// No input: what a first frame, and a frame with no keys or mouse, has.
pub fn still() -> Input {
    Input { forward: 0.0, strafe: 0.0, look_yaw: 0.0, look_pitch: 0.0, speed: 1.0 }
}

test "the start, on the simulator" {
    with Gpu = gpu::simulator() {
        let mut image = Image::new(48, 24);
        gpu::launch(render, &Scene::start(48, 24), &mut image);
        // The CPU preview lights the same 302 pixels.
        let (lit, sum) = image.summary();
        assert(lit == 302 && sum == 30793);
    }
}

// The browser test (`crates/moddil/tests/gpu.rs`) compares its first frame, drawn on the GPU,
// with this one.
test "the first frame of flight, on the simulator" {
    with Gpu = gpu::simulator() {
        let mut image = Image::new(48, 24);
        let next = frame(Scene::start(0, 0), still(), 0.0, &mut image);
        let (lit, sum) = image.summary();
        assert(lit == 302 && sum == 31138);
        // A fast first frame raises the quality a step.
        assert(next.quality.max_steps == Quality::standard().max_steps + 8);
    }
}
