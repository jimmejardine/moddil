// Mandelbulb flight in the browser: the GPU kernel, and one frame of flight
// (`specs/examples/mandelbulb.md`). `main` (in `main.moddil`) runs the frame loop: for each
// animation frame it reads the input, moves the camera and draws.
//
// Everything that decides what is drawn is in Moddil, and the camera and the fractal are the pure
// `mandelbulb` mod, shared with the CPU preview and the tests. The kernel is ordinary Moddil,
// lowered to WGSL for the GPU, and run tile by tile on the CPU simulator where there is none.

use mandelbulb::{Camera, Input, Params, Quality, Vec3, colour, fly, march};
use gpu::{Gpu, Image, Rgba8, Tile};

/// Everything the kernel reads: one frame's camera, fractal and quality, and the image's size,
/// which is the window's, a pixel of the image for each of the screen's.
#[derive(Clone)]
pub struct Scene {
    pub camera: Camera,
    pub params: Params,
    pub quality: Quality,
    pub light: Vec3,
    pub width: int,
    pub height: int,
    /// How many frames in a row have been slow (above 0) or fast (below 0).
    pub pace: int,
}

impl Scene {
    /// The scene the flight starts with, drawn `width` x `height` (its pixels' size set from
    /// `height`, if it has one yet).
    pub fn start(width: int, height: int) -> Scene {
        let camera = Camera::start();
        let mut quality = Quality::standard();
        if height > 0 {
            quality.pixel = camera.pixel(height);
        }
        Scene { camera, params: Params::classic(), quality, light: Vec3::new(-0.5, 0.7, -0.5).normalized(), width, height, pace: 0 }
    }
}

/// One program instance draws one 8 × 8 tile of the image, a pixel per thread on a GPU: it
/// ray-marches each pixel with the same `march` the CPU preview uses, and colours it.
#[kernel]
pub fn render(scene: &Scene, out: &mut Tile) {
    let x = out.x;
    let y = out.y;
    out.each(|px, py| {
        let ray = scene.camera.ray(x + px, y + py, scene.width, scene.height);
        let hit = march(ray, scene.params, scene.quality);
        let c = colour(hit, ray, scene.params, scene.quality, scene.light);
        Rgba8::rgb(c.x, c.y, c.z)
    });
}

/// A frame budget of 60 fps, with some room.
const BUDGET: f32 = 0.018;

/// The fewest and most steps a ray may take: fewer would show the sky through grazing rays.
const MIN_STEPS: int = 96;
const MAX_STEPS: int = 160;

/// How many slow, or fast, frames in a row change the steps: a frame or two does not.
const STREAK: int = 5;

/// One frame's plan: moves the camera by `input` over `dt` seconds, and adapts to how long the
/// frames take. The image is always the `width` x `height` window's size, a pixel for each of
/// the screen's: only the steps a ray may take change, lowered after a streak of slow frames and
/// raised after a streak of fast ones. A first frame (`dt` 0) adapts nothing.
pub fn step(scene: Scene, input: Input, dt: f32, width: int, height: int) -> Scene {
    let mut next = scene;
    next.camera = fly(next.camera, input, next.params, dt);
    if dt > BUDGET {
        next.pace = if next.pace > 0 { next.pace + 1 } else { 1 };
    } else if dt > 0.0 && dt < BUDGET * 0.6 {
        next.pace = if next.pace < 0 { next.pace - 1 } else { -1 };
    } else {
        next.pace = 0;
    }
    if next.pace >= STREAK && next.quality.max_steps > MIN_STEPS {
        next.quality.max_steps -= 8;
        next.pace = 0;
    } else if next.pace <= -STREAK && next.quality.max_steps < MAX_STEPS {
        next.quality.max_steps += 8;
        next.pace = 0;
    }
    next.width = if width > 8 { width } else { 8 };
    next.height = if height > 8 { height } else { 8 };
    next.quality.pixel = next.camera.pixel(next.height);
    next
}

/// Draws `scene` into `image` (its size) and reads it back, on the GPU or the simulator.
pub fn draw(scene: &Scene, image: &mut Image) with Gpu, suspend {
    gpu::launch(render, scene, image);
}

/// Shows `scene` on the screen: on the GPU with no copy back, or the simulator's image.
pub fn show(scene: &Scene, image: &mut Image) with Gpu, suspend {
    gpu::present(render, scene, image);
}

/// No input: what a first frame, and a frame with no keys or mouse, has.
pub fn still() -> Input {
    Input { forward: 0.0, strafe: 0.0, look_yaw: 0.0, look_pitch: 0.0, speed: 1.0 }
}

// Golden images, drawn by the kernel on the CPU simulator: the same on every machine.

test "the start, on the simulator" {
    with Gpu = gpu::simulator() {
        let mut image = Image::new(48, 24);
        draw(&Scene::start(48, 24), &mut image);
        let (r, g, b) = image.summary();
        assert(r == 196051 && g == 210991 && b == 234524);
    }
}

// The browser test (`crates/moddil/tests/web.rs`) compares its first frame, drawn on the GPU,
// with this one.
test "the first frame of flight, on the simulator" {
    with Gpu = gpu::simulator() {
        let scene = step(Scene::start(0, 0), still(), 0.0, 48, 24);
        assert(scene.width == 48 && scene.height == 24);
        assert(scene.quality.max_steps == Quality::standard().max_steps);
        let mut image = Image::new(scene.width, scene.height);
        draw(&scene, &mut image);
        let (r, g, b) = image.summary();
        assert(r == 196051 && g == 210991 && b == 234524);
    }
}

test "slow frames lower the steps, never the resolution; fast ones raise them again" {
    let mut scene = Scene::start(0, 0);
    let mut i = 0;
    while i < 2 {
        scene = step(scene, still(), 0.05, 400, 200);
        i += 1;
    }
    // A frame or two changes nothing.
    assert(scene.quality.max_steps == Quality::standard().max_steps);
    while i < 200 {
        scene = step(scene, still(), 0.05, 400, 200);
        i += 1;
    }
    assert(scene.quality.max_steps == MIN_STEPS);
    assert(scene.width == 400 && scene.height == 200);
    while i < 400 {
        scene = step(scene, still(), 0.005, 400, 200);
        i += 1;
    }
    assert(scene.quality.max_steps == MAX_STEPS && scene.width == 400);
}
