// The frame loop: for each animation frame, the page's input moves the camera, and the kernel
// draws the scene into the page's canvas, on the GPU (WebGPU) or, without one, the CPU
// simulator.

use gpu::{Gpu, GpuRoot, Image};
use web::{Frame, KEY_A, KEY_D, KEY_S, KEY_W, Window};
use mandelbulb::Input;
use mod::{Scene, draw, show, step};

/// 1 if `plus` is held, -1 if `minus` is, else 0.
fn axis(f: &Frame, plus: int, minus: int) -> f32 {
    if f.held(plus) { 1.0 } else if f.held(minus) { -1.0 } else { 0.0 }
}

/// A count of pixels (or wheel steps) as an `f32`.
fn pixels(n: int) -> f32 {
    n.to::<f32>() ?! "a mouse moves less than 2^24 pixels"
}

/// The keys and mouse of `f` as the camera's input.
fn input(f: Frame) -> Input {
    Input { forward: axis(&f, KEY_W, KEY_S), strafe: axis(&f, KEY_D, KEY_A), look_yaw: pixels(f.mouse_x) * 0.003, look_pitch: -pixels(f.mouse_y) * 0.003, speed: 1.0 + pixels(f.wheel) * 0.01 }
}

fn main(gpu: GpuRoot, window: Window) {
    let mut scene = Scene::start(0, 0);
    let mut image = Image::new(8, 8);
    let mut drawn = 0;
    with Gpu = &gpu {
        loop {
            let f = window.next_frame();
            if f.stop {
                break;
            }
            scene = step(scene, input(f), f.dt, f.width, f.height);
            // One image, made again only when the size changes.
            if image.width() != scene.width || image.height() != scene.height {
                image = Image::new(scene.width, scene.height);
            }
            if drawn == 0 {
                // The first frame is read back, for the browser test to compare its summary with
                // the simulator's, then shown.
                draw(&scene, &mut image);
                gpu.show(&image);
                let (r, g, b) = image.summary();
                log.info(fmt"first frame {scene.width}x{scene.height}: {r}, {g}, {b}");
            } else {
                show(&scene, &mut image);
            }
            drawn += 1;
        }
    }
}
