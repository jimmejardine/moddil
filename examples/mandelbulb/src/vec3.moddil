// Three-component vectors of `f32`: points, directions and colours.

/// A point or a direction in space.
#[derive(Copy, Clone, PartialEq)]
pub struct Vec3 {
    pub x: f32,
    pub y: f32,
    pub z: f32,
}

impl Vec3 {
    pub fn new(x: f32, y: f32, z: f32) -> Vec3 {
        Vec3 { x: x, y: y, z: z }
    }

    pub fn zero() -> Vec3 {
        Vec3::new(0.0, 0.0, 0.0)
    }

    /// From spherical coordinates: radius `r`, polar angle `theta` from +z, azimuth `phi` from +x.
    pub fn from_spherical(r: f32, theta: f32, phi: f32) -> Vec3 {
        Vec3::new(r * theta.sin() * phi.cos(), r * theta.sin() * phi.sin(), r * theta.cos())
    }

    pub fn dot(self, other: Vec3) -> f32 {
        self.x * other.x + self.y * other.y + self.z * other.z
    }

    pub fn cross(self, other: Vec3) -> Vec3 {
        Vec3::new(
            self.y * other.z - self.z * other.y,
            self.z * other.x - self.x * other.z,
            self.x * other.y - self.y * other.x,
        )
    }

    pub fn length(self) -> f32 {
        self.dot(self).sqrt()
    }

    pub fn scale(self, k: f32) -> Vec3 {
        Vec3::new(self.x * k, self.y * k, self.z * k)
    }

    /// The same direction with length 1. The zero vector has no direction, and stays zero.
    pub fn normalized(self) -> Vec3 {
        let len = self.length();
        if len == 0.0 { self } else { self.scale(1.0 / len) }
    }
}

impl Add for Vec3 {
    type Output = Vec3;
    fn add(self, rhs: Vec3) -> Vec3 {
        Vec3::new(self.x + rhs.x, self.y + rhs.y, self.z + rhs.z)
    }
}

impl Sub for Vec3 {
    type Output = Vec3;
    fn sub(self, rhs: Vec3) -> Vec3 {
        Vec3::new(self.x - rhs.x, self.y - rhs.y, self.z - rhs.z)
    }
}

impl Neg for Vec3 {
    type Output = Vec3;
    fn neg(self) -> Vec3 {
        Vec3::new(-self.x, -self.y, -self.z)
    }
}

/// A pixel coordinate or count as an `f32`. Values this small are exact, so the conversion
/// cannot fail.
pub fn float(i: int) -> f32 {
    i.to::<f32>() ?! "pixel coordinates are far below 2^24"
}

test "a normalised vector has length 1" {
    assert(Vec3::new(3.0, 0.0, 4.0).normalized() == Vec3::new(0.6, 0.0, 0.8));
}

test "the cross product of x and y is z" {
    let x = Vec3::new(1.0, 0.0, 0.0);
    let y = Vec3::new(0.0, 1.0, 0.0);
    assert(x.cross(y) == Vec3::new(0.0, 0.0, 1.0));
}
