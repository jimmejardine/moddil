// `moddil run`: renders a small frame on the CPU, with the same code the GPU kernel runs, and
// returns how many of its pixels show the surface. It is a smoke test for the whole pure path,
// usable before there is a GPU back end.

use mod::{Camera, Params, Quality, Hit, Vec3, march, shade};

const WIDTH: int = 48;
const HEIGHT: int = 24;

fn main() -> int {
    let camera = Camera::start();
    let params = Params::classic();
    let quality = Quality::standard();
    let light = Vec3::new(-0.5, 0.7, -0.5).normalized();
    let mut lit = 0;
    let mut y = 0;
    while y < HEIGHT {
        let mut x = 0;
        while x < WIDTH {
            let hit = march(camera.ray(x, y, WIDTH, HEIGHT), params, quality);
            if shade(hit, params, quality, light) > 0.0 {
                lit += 1;
            }
            x += 1;
        }
        y += 1;
    }
    lit
}
