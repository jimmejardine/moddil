// Mandelbulb flight: the pure part.
//
// Everything here is ordinary Moddil with no effects, so the same functions run on the CPU (the
// camera, the preview, the tests) and inside the GPU kernel in `web/`
// (`specs/examples/mandelbulb.md`).

pub use mod::vec3::Vec3;
pub use mod::fractal::{Params, distance, normal};
pub use mod::trace::{Ray, Quality, Hit, march, shade};
pub use mod::camera::{Camera, Input, fly};
