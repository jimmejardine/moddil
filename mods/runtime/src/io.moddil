//! The terminal.

use core::os;

/// Writing to standard error, as an effect.
pub trait Stderr {
    fn write(&self, text: &str);
}

/// The process's standard error, as `Stdio` hands it out.
pub struct StdErr {
    handle: int,
}

impl Stderr for StdErr {
    fn write(&self, text: &str) {
        os::write_stderr(text);
    }
}

/// Writes `text` and a line break to standard error.
pub fn eprintln(text: String) with err: Stderr {
    err.write(&text);
    err.write("\n");
}
