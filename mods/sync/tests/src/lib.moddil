use sync::{AtomicRc, Condvar, Mutex, Once, RwLock};

test "a mutex changes behind a shared borrow" {
    let m = Mutex::new(Vec::new());
    let r = &m;
    r.lock().push(1);
    r.with (|v| v.push(2));
    m.lock().len()  // => 2
}

test "tasks take turns at the lock" {
    let m = Mutex::new(0);
    scope(|s| {
        s.spawn (|| {
            let mut g = m.lock();
            yield_now();
            *g += 1;
        });
        s.spawn (|| {
            let mut g = m.lock();
            *g += 10;
        });
    });
    m.into_inner()  // => 11
}

test "a task parked at a lock runs once it is let go, in the order they waited" {
    let m = Mutex::new(Vec::new());
    scope(|s| {
        s.spawn (|| {
            let mut g = m.lock();
            yield_now();
            yield_now();
            g.push(1);
        });
        s.spawn (|| m.lock().push(2));
        s.spawn (|| m.lock().push(3));
    });
    m.into_inner()  // => [1, 2, 3]
}

test "readers share an rwlock, and a writer waits for them" {
    let l = RwLock::new(1);
    let (tx, rx) = channel::<int>(4);
    scope(|s| {
        s.spawn (|| {
            let r = l.read();
            yield_now();
            tx.send(*r * 10) ?! "the receiver outlives the scope";
        });
        s.spawn (|| {
            let r = l.read();
            tx.send(*r * 100) ?! "the receiver outlives the scope";
        });
        s.spawn (|| {
            *l.write() += 1;
            tx.send(*l.read()) ?! "the receiver outlives the scope";
        });
    });
    (rx.recv(), rx.recv(), rx.recv())  // => (Some(100), Some(10), Some(2)) (in parallel, in any order, also (Some(100), Some(20), Some(2)); (Some(200), Some(10), Some(2)); (Some(200), Some(20), Some(2)))
}

test "a condvar wakes a task waiting under a mutex" {
    let m = Mutex::new(false);
    let c = Condvar::new();
    let seen = scope(|s| {
        let t = s.spawn (|| {
            let mut g = m.lock();
            while !*g {
                g = c.wait(g);
            }
            1
        });
        s.spawn (|| {
            *m.lock() = true;
            c.notify_all();
        });
        t.join()
    });
    seen  // => 1
}

test "once runs its code once, and the other tasks wait for it" {
    let o = Once::new();
    let m = Mutex::new(0);
    scope(|s| {
        for _ in 0..3 {
            s.spawn (|| {
                o.call_once(|| {
                    yield_now();
                    *m.lock() += 1;
                });
                *m.lock() += 10;
            });
        }
    });
    (o.is_completed(), m.into_inner())  // => (true, 31)
}

test "an atomic rc is loaded and replaced through a shared borrow" {
    let a = AtomicRc::new(1.to_rc());
    let first = a.load();
    let old = a.swap(2.to_rc());
    (*first, *old, *a.load())  // => (1, 1, 2)
    ;
    let now = a.load();
    a.compare_exchange(&first, 3.to_rc()).is_err()  // => true
    ;
    *a.compare_exchange(&now, 4.to_rc()) ?! "it holds now"  // => 2
    ;
    scope(|s| {
        s.spawn (|| a.store(5.to_rc()));
    });
    *a.into_inner()  // => 5
}
