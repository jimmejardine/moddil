//! `TreeMap` and `TreeSet`: sorted by key (`stdlib.md`: Collections).
//!
//! The map is an AA tree, a balanced binary search tree with one rule set simpler than a
//! red-black tree's (Andersson, "Balanced search trees made simple", 1993). Its nodes live in a
//! `Vec` and link to each other by index, `NIL` for none; removing a node moves the last one into
//! its place, so the `Vec` has no holes.

/// No node.
const NIL: int = -1;

/// A node: `pub` only because `TreeMap` holds them (`mod.expose.1`); its fields are private.
pub struct Node<K, V> {
    key: K,
    value: V,
    /// The AA level: 1 for a leaf; a left child's is one less than its parent's; a right child's
    /// is the same or one less, and a right grandchild's is less.
    level: int,
    left: int,
    right: int,
}

/// A map from keys to values, sorted by key.
pub struct TreeMap<K, V> {
    nodes: Vec<Node<K, V>>,
    root: int,
}

impl<K: Ord, V> TreeMap<K, V> {
    pub fn new() -> TreeMap<K, V> {
        TreeMap { nodes: Vec::new(), root: NIL }
    }

    pub fn len(&self) -> int {
        self.nodes.len()
    }

    pub fn is_empty(&self) -> bool {
        self.nodes.is_empty()
    }

    /// The node for `key`, or `NIL`.
    fn find(&self, key: &K) -> int {
        let mut t = self.root;
        while t != NIL {
            match key.cmp(&self.nodes[t].key) {
                Ordering::Less    => t = self.nodes[t].left,
                Ordering::Greater => t = self.nodes[t].right,
                Ordering::Equal   => return t,
            }
        }
        NIL
    }

    /// The value for `key`, if there is one.
    pub fn get(&self, key: &K) -> Option<&V> {
        let t = self.find(key);
        if t == NIL { None } else { Some(&self.nodes[t].value) }
    }

    pub fn get_mut(&mut self, key: &K) -> Option<&mut V> {
        let t = self.find(key);
        if t == NIL { None } else { Some(&mut self.nodes[t].value) }
    }

    pub fn contains_key(&self, key: &K) -> bool {
        self.find(key) != NIL
    }

    /// Puts `value` under `key`, giving back what was there.
    pub fn insert(&mut self, key: K, value: V) -> Option<V> {
        let at = self.root;
        let (root, old) = self.insert_at(at, key, value);
        self.root = root;
        old
    }

    /// Takes out the entry for `key`, giving back its value.
    pub fn remove(&mut self, key: &K) -> Option<V> {
        let at = self.root;
        let (root, gone) = self.remove_at(at, key);
        self.root = root;
        if gone == NIL {
            return None;
        }
        Some(self.free(gone).value)
    }

    /// The entry with the least key.
    pub fn first(&self) -> Option<(&K, &V)> {
        let mut t = self.root;
        if t == NIL {
            return None;
        }
        while self.nodes[t].left != NIL {
            t = self.nodes[t].left;
        }
        Some((&self.nodes[t].key, &self.nodes[t].value))
    }

    /// The entry with the greatest key.
    pub fn last(&self) -> Option<(&K, &V)> {
        let mut t = self.root;
        if t == NIL {
            return None;
        }
        while self.nodes[t].right != NIL {
            t = self.nodes[t].right;
        }
        Some((&self.nodes[t].key, &self.nodes[t].value))
    }

    /// The entries, borrowed, in key order.
    pub fn iter(&self) -> TreeIter<K, V> {
        let mut it = TreeIter { map: self, stack: Vec::new(), until: None };
        it.descend(self.root);
        it
    }

    /// The entries whose keys are at least `lo` and less than `hi`, in key order.
    pub fn range(&self, lo: &K, hi: &K) -> TreeIter<K, V> {
        let mut it = TreeIter { map: self, stack: Vec::new(), until: Some(hi) };
        // The path to `lo`'s place, keeping the nodes at or after it.
        let mut t = self.root;
        while t != NIL {
            match self.nodes[t].key.cmp(lo) {
                Ordering::Less => t = self.nodes[t].right,
                _              => {
                    it.stack.push(t);
                    t = self.nodes[t].left;
                }
            }
        }
        it
    }

    fn level(&self, t: int) -> int {
        if t == NIL { 0 } else { self.nodes[t].level }
    }

    fn left(&self, t: int) -> int {
        if t == NIL { NIL } else { self.nodes[t].left }
    }

    fn right(&self, t: int) -> int {
        if t == NIL { NIL } else { self.nodes[t].right }
    }

    /// Turns a left child on `t`'s level into `t`'s parent.
    fn skew(&mut self, t: int) -> int {
        let l = self.left(t);
        if l == NIL || self.nodes[l].level != self.nodes[t].level {
            return t;
        }
        self.nodes[t].left = self.nodes[l].right;
        self.nodes[l].right = t;
        l
    }

    /// Lifts the right child of `t` when its right child is on `t`'s level too.
    fn split(&mut self, t: int) -> int {
        let r = self.right(t);
        if r == NIL || self.level(self.nodes[r].right) != self.nodes[t].level {
            return t;
        }
        self.nodes[t].right = self.nodes[r].left;
        self.nodes[r].left = t;
        self.nodes[r].level += 1;
        r
    }

    /// Restores the levels at `t` after a removal below it: its new root.
    fn rebalance(&mut self, t: int) -> int {
        let (l, r) = (self.level(self.nodes[t].left), self.level(self.nodes[t].right));
        let should = if l < r { l + 1 } else { r + 1 };
        if should < self.nodes[t].level {
            self.nodes[t].level = should;
            let r = self.nodes[t].right;
            if r != NIL && should < self.nodes[r].level {
                self.nodes[r].level = should;
            }
        }
        let t = self.skew(t);
        let at = self.nodes[t].right;
        let r = self.skew(at);
        self.nodes[t].right = r;
        if r != NIL {
            let at = self.nodes[r].right;
            let rr = self.skew(at);
            self.nodes[r].right = rr;
        }
        let t = self.split(t);
        let at = self.nodes[t].right;
        let r = self.split(at);
        self.nodes[t].right = r;
        t
    }

    /// Inserts into the subtree at `t`: its new root, and the value replaced.
    fn insert_at(&mut self, t: int, key: K, value: V) -> (int, Option<V>) {
        if t == NIL {
            self.nodes.push(Node { key, value, level: 1, left: NIL, right: NIL });
            return (self.nodes.len() - 1, None);
        }
        match key.cmp(&self.nodes[t].key) {
            Ordering::Less => {
                let at = self.nodes[t].left;
                let (l, old) = self.insert_at(at, key, value);
                self.nodes[t].left = l;
                if old.is_some() {
                    return (t, old);
                }
            }
            Ordering::Greater => {
                let at = self.nodes[t].right;
                let (r, old) = self.insert_at(at, key, value);
                self.nodes[t].right = r;
                if old.is_some() {
                    return (t, old);
                }
            }
            Ordering::Equal => {
                let old = replace(&mut self.nodes[t].value, value);
                return (t, Some(old));
            }
        }
        let t = self.skew(t);
        (self.split(t), None)
    }

    /// Unlinks the node for `key` from the subtree at `t`: the subtree's new root, and the node
    /// unlinked, or `NIL`.
    fn remove_at(&mut self, t: int, key: &K) -> (int, int) {
        if t == NIL {
            return (NIL, NIL);
        }
        // The node that roots this subtree once the removal is done, and the node unlinked.
        let (here, gone) = match key.cmp(&self.nodes[t].key) {
            Ordering::Less => {
                let at = self.nodes[t].left;
                let (l, g) = self.remove_at(at, key);
                self.nodes[t].left = l;
                (t, g)
            }
            Ordering::Greater => {
                let at = self.nodes[t].right;
                let (r, g) = self.remove_at(at, key);
                self.nodes[t].right = r;
                (t, g)
            }
            Ordering::Equal => {
                let (l, r) = (self.nodes[t].left, self.nodes[t].right);
                if l == NIL && r == NIL {
                    return (NIL, t);
                }
                // The next node in order (or the one before) takes `t`'s place.
                let (l, r, next) = if r != NIL {
                    let (r, next) = self.remove_min(r);
                    (l, r, next)
                } else {
                    let (l, next) = self.remove_max(l);
                    (l, r, next)
                };
                self.nodes[next].left = l;
                self.nodes[next].right = r;
                self.nodes[next].level = self.nodes[t].level;
                (next, t)
            }
        };
        if gone == NIL {
            return (t, NIL);
        }
        (self.rebalance(here), gone)
    }

    /// Unlinks the least node of the subtree at `t`, which is not `NIL`.
    fn remove_min(&mut self, t: int) -> (int, int) {
        let l = self.nodes[t].left;
        if l == NIL {
            return (self.nodes[t].right, t);
        }
        let (l, least) = self.remove_min(l);
        self.nodes[t].left = l;
        (self.rebalance(t), least)
    }

    /// Unlinks the greatest node of the subtree at `t`, which is not `NIL`.
    fn remove_max(&mut self, t: int) -> (int, int) {
        let r = self.nodes[t].right;
        if r == NIL {
            return (self.nodes[t].left, t);
        }
        let (r, greatest) = self.remove_max(r);
        self.nodes[t].right = r;
        (self.rebalance(t), greatest)
    }

    /// Takes the unlinked node `gone` out of the `Vec`, moving the last node into its place.
    fn free(&mut self, gone: int) -> Node<K, V> {
        let last = self.nodes.len() - 1;
        if gone != last {
            // Whatever links to `last` links to `gone` instead.
            if self.root == last {
                self.root = gone;
            } else {
                let mut t = self.root;
                loop {
                    let next = match self.nodes[last].key.cmp(&self.nodes[t].key) {
                        Ordering::Less => self.nodes[t].left,
                        _              => self.nodes[t].right,
                    };
                    if next == last {
                        if self.nodes[t].left == last {
                            self.nodes[t].left = gone;
                        } else {
                            self.nodes[t].right = gone;
                        }
                        break;
                    }
                    t = next;
                }
            }
            self.nodes.swap(gone, last);
        }
        self.nodes.pop() ?! "the tree has the node it is freeing"
    }
}

/// A tree map's entries, borrowed, in key order, up to `until` if there is one. `stack` holds
/// the nodes still to visit whose left subtrees are done, the next on top.
pub view TreeIter<K, V> {
    map: &TreeMap<K, V>,
    stack: Vec<int>,
    until: Option<&K>,
}

impl<K: Ord, V> TreeIter<K, V> {
    /// Pushes `t` and its left spine.
    fn descend(&mut self, t: int) {
        let mut t = t;
        while t != NIL {
            self.stack.push(t);
            t = self.map.nodes[t].left;
        }
    }
}

impl<K: Ord, V> Iterator for TreeIter<K, V> {
    type Item = (&K, &V);
    fn next(&mut self) -> Option<(&K, &V)> {
        let t = match self.stack.pop() {
            Some(t) => t,
            None    => return None,
        };
        if let Some(until) = self.until {
            match self.map.nodes[t].key.cmp(until) {
                Ordering::Less => {}
                _              => {
                    self.stack.clear();
                    return None;
                }
            }
        }
        let right = self.map.nodes[t].right;
        self.descend(right);
        let node = &self.map.nodes[t];
        Some((&node.key, &node.value))
    }
}

impl<K: Ord, V> IntoIterator for &TreeMap<K, V> {
    type Item = (&K, &V);
    type IntoIter = TreeIter<K, V>;
    fn into_iter(self) -> TreeIter<K, V> {
        self.iter()
    }
}

impl<K: Ord, V> core::collections::Map<K, V> for TreeMap<K, V> {
    fn len(&self) -> int {
        self.nodes.len()
    }

    fn get(&self, k: &K) -> Option<&V> {
        TreeMap::get(self, k)
    }

    fn insert(&mut self, k: K, v: V) -> Option<V> {
        TreeMap::insert(self, k, v)
    }

    fn remove(&mut self, k: &K) -> Option<V> {
        TreeMap::remove(self, k)
    }
}

// `[(k, v), …]`: later pairs win, as with `insert`.
impl<K: Ord, V> FromArrayLiteral<(K, V)> for TreeMap<K, V> {
    fn from_array<const N: int>(items: [(K, V); N]) -> TreeMap<K, V> {
        let mut m = TreeMap::new();
        for (k, v) in items {
            m.insert(k, v);
        }
        m
    }

    fn from_repeat(x: (K, V), n: int) -> TreeMap<K, V>
        where (K, V): Clone
    {
        let mut m = TreeMap::new();
        if n > 0 {
            let (k, v) = x;
            m.insert(k, v);
        }
        m
    }
}

impl<K: Ord, V> Default for TreeMap<K, V> {
    fn default() -> TreeMap<K, V> {
        TreeMap::new()
    }
}

// `{k: v, …}`, in key order.
impl<K: Ord + Debug, V: Debug> Debug for TreeMap<K, V> {
    fn fmt(&self, out: &mut dyn TextWrite) {
        out.write_char('{');
        let mut first = true;
        for (k, v) in self.iter() {
            if !first {
                out.write_str(", ");
            }
            first = false;
            Debug::fmt(k, out);
            out.write_str(": ");
            Debug::fmt(v, out);
        }
        out.write_char('}');
    }
}

/// A set of values, sorted: the keys of a `TreeMap` to `()`.
pub struct TreeSet<T> {
    map: TreeMap<T, ()>,
}

impl<T: Ord> TreeSet<T> {
    pub fn new() -> TreeSet<T> {
        TreeSet { map: TreeMap::new() }
    }

    pub fn len(&self) -> int {
        self.map.len()
    }

    pub fn is_empty(&self) -> bool {
        self.map.is_empty()
    }

    pub fn contains(&self, x: &T) -> bool {
        self.map.contains_key(x)
    }

    /// Adds `x`: whether it was not there already.
    pub fn insert(&mut self, x: T) -> bool {
        self.map.insert(x, ()).is_none()
    }

    /// Takes `x` out: whether it was there.
    pub fn remove(&mut self, x: &T) -> bool {
        self.map.remove(x).is_some()
    }

    pub fn first(&self) -> Option<&T> {
        match self.map.first() {
            Some((x, _)) => Some(x),
            None         => None,
        }
    }

    pub fn last(&self) -> Option<&T> {
        match self.map.last() {
            Some((x, _)) => Some(x),
            None         => None,
        }
    }

    /// The values, borrowed, in order.
    pub fn iter(&self) -> TreeSetIter<T> {
        TreeSetIter { inner: self.map.iter() }
    }

    /// The values at least `lo` and less than `hi`, in order.
    pub fn range(&self, lo: &T, hi: &T) -> TreeSetIter<T> {
        TreeSetIter { inner: self.map.range(lo, hi) }
    }
}

/// A tree set's values, borrowed, in order.
pub view TreeSetIter<T> {
    inner: TreeIter<T, ()>,
}

impl<T: Ord> Iterator for TreeSetIter<T> {
    type Item = &T;
    fn next(&mut self) -> Option<&T> {
        match self.inner.next() {
            Some((x, _)) => Some(x),
            None         => None,
        }
    }
}

impl<T: Ord> IntoIterator for &TreeSet<T> {
    type Item = &T;
    type IntoIter = TreeSetIter<T>;
    fn into_iter(self) -> TreeSetIter<T> {
        self.iter()
    }
}

impl<T: Ord> core::collections::Set<T> for TreeSet<T> {
    fn len(&self) -> int {
        self.map.len()
    }

    fn contains(&self, x: &T) -> bool {
        TreeSet::contains(self, x)
    }

    fn insert(&mut self, x: T) -> bool {
        TreeSet::insert(self, x)
    }

    fn remove(&mut self, x: &T) -> bool {
        TreeSet::remove(self, x)
    }
}

impl<T: Ord> FromArrayLiteral<T> for TreeSet<T> {
    fn from_array<const N: int>(items: [T; N]) -> TreeSet<T> {
        let mut s = TreeSet::new();
        for x in items {
            s.insert(x);
        }
        s
    }

    fn from_repeat(x: T, n: int) -> TreeSet<T>
        where T: Clone
    {
        let mut s = TreeSet::new();
        if n > 0 {
            s.insert(x);
        }
        s
    }
}

impl<T: Ord> Default for TreeSet<T> {
    fn default() -> TreeSet<T> {
        TreeSet::new()
    }
}

impl<T: Ord + Debug> Debug for TreeSet<T> {
    fn fmt(&self, out: &mut dyn TextWrite) {
        out.write_char('{');
        let mut first = true;
        for x in self.iter() {
            if !first {
                out.write_str(", ");
            }
            first = false;
            Debug::fmt(x, out);
        }
        out.write_char('}');
    }
}
