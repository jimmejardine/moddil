//! Collections beyond the prelude's (`stdlib.md`: Collections): `Map` and `Set` over the `core`
//! mod's hash maps, `Deque`, `RingBuffer`, `BinaryHeap`, the sorted `TreeMap` and `TreeSet`, the
//! insertion-ordered `OrderedMap` and `OrderedSet`, and `Interner` with its `Symbol`s.

use core::collections::{HashMap, HashSet, SetIter};

pub use mod::deque::{Deque, DequeIter, RingBuffer};
pub use mod::heap::BinaryHeap;
pub use mod::interner::{Interner, Symbol};
pub use mod::ordered::{OrderedIter, OrderedMap, OrderedSet, OrderedSetIter};
pub use mod::tree::{TreeIter, TreeMap, TreeSet, TreeSetIter};

/// A map from keys to values, in no particular order.
pub struct Map<K, V> {
    inner: HashMap<K, V>,
}

impl<K: Hash + Eq, V> Map<K, V> {
    pub fn new() -> Map<K, V> {
        Map { inner: HashMap::new() }
    }

    pub fn len(&self) -> int {
        self.inner.len()
    }

    pub fn is_empty(&self) -> bool {
        self.inner.is_empty()
    }

    /// The value for `key`, if there is one.
    pub fn get(&self, key: &K) -> Option<&V> {
        self.inner.get(key)
    }

    pub fn get_mut(&mut self, key: &K) -> Option<&mut V> {
        self.inner.get_mut(key)
    }

    pub fn contains_key(&self, key: &K) -> bool {
        self.inner.contains_key(key)
    }

    /// Puts `value` under `key`, giving back what was there.
    pub fn insert(&mut self, key: K, value: V) -> Option<V> {
        self.inner.insert(key, value)
    }

    pub fn remove(&mut self, key: &K) -> Option<V> {
        self.inner.remove(key)
    }
}

/// A set of values, in no particular order.
pub struct Set<T> {
    inner: HashSet<T>,
}

impl<T: Hash + Eq> Set<T> {
    pub fn new() -> Set<T> {
        Set { inner: HashSet::new() }
    }

    pub fn len(&self) -> int {
        self.inner.len()
    }

    pub fn is_empty(&self) -> bool {
        self.inner.is_empty()
    }

    pub fn contains(&self, x: &T) -> bool {
        self.inner.contains(x)
    }

    /// Adds `x`: whether it was not there already.
    pub fn insert(&mut self, x: T) -> bool {
        self.inner.insert(x)
    }

    /// Takes `x` out: whether it was there.
    pub fn remove(&mut self, x: &T) -> bool {
        self.inner.remove(x)
    }

    /// The values, borrowed, in no particular order.
    pub fn iter(&self) -> SetIter<T> {
        self.inner.iter()
    }
}

impl<T: Hash + Eq> FromArrayLiteral<T> for Set<T> {
    fn from_array<const N: int>(items: [T; N]) -> Set<T> {
        let mut s = Set::new();
        for x in items {
            s.insert(x);
        }
        s
    }

    fn from_repeat(x: T, n: int) -> Set<T> where T: Clone {
        let mut s = Set::new();
        if n > 0 {
            s.insert(x);
        }
        s
    }
}

impl<T: Hash + Eq> Default for Set<T> {
    fn default() -> Set<T> {
        Set::new()
    }
}
