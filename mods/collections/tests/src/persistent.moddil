//! The persistent collections: every update gives a new collection and leaves the old one as it
//! was, sharing what did not change.

use collections::{PersistentList, PersistentMap, PersistentSet, PersistentTreeMap, PersistentTreeSet, PersistentVec, TreeMap};

test "a list's updates leave it as it was" {
    let a: PersistentList<int> = [1, 2, 3];
    let b = a.push_front(0);
    let c = a.rest();
    a.len()  // => 3
    ;
    b.len()  // => 4
    ;
    c.first()
        .map(|x| *x)
        .unwrap_or(-1)  // => 2
    ;
    a.first()
        .map(|x| *x)
        .unwrap_or(-1)  // => 1
    ;
    let mut total = 0;
    for x in &b {
        total = total * 10 + *x;
    }
    total  // => 123
    ;
    a == b.rest()  // => true
    ;
    a == c  // => false
    ;
    fmt"{b:?}"  // => "[0, 1, 2, 3]"
}

test "a list of values that need dropping" {
    let a: PersistentList<String> = ["x".to_string(), "y".to_string()];
    let b = a.push_front("w".to_string());
    let c = b.clone();
    drop(a);
    drop(b);
    c.len()  // => 3
    ;
    c.rest().first()
        .map(|s| s.len())
        .unwrap_or(0)  // => 1
    ;
    let empty: PersistentList<String> = PersistentList::new();
    empty.rest().is_empty()  // => true
}

test "a long list is dropped cell by cell, and a shared tail stays" {
    // Three times as long as calls may nest (10,000 on every runner): dropped by one call per
    // cell, it would trap.
    let mut long: PersistentList<int> = PersistentList::new();
    for i in 0..30000 {
        long = long.push_front(i);
    }
    let tail = long.rest().rest();
    drop(long);
    tail.len()  // => 29998
    ;
    tail.first()
        .map(|x| *x)
        .unwrap_or(-1)  // => 29997
}

/// `0, 1, …, n - 1`, pushed one at a time.
fn upto(n: int) -> PersistentVec<int> {
    let mut v = PersistentVec::new();
    for i in 0..n {
        v = v.push(i);
    }
    v
}

/// Whether `v` holds `0, 1, …, n - 1`, through `get` and through its iterator.
fn counts(v: &PersistentVec<int>, n: int) -> bool {
    if v.len() != n {
        return false;
    }
    let mut i = 0;
    for x in v {
        if *x != i || v
            .get(i)
            .map(|y| *y)
            .unwrap_or(-1) != i {
            return false;
        }
        i += 1;
    }
    i == n
}

test "a vector's updates leave it as it was" {
    let a: PersistentVec<int> = [1, 2, 3];
    let b = a.push(4);
    let c = a.set(0, 10);
    let d = a.pop();
    fmt"{a:?} {b:?} {c:?} {d:?}"  // => "[1, 2, 3] [1, 2, 3, 4] [10, 2, 3] [1, 2]"
    ;
    a.get(3).is_none()  // => true
    ;
    a.last()
        .map(|x| *x)
        .unwrap_or(0)  // => 3
    ;
    a == d.push(3)  // => true
    ;
    let e: PersistentVec<int> = PersistentVec::new();
    e.pop().is_empty()  // => true
}

test "a vector grows to three levels and back" {
    // 32 in the tail, then a level of leaves under the root, then a second level past 1056.
    let sizes = [1, 31, 32, 33, 64, 65, 1056, 1057, 1100];
    for n in sizes {
        assert(counts(&upto(n), n));
    }
    let big = upto(1100);
    let mut v = big.clone();
    let mut n = 1100;
    while n > 0 {
        v = v.pop();
        n -= 1;
        if n % 31 == 0 || n == 1056 || n == 1024 || n == 32 {
            assert(counts(&v, n));
        }
    }
    assert(v.is_empty());
    assert(counts(&big, 1100));
}

test "setting values deep in a vector" {
    let v = upto(1100);
    let mut w = v.clone();
    for i in [0, 31, 32, 500, 1023, 1024, 1055, 1056, 1099] {
        w = w.set(i, -i);
    }
    assert(counts(&v, 1100));
    w
        .get(500)
        .map(|x| *x)
        .unwrap_or(0)  // => -500
    ;
    w
        .get(1099)
        .map(|x| *x)
        .unwrap_or(0)  // => -1099
    ;
    w
        .get(501)
        .map(|x| *x)
        .unwrap_or(0)  // => 501
}

test "a vector of values that need dropping" {
    let mut v: PersistentVec<String> = PersistentVec::new();
    for i in 0..40 {
        v = v.push(fmt"s{i}");
    }
    let w = v.set(3, "three".to_string()).pop();
    drop(v);
    w.len()  // => 39
    ;
    w
        .get(3)
        .map(|s| s.len())
        .unwrap_or(0)  // => 5
}

/// The value for `k`, or -1 for none.
fn at(m: &PersistentMap<int, int>, k: int) -> int {
    m
        .get(&k)
        .map(|v| *v)
        .unwrap_or(-1)
}

test "a map's updates leave it as it was" {
    let a: PersistentMap<String, int> = [("a".to_string(), 1), ("b".to_string(), 2)];
    let b = a.insert("c".to_string(), 3);
    let c = a.insert("a".to_string(), 10);
    let d = a.remove(&"a".to_string());
    a.len()  // => 2
    ;
    b.len()  // => 3
    ;
    c
        .get(&"a".to_string())
        .map(|v| *v)
        .unwrap_or(0)  // => 10
    ;
    a
        .get(&"a".to_string())
        .map(|v| *v)
        .unwrap_or(0)  // => 1
    ;
    d.contains_key(&"a".to_string())  // => false
    ;
    d.len()  // => 1
    ;
    a.remove(&"z".to_string()) == a  // => true
    ;
    b.remove(&"c".to_string()) == a  // => true
    ;
    c == a  // => false
}

test "a map of many keys" {
    // Enough that the trie is three levels deep in places.
    let mut m: PersistentMap<int, int> = PersistentMap::new();
    for i in 0..600 {
        m = m.insert(i, i * i);
    }
    let all = m.clone();
    m.len()  // => 600
    ;
    at(&m, 123)  // => 15129
    ;
    for i in 0..600 {
        if i % 3 == 0 {
            m = m.remove(&i);
        }
    }
    m.len()  // => 400
    ;
    at(&m, 297)  // => -1
    ;
    at(&m, 301)  // => 90601
    ;
    at(&all, 297)  // => 88209
    ;
    let mut count = 0;
    let mut sum = 0;
    for (k, v) in &m {
        count += 1;
        sum += *v - *k * *k;
    }
    count  // => 400
    ;
    sum  // => 0
    ;
    for i in 0..600 {
        m = m.remove(&i);
    }
    m.is_empty()  // => true
}

/// A key whose every value has one hash, so they all collide.
#[derive(Clone, PartialEq, Eq, Debug)]
struct Same(int);

impl Hash for Same {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_int(7);
    }
}

test "keys whose hashes collide" {
    let mut m: PersistentMap<Same, int> = PersistentMap::new();
    for i in 0..5 {
        m = m.insert(Same(i), i);
    }
    let n = m
        .insert(Same(2), 20)
        .remove(&Same(4));
    m.len()  // => 5
    ;
    n.len()  // => 4
    ;
    n
        .get(&Same(2))
        .map(|v| *v)
        .unwrap_or(0)  // => 20
    ;
    m
        .get(&Same(2))
        .map(|v| *v)
        .unwrap_or(0)  // => 2
    ;
    let mut rest = n.clone();
    for i in 0..4 {
        rest = rest.remove(&Same(i));
    }
    rest.is_empty()  // => true
    ;
    let mut keys = 0;
    for (k, _) in &n {
        keys += k.0;
    }
    keys  // => 6
}

test "a map of values that need dropping" {
    let mut m: PersistentMap<String, String> = PersistentMap::new();
    for i in 0..100 {
        m = m.insert(fmt"k{i}", fmt"v{i}");
    }
    let n = m
        .remove(&"k5".to_string())
        .insert("k6".to_string(), "six".to_string());
    drop(m);
    n.len()  // => 99
    ;
    n
        .get(&"k6".to_string())
        .map(|s| s.len())
        .unwrap_or(0)  // => 3
}

test "a set's updates leave it as it was" {
    let a: PersistentSet<int> = [3, 1, 3, 2];
    let b = a
        .insert(4)
        .remove(&1);
    a.len()  // => 3
    ;
    b.contains(&1)  // => false
    ;
    a.contains(&1)  // => true
    ;
    b.len()  // => 3
    ;
    let mut total = 0;
    for x in &b {
        total += *x;
    }
    total  // => 9
    ;
    a == b
        .insert(1)
        .remove(&4)  // => true
    ;
    let one: PersistentSet<int> = [5];
    fmt"{one:?}"  // => "{5}"
}

fn tree_at(m: &PersistentTreeMap<int, int>, k: int) -> int {
    m
        .get(&k)
        .map(|v| *v)
        .unwrap_or(-1)
}

/// Whether `m` holds just what `want` does, in the same order.
fn same(m: &PersistentTreeMap<int, int>, want: &TreeMap<int, int>) -> bool {
    if m.len() != want.len() {
        return false;
    }
    let mut theirs = want.iter();
    for (k, v) in m {
        match theirs.next() {
            Some((j, w)) if *k == *j && *v == *w => {}
            _                                    => return false,
        }
    }
    true
}

test "a sorted persistent map's updates leave it as it was" {
    let a: PersistentTreeMap<String, int> = [("b".to_string(), 2), ("a".to_string(), 1)];
    let b = a.insert("c".to_string(), 3);
    let c = a.insert("a".to_string(), 10);
    let d = a.remove(&"a".to_string());
    a.len()  // => 2
    ;
    b.len()  // => 3
    ;
    c
        .get(&"a".to_string())
        .map(|v| *v)
        .unwrap_or(0)  // => 10
    ;
    a
        .get(&"a".to_string())
        .map(|v| *v)
        .unwrap_or(0)  // => 1
    ;
    d.contains_key(&"a".to_string())  // => false
    ;
    a.remove(&"z".to_string()) == a  // => true
    ;
    b.remove(&"c".to_string()) == a  // => true
    ;
    c == a  // => false
    ;
    fmt"{b:?}"  // => "{\"a\": 1, \"b\": 2, \"c\": 3}"
}

test "a sorted persistent map stays sorted through many updates" {
    // Keys in a scrambled order, checked against a `TreeMap` after each step, and the versions
    // before kept.
    let mut m: PersistentTreeMap<int, int> = PersistentTreeMap::new();
    let mut want: TreeMap<int, int> = TreeMap::new();
    let mut x = 1;
    let mut ok = true;
    for _ in 0..1000 {
        x = x * 7919 % 1009;
        m = m.insert(x, x * 2);
        want.insert(x, x * 2);
    }
    ok = ok && same(&m, &want);
    let full = m.clone();
    for _ in 0..700 {
        x = x * 7919 % 1009;
        m = m.remove(&x);
        want.remove(&x);
    }
    ok = ok && same(&m, &want);
    ok  // => true
    ;
    full.len()  // => 1000
    ;
    m.len()  // => 308
    ;
    tree_at(&full, 500)  // => 1000
    ;
    full.first().map(|(k, _)| *k)  // => Some(2)
    ;
    full.last().map(|(k, _)| *k)  // => Some(1008)
    ;
    let mut prev = -1;
    let mut sorted = true;
    for (k, _) in &full {
        sorted = sorted && *k > prev;
        prev = *k;
    }
    sorted  // => true
    ;
    for (k, _) in &full {
        m = m.remove(k);
    }
    m.is_empty()  // => true
    ;
    m.first().is_none()  // => true
}

test "a sorted persistent map's ranges" {
    let mut m: PersistentTreeMap<int, int> = PersistentTreeMap::new();
    for i in 0..50 {
        m = m.insert(i * 2, i);
    }
    let mut keys = 0;
    let mut n = 0;
    for (k, _) in m.range(&9, &21) {
        keys += *k;
        n += 1;
    }
    n  // => 6
    ;
    keys  // => 90
    ;
    m.range(&200, &300).next().is_none()  // => true
    ;
    m
        .range(&-5, &1)
        .next()
        .map(|(k, _)| *k)  // => Some(0)
}

test "a sorted persistent map of values that need dropping" {
    let mut m: PersistentTreeMap<String, String> = PersistentTreeMap::new();
    for i in 0..100 {
        m = m.insert(fmt"k{i}", fmt"v{i}");
    }
    let n = m
        .remove(&"k5".to_string())
        .insert("k6".to_string(), "six".to_string());
    drop(m);
    n.len()  // => 99
    ;
    n
        .get(&"k6".to_string())
        .map(|s| s.len())
        .unwrap_or(0)  // => 3
    ;
    n.first().map(|(k, _)| k.len())  // => Some(2)
}

test "a sorted persistent set" {
    let a: PersistentTreeSet<int> = [3, 1, 3, 2];
    let b = a
        .insert(4)
        .remove(&1);
    a.len()  // => 3
    ;
    b.contains(&1)  // => false
    ;
    a.contains(&1)  // => true
    ;
    fmt"{a:?}"  // => "{1, 2, 3}"
    ;
    fmt"{b:?}"  // => "{2, 3, 4}"
    ;
    a == b
        .insert(1)
        .remove(&4)  // => true
    ;
    b.first().map(|x| *x)  // => Some(2)
    ;
    let mut total = 0;
    for x in a.range(&2, &10) {
        total += *x;
    }
    total  // => 5
}
