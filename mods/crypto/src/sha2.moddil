//! SHA-256 and SHA-512 (FIPS 180-4).

/// SHA-256's round constants: the first 32 bits of the fractional parts of the cube roots of the
/// first 64 primes.
const K256: [u32; 64] = [0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2];

/// SHA-256's first hash value: the square roots of the first 8 primes, likewise.
const H256: [u32; 8] = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];

/// SHA-512's round constants: 64 bits of the cube roots of the first 80 primes.
const K512: [u64; 80] = [0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc, 0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118, 0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2, 0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694, 0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65, 0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5, 0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4, 0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70, 0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df, 0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b, 0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30, 0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8, 0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8, 0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3, 0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec, 0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b, 0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178, 0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b, 0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c, 0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817];

/// SHA-512's first hash value.
const H512: [u64; 8] = [0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1, 0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179];

/// `x` rotated right by `n` bits, `0 < n < 32`. `<<` traps on lost bits, so they are masked off
/// first.
fn rotr32(x: u32, n: u32) -> u32 {
    (x >> n) | ((x & ((1 << n) - 1)) << (32 - n))
}

fn rotr64(x: u64, n: u64) -> u64 {
    (x >> n) | ((x & ((1 << n) - 1)) << (64 - n))
}

/// SHA-256, fed in parts: `update` as often as wanted, then `finalize`.
pub struct Sha256 {
    h: [u32; 8],
    block: [u8; 64],
    block_len: int,
    /// The bytes fed so far.
    total: u64,
}

impl Sha256 {
    pub fn new() -> Sha256 {
        Sha256 { h: H256, block: [0; 64], block_len: 0, total: 0 }
    }

    pub fn update(&mut self, data: &[u8]) {
        let mut i = 0;
        while i < data.len() {
            self.push(data[i]);
            i += 1;
        }
        self.total +%= data.len().wrap::<u64>();
    }

    /// The 32-byte digest.
    pub fn finalize(self) -> Vec<u8> {
        let mut s = self;
        let bits = s.total *% 8;
        s.push(0x80);
        while s.block_len != 56 {
            s.push(0);
        }
        let mut shift: u64 = 56;
        loop {
            s.push((bits >> shift).truncate::<u8>());
            if shift == 0 {
                break;
            }
            shift -= 8;
        }
        let mut out: Vec<u8> = Vec::with_capacity(32);
        for word in s.h {
            out.push((word >> 24).truncate::<u8>());
            out.push((word >> 16).truncate::<u8>());
            out.push((word >> 8).truncate::<u8>());
            out.push(word.truncate::<u8>());
        }
        out
    }

    fn push(&mut self, b: u8) {
        self.block[self.block_len] = b;
        self.block_len += 1;
        if self.block_len == 64 {
            self.compress();
            self.block_len = 0;
        }
    }

    fn compress(&mut self) {
        let mut w: [u32; 64] = [0; 64];
        let mut t = 0;
        while t < 16 {
            let a: u32 = self.block[4 * t];
            let b: u32 = self.block[4 * t + 1];
            let c: u32 = self.block[4 * t + 2];
            let d: u32 = self.block[4 * t + 3];
            w[t] = (a << 24) | (b << 16) | (c << 8) | d;
            t += 1;
        }
        while t < 64 {
            let x = w[t - 15];
            let y = w[t - 2];
            let s0 = rotr32(x, 7) ^ rotr32(x, 18) ^ (x >> 3);
            let s1 = rotr32(y, 17) ^ rotr32(y, 19) ^ (y >> 10);
            w[t] = w[t - 16] +% s0 +% w[t - 7] +% s1;
            t += 1;
        }
        let mut v = self.h;
        t = 0;
        while t < 64 {
            let s1 = rotr32(v[4], 6) ^ rotr32(v[4], 11) ^ rotr32(v[4], 25);
            let ch = (v[4] & v[5]) ^ (!v[4] & v[6]);
            let t1 = v[7] +% s1 +% ch +% K256[t] +% w[t];
            let s0 = rotr32(v[0], 2) ^ rotr32(v[0], 13) ^ rotr32(v[0], 22);
            let maj = (v[0] & v[1]) ^ (v[0] & v[2]) ^ (v[1] & v[2]);
            let t2 = s0 +% maj;
            v[7] = v[6];
            v[6] = v[5];
            v[5] = v[4];
            v[4] = v[3] +% t1;
            v[3] = v[2];
            v[2] = v[1];
            v[1] = v[0];
            v[0] = t1 +% t2;
            t += 1;
        }
        let mut i = 0;
        while i < 8 {
            self.h[i] = self.h[i] +% v[i];
            i += 1;
        }
    }
}

/// The SHA-256 digest of `data`.
pub fn sha256(data: &[u8]) -> Vec<u8> {
    let mut h = Sha256::new();
    h.update(data);
    h.finalize()
}

/// SHA-512, fed in parts: `update` as often as wanted, then `finalize`.
pub struct Sha512 {
    h: [u64; 8],
    block: [u8; 128],
    block_len: int,
    total: u64,
}

impl Sha512 {
    pub fn new() -> Sha512 {
        Sha512 { h: H512, block: [0; 128], block_len: 0, total: 0 }
    }

    pub fn update(&mut self, data: &[u8]) {
        let mut i = 0;
        while i < data.len() {
            self.push(data[i]);
            i += 1;
        }
        self.total +%= data.len().wrap::<u64>();
    }

    /// The 64-byte digest.
    pub fn finalize(self) -> Vec<u8> {
        let mut s = self;
        let bits = s.total *% 8;
        s.push(0x80);
        // The length is 128 bits; its high 64 are zero for any input this can be fed.
        while s.block_len != 112 {
            s.push(0);
        }
        let mut i = 0;
        while i < 8 {
            s.push(0);
            i += 1;
        }
        let mut shift: u64 = 56;
        loop {
            s.push((bits >> shift).truncate::<u8>());
            if shift == 0 {
                break;
            }
            shift -= 8;
        }
        let mut out: Vec<u8> = Vec::with_capacity(64);
        for word in s.h {
            let mut shift: u64 = 56;
            loop {
                out.push((word >> shift).truncate::<u8>());
                if shift == 0 {
                    break;
                }
                shift -= 8;
            }
        }
        out
    }

    fn push(&mut self, b: u8) {
        self.block[self.block_len] = b;
        self.block_len += 1;
        if self.block_len == 128 {
            self.compress();
            self.block_len = 0;
        }
    }

    fn compress(&mut self) {
        let mut w: [u64; 80] = [0; 80];
        let mut t = 0;
        while t < 16 {
            let mut word: u64 = 0;
            let mut i = 0;
            while i < 8 {
                let b: u64 = self.block[8 * t + i];
                word = (word << 8) | b;
                i += 1;
            }
            w[t] = word;
            t += 1;
        }
        while t < 80 {
            let x = w[t - 15];
            let y = w[t - 2];
            let s0 = rotr64(x, 1) ^ rotr64(x, 8) ^ (x >> 7);
            let s1 = rotr64(y, 19) ^ rotr64(y, 61) ^ (y >> 6);
            w[t] = w[t - 16] +% s0 +% w[t - 7] +% s1;
            t += 1;
        }
        let mut v = self.h;
        t = 0;
        while t < 80 {
            let s1 = rotr64(v[4], 14) ^ rotr64(v[4], 18) ^ rotr64(v[4], 41);
            let ch = (v[4] & v[5]) ^ (!v[4] & v[6]);
            let t1 = v[7] +% s1 +% ch +% K512[t] +% w[t];
            let s0 = rotr64(v[0], 28) ^ rotr64(v[0], 34) ^ rotr64(v[0], 39);
            let maj = (v[0] & v[1]) ^ (v[0] & v[2]) ^ (v[1] & v[2]);
            let t2 = s0 +% maj;
            v[7] = v[6];
            v[6] = v[5];
            v[5] = v[4];
            v[4] = v[3] +% t1;
            v[3] = v[2];
            v[2] = v[1];
            v[1] = v[0];
            v[0] = t1 +% t2;
            t += 1;
        }
        let mut i = 0;
        while i < 8 {
            self.h[i] = self.h[i] +% v[i];
            i += 1;
        }
    }
}

/// The SHA-512 digest of `data`.
pub fn sha512(data: &[u8]) -> Vec<u8> {
    let mut h = Sha512::new();
    h.update(data);
    h.finalize()
}
