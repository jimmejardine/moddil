use gpu::{Gpu, Image, Rgba8, Tile};

test "a pixel packs red lowest, alpha opaque" {
    assert(Rgba8::rgb(1.0, 0.0, 0.0).packed() == 4278190335);
    assert(Rgba8::grey(0.5).packed() & 255 == 128);
    // Out of range components are clamped.
    assert(Rgba8::rgb(2.0, -1.0, 0.0) == Rgba8::rgb(1.0, 0.0, 0.0));
}

/// How far right a pixel is, as its brightness: 0 at the left edge, near 1 at the right.
struct Ramp {
    width: int,
}

fn float(i: int) -> f32 {
    i.to::<f32>() ?! "a small number"
}

#[kernel]
fn ramp(p: &Ramp, out: &mut Tile) {
    let mut py = 0;
    while py < 8 {
        let mut px = 0;
        while px < 8 {
            let c = Rgba8::grey(float(out.x + px) / float(p.width));
            out.set(px, py, c);
            px += 1;
        }
        py += 1;
    }
}

test "the simulator runs a kernel over each tile, clipped to the image" {
    // 10 x 9: tiles overhang the right and bottom edges, which are not drawn.
    let mut image = Image::new(10, 9);
    with Gpu = gpu::simulator() {
        gpu::launch(ramp, &Ramp { width: 10 }, &mut image);
    }
    assert(image.pixel(0, 0).packed() & 255 == 0);
    assert(image.pixel(5, 8).packed() & 255 == 128);
    assert(image.pixel(9, 4).packed() & 255 == 230);
    // Each row's pixels are 0 to 0.9 of 255, rounded (1150 in all), in each channel alike.
    let (r, g, b) = image.summary();
    assert(r == 9 * 1150 && g == r && b == r);
}

#[kernel]
fn ramp_each(p: &Ramp, out: &mut Tile) {
    let x = out.x;
    out.each(|px, py| Rgba8::grey(float(x + px) / float(p.width)));
}

test "each draws a tile's pixels as set does" {
    let mut a = Image::new(10, 9);
    let mut b = Image::new(10, 9);
    with Gpu = gpu::simulator() {
        gpu::launch(ramp, &Ramp { width: 10 }, &mut a);
        gpu::launch(ramp_each, &Ramp { width: 10 }, &mut b);
    }
    let (r, _, _) = b.summary();
    assert(r == 9 * 1150 && b.pixel(9, 4) == a.pixel(9, 4));
}

test "present draws on the simulator where there is no GPU" {
    let mut image = Image::new(10, 9);
    with Gpu = gpu::simulator() {
        gpu::present(ramp_each, &Ramp { width: 10 }, &mut image);
    }
    let (r, _, _) = image.summary();
    assert(r == 9 * 1150);
}

/// Four greys, a kernel's parameters as an array.
struct Palette {
    greys: [f32; 4],
}

/// The largest of `xs`.
fn largest(xs: &[f32]) -> f32 {
    let mut best = xs[0];
    let mut i = 1;
    while i < xs.len() {
        if xs[i] > best {
            best = xs[i];
        }
        i += 1;
    }
    best
}

#[kernel]
fn bands(p: &Palette, out: &mut Tile) {
    // An array of the kernel's own, and slices of the parameters' array.
    let order = [3, 1, 2, 0];
    let top = largest(&p.greys);
    let tail = largest(&p.greys[2..]);
    out.each(|px, _| Rgba8::grey(p.greys[order[px % 4]] / top * tail));
}

test "a kernel indexes arrays and slices of them" {
    let p = Palette { greys: [0.25, 0.5, 0.75, 1.0] };
    let mut image = Image::new(8, 8);
    with Gpu = gpu::simulator() {
        gpu::launch(bands, &p, &mut image);
    }
    assert(image.pixel(0, 0) == Rgba8::grey(1.0));
    assert(image.pixel(1, 3) == Rgba8::grey(0.5));
    assert(image.pixel(6, 7) == Rgba8::grey(0.75));
    assert(image.pixel(3, 0) == Rgba8::grey(0.25));
}
