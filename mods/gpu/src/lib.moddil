//! GPU kernels (`accelerators.md`): images of RGBA8 pixels, the tiles a kernel draws, the `Gpu`
//! effect, and `launch`, which runs a `#[kernel]` over an image on the GPU, or on the CPU
//! simulator where there is none. The simulator runs the same kernel, tile by tile, so an image is
//! the same on every machine with no GPU.

use core::gpu as sys;

/// A pixel: red, green, blue and alpha, a byte each, packed into a `u32` with red lowest.
#[derive(Copy, Clone, PartialEq, Debug)]
pub struct Rgba8 {
    packed: u32,
}

impl Rgba8 {
    /// A grey of brightness `v`, from 0 (black) to 1 (white), clamped.
    pub fn grey(v: f32) -> Rgba8 {
        let b = byte(v);
        Rgba8 { packed: b | (b << 8) | (b << 16) | (255 << 24) }
    }

    /// The colour with these components, each from 0 to 1, clamped.
    pub fn rgb(r: f32, g: f32, b: f32) -> Rgba8 {
        Rgba8 { packed: byte(r) | (byte(g) << 8) | (byte(b) << 16) | (255 << 24) }
    }

    pub fn packed(&self) -> u32 {
        self.packed
    }
}

/// `v`, clamped to [0, 1], as a byte from 0 to 255.
fn byte(v: f32) -> u32 {
    let c = (v.clamp(0.0, 1.0) * 255.0 + 0.5).floor();
    c.to::<u32>() ?! "a whole number from 0 to 255"
}

/// The 8 x 8 pixels one kernel instance draws: the tile at (`x`, `y`) of the image.
pub struct Tile {
    /// The tile's top left pixel in the image.
    pub x: int,
    pub y: int,
    pixels: [u32; 64],
}

impl Tile {
    /// Sets pixel (`px`, `py`) of the tile, each from 0 to 7.
    pub fn set(&mut self, px: int, py: int, c: Rgba8) {
        self.pixels[py * 8 + px] = c.packed;
    }

    /// Sets each pixel (`px`, `py`) of the tile, each from 0 to 7, to `f(px, py)`. On a GPU the
    /// tile is a workgroup of 8 x 8 threads, each computing its own pixel in parallel; the CPU
    /// simulator computes them in turn.
    pub fn each<F: Fn(int, int) -> Rgba8>(&mut self, f: F) {
        let mut py = 0;
        while py < 8 {
            let mut px = 0;
            while px < 8 {
                let c = f(px, py);
                self.set(px, py, c);
                px += 1;
            }
            py += 1;
        }
    }
}

/// An image: `width` x `height` pixels, row by row.
pub struct Image {
    width: int,
    height: int,
    pixels: Vec<u32>,
}

impl Image {
    /// A black image of `width` x `height` pixels.
    pub fn new(width: int, height: int) -> Image {
        let black: u32 = 0;
        let pixels: Vec<u32> = [black; width * height];
        Image { width, height, pixels }
    }

    pub fn width(&self) -> int {
        self.width
    }

    pub fn height(&self) -> int {
        self.height
    }

    /// Pixel (`x`, `y`).
    pub fn pixel(&self, x: int, y: int) -> Rgba8 {
        Rgba8 { packed: self.pixels[y * self.width + x] }
    }

    /// A summary for comparing images: the red, green and blue bytes, each summed over every
    /// pixel.
    pub fn summary(&self) -> (int, int, int) {
        let mut r = 0;
        let mut g = 0;
        let mut b = 0;
        for p in self.pixels.iter() {
            r += (*p & 255).to::<int>() ?! "a byte";
            g += ((*p >> 8) & 255).to::<int>() ?! "a byte";
            b += ((*p >> 16) & 255).to::<int>() ?! "a byte";
        }
        (r, g, b)
    }
}

/// Running kernels, as an effect: on a GPU, or not at all (then `launch` and `present` use the
/// simulator).
pub trait Gpu {
    /// Runs kernel `source` (WGSL) with `params` over an image the size of `image`: shows it on
    /// the screen if `show`, and reads its pixels back into `image` if `read`: 0 if it could not
    /// (and nothing ran), 1 if it ran, and `k + 2` if a check of the kernel failed there, its
    /// site `k` (`gpu.trap.1`).
    fn run(&self, source: &str, params: &[u8], image: &mut Image, show: bool, read: bool) -> int with suspend;

    /// Shows `image`, drawn on the CPU, on the screen, where there is one.
    fn show(&self, image: &Image) with suspend;
}

/// The CPU simulator: no GPU, so `launch` runs each kernel instance on the CPU.
pub struct Simulator {}

impl Gpu for Simulator {
    fn run(&self, source: &str, params: &[u8], image: &mut Image, show: bool, read: bool) -> int with suspend {
        0
    }

    fn show(&self, image: &Image) with suspend {}
}

/// The CPU simulator.
pub fn simulator() -> Simulator {
    Simulator {}
}

/// The machine's GPU: WebGPU in a browser page, which also shows each image it draws in the
/// page's canvas. Without one (a native run, a test), the simulator draws instead.
#[root_capability]
pub struct GpuRoot {
    handle: int,
}

/// `dispatch`'s modes (`gpu.1`): show the image on the screen, read its pixels back.
const SHOW: int = 1;
const READ: int = 2;

impl Gpu for GpuRoot {
    fn run(&self, source: &str, params: &[u8], image: &mut Image, show: bool, read: bool) -> int with suspend {
        let mode = (if show { SHOW } else { 0 }) + (if read { READ } else { 0 });
        sys::dispatch(source, params, image.width, image.height, image.pixels.as_mut_slice(), mode)
    }

    fn show(&self, image: &Image) with suspend {
        sys::show(image.pixels.as_slice(), image.width, image.height);
    }
}

/// Runs `kernel` (a function marked `#[kernel]`) over `image`, one instance per 8 x 8 tile, each
/// given `params` and its tile: on the GPU if there is one, else on the CPU simulator. It returns
/// once every instance has run: the image is drawn. A check that fails in an instance on the GPU
/// (an overflow, an index out of bounds, a failed `?!`) traps here, as the same check does on the
/// CPU (`gpu.trap.1`).
pub fn launch<P, K: Fn(&P, &mut Tile)>(kernel: K, params: &P, image: &mut Image) with gpu: Gpu, suspend {
    let ran = gpu.run(sys::source(&kernel), sys::bytes(params), image, false, true);
    if ran >= 2 {
        sys::trap(&kernel, ran - 2);
    }
    if ran == 1 {
        return;
    }
    simulate(kernel, params, image);
}

/// Shows the image `kernel` draws with `params`, the size of `image`, on the screen: on the GPU,
/// straight to the screen, with no copy back (`image` is left as it was); without one, drawn on
/// the CPU simulator into `image`, then shown.
pub fn present<P, K: Fn(&P, &mut Tile)>(kernel: K, params: &P, image: &mut Image) with gpu: Gpu, suspend {
    let ran = gpu.run(sys::source(&kernel), sys::bytes(params), image, true, false);
    if ran >= 2 {
        sys::trap(&kernel, ran - 2);
    }
    if ran == 1 {
        return;
    }
    simulate(kernel, params, image);
    gpu.show(image);
}

/// Runs `kernel` over `image` on the CPU, tile by tile.
fn simulate<P, K: Fn(&P, &mut Tile)>(kernel: K, params: &P, image: &mut Image) {
    let mut ty = 0;
    while ty < image.height {
        let mut tx = 0;
        while tx < image.width {
            let mut tile = Tile { x: tx, y: ty, pixels: [0; 64] };
            kernel(params, &mut tile);
            let mut py = 0;
            while py < 8 && ty + py < image.height {
                let mut px = 0;
                while px < 8 && tx + px < image.width {
                    image.pixels[(ty + py) * image.width + tx + px] = tile.pixels[py * 8 + px];
                    px += 1;
                }
                py += 1;
            }
            tx += 8;
        }
        ty += 8;
    }
}
