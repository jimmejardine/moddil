// text's own tests: graphemes, on Unicode's own cases and some written here.

use text::{Graphemes, unicode_version};

use mod::cases::CASES;

/// Byte `i` of `s`, as an `int`.
fn byte(s: &str, i: int) -> int {
    s.byte_at(i).checked_to::<int>() ?! "a byte is an int"
}

/// Whether `s` is the text `t`.
fn is(s: &String, t: &str) -> bool {
    let a: &str = s;
    a == t
}

test "every case of Unicode's GraphemeBreakTest.txt" {
    let n = CASES.len();
    let mut cases = 0;
    let mut failed = 0;
    let mut i = 0;
    while i < n {
        // Its code points, to the `:`, then its boundaries, to the `;`.
        let mut text = String::new();
        let mut v = 0;
        while byte(CASES, i) != 58 {
            let b = byte(CASES, i);
            if b == 46 {
                text.push(char::from_code(v) ?! "a code point");
                v = 0;
            } else {
                v = v * 10 + b - 48;
            }
            i += 1;
        }
        text.push(char::from_code(v) ?! "a code point");
        i += 1;
        let mut want: Vec<int> = Vec::new();
        v = 0;
        while i < n && byte(CASES, i) != 59 {
            let b = byte(CASES, i);
            if b == 46 {
                want.push(v);
                v = 0;
            } else {
                v = v * 10 + b - 48;
            }
            i += 1;
        }
        want.push(v);
        i += 1;
        let t: &str = &text;
        if t.grapheme_bounds() != want {
            failed += 1;
        }
        cases += 1;
    }
    assert(cases == 1093);
    assert(failed == 0);
}

test "a grapheme is what a reader sees as one character" {
    // A letter and a combining accent.
    assert("e\u{301}".grapheme_count() == 1);
    assert("e\u{301}".chars().count() == 2);
    // CR LF.
    assert("a\r\nb".grapheme_count() == 3);
    // Flags: regional indicators in pairs.
    assert("\u{1F1EB}\u{1F1F7}\u{1F1E9}\u{1F1EA}".grapheme_count() == 2);
    // A family: emoji joined by ZWJ.
    assert("\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}".grapheme_count() == 1);
    // Hangul jamo making one syllable, then a precomposed one.
    assert("\u{1100}\u{1161}\u{11A8}\u{D55C}".grapheme_count() == 2);
    // A Devanagari conjunct: consonant, virama, consonant.
    assert("\u{915}\u{94D}\u{937}".grapheme_count() == 1);
    assert("".grapheme_count() == 0);
}

test "a text's graphemes and their bounds" {
    let g = "ae\u{301}!".graphemes();
    assert(g.len() == 3);
    assert(is(&g[1], "e\u{301}"));
    let want: Vec<int> = [0, 1, 4, 5];
    assert("ae\u{301}!".grapheme_bounds() == want);
    assert("".grapheme_bounds().is_empty());
    let v: &str = unicode_version();
    assert(v == "16.0.0");
}
