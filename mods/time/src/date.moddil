//! Dates in the proleptic Gregorian calendar, as days from 1970-01-01, after Howard Hinnant's
//! `days_from_civil` and `civil_from_days` ("chrono-Compatible Low-Level Date Algorithms").

/// A day of the week.
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
pub enum Weekday {
    Monday,
    Tuesday,
    Wednesday,
    Thursday,
    Friday,
    Saturday,
    Sunday,
}

impl Weekday {
    /// 1 for Monday to 7 for Sunday (ISO 8601).
    pub fn number(self) -> int {
        match self {
            Weekday::Monday => 1,
            Weekday::Tuesday => 2,
            Weekday::Wednesday => 3,
            Weekday::Thursday => 4,
            Weekday::Friday => 5,
            Weekday::Saturday => 6,
            Weekday::Sunday => 7,
        }
    }

    fn of_number(n: int) -> Weekday {
        match n {
            1 => Weekday::Monday,
            2 => Weekday::Tuesday,
            3 => Weekday::Wednesday,
            4 => Weekday::Thursday,
            5 => Weekday::Friday,
            6 => Weekday::Saturday,
            _ => Weekday::Sunday,
        }
    }
}

impl Display for Weekday {
    fn fmt(&self, out: &mut String) {
        out.push_str(match self {
            Weekday::Monday => "Monday",
            Weekday::Tuesday => "Tuesday",
            Weekday::Wednesday => "Wednesday",
            Weekday::Thursday => "Thursday",
            Weekday::Friday => "Friday",
            Weekday::Saturday => "Saturday",
            Weekday::Sunday => "Sunday",
        });
    }
}

/// Whether `year` has a 29 February.
pub fn is_leap_year(year: int) -> bool {
    year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
}

/// The days in month `month` (1 to 12) of `year`.
pub fn days_in_month(year: int, month: int) -> int {
    match month {
        2 => if is_leap_year(year) { 29 } else { 28 },
        4 | 6 | 9 | 11 => 30,
        _ => 31,
    }
}

/// `a / b` rounded toward −∞, for `b` positive.
fn floor_div(a: int, b: int) -> int {
    let q = a / b;
    if a % b < 0 { q - 1 } else { q }
}

/// A date: a year (which may be 0 or negative, proleptically), a month from 1 to 12, and a day
/// of it. Dates order by time.
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]
pub struct Date {
    year: int,
    month: int,
    day: int,
}

impl Date {
    /// The date, if `month` and `day` make one in `year`.
    pub fn new(year: int, month: int, day: int) -> Option<Date> {
        if month < 1 || month > 12 || day < 1 || day > days_in_month(year, month) {
            return None;
        }
        Some(Date { year, month, day })
    }

    pub fn year(&self) -> int {
        self.year
    }

    pub fn month(&self) -> int {
        self.month
    }

    pub fn day(&self) -> int {
        self.day
    }

    /// Days since 1970-01-01, negative before it.
    pub fn days_since_epoch(&self) -> int {
        // Years start in March, so 29 February ends one.
        let y = if self.month <= 2 { self.year - 1 } else { self.year };
        let era = floor_div(y, 400);
        let yoe = y - era * 400;
        let mp = (self.month + 9) % 12;
        let doy = (153 * mp + 2) / 5 + self.day - 1;
        let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
        era * 146097 + doe - 719468
    }

    /// The date `days` after 1970-01-01.
    pub fn from_days_since_epoch(days: int) -> Date {
        let z = days + 719468;
        let era = floor_div(z, 146097);
        let doe = z - era * 146097;
        let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
        let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
        let mp = (5 * doy + 2) / 153;
        let day = doy - (153 * mp + 2) / 5 + 1;
        let month = if mp < 10 { mp + 3 } else { mp - 9 };
        let year = yoe + era * 400 + if month <= 2 { 1 } else { 0 };
        Date { year, month, day }
    }

    pub fn weekday(&self) -> Weekday {
        // 1970-01-01 was a Thursday, the 4th day of an ISO week.
        let n = (self.days_since_epoch() + 3) % 7;
        let n = if n < 0 { n + 7 } else { n };
        Weekday::of_number(n + 1)
    }

    /// The day of the year, from 1.
    pub fn ordinal(&self) -> int {
        let mut n = self.day;
        let mut m = 1;
        while m < self.month {
            n += days_in_month(self.year, m);
            m += 1;
        }
        n
    }

    /// The date `n` days later (earlier for a negative `n`).
    pub fn add_days(&self, n: int) -> Date {
        Date::from_days_since_epoch(self.days_since_epoch() + n)
    }

    /// The date `n` months later, its day clamped to the month's last (31 January plus a month
    /// is 28 or 29 February).
    pub fn add_months(&self, n: int) -> Date {
        let total = self.year * 12 + (self.month - 1) + n;
        let year = floor_div(total, 12);
        let month = total - year * 12 + 1;
        let last = days_in_month(year, month);
        Date { year, month, day: if self.day > last { last } else { self.day } }
    }

    /// Days from this date to `other`: negative if `other` is earlier.
    pub fn days_until(&self, other: &Date) -> int {
        other.days_since_epoch() - self.days_since_epoch()
    }

    /// An ISO 8601 calendar date, `YYYY-MM-DD` (four digits of year, from 0000 to 9999).
    pub fn parse(s: &str) -> Option<Date> {
        if s.len() != 10 || s.byte_at(4) != 45 || s.byte_at(7) != 45 {
            return None;
        }
        Date::new(digits(s, 0, 4)?, digits(s, 5, 2)?, digits(s, 8, 2)?)
    }
}

/// The number written by the `n` ASCII digits of `s` from byte `at`.
pub(mod) fn digits(s: &str, at: int, n: int) -> Option<int> {
    if at + n > s.len() {
        return None;
    }
    let mut v = 0;
    let mut i = 0;
    while i < n {
        let c: int = s.byte_at(at + i);
        if c < 48 || c > 57 {
            return None;
        }
        v = v * 10 + (c - 48);
        i += 1;
    }
    Some(v)
}

/// `n` in at least `width` digits, zeros in front.
pub(mod) fn padded(out: &mut String, n: int, width: int) {
    let s = n.to_string();
    let mut pad = width - s.len();
    while pad > 0 {
        out.push('0');
        pad -= 1;
    }
    out.push_str(&s);
}

/// ISO 8601: `2024-02-29`; a year before 1 or past 9999 is written with its sign.
impl Display for Date {
    fn fmt(&self, out: &mut String) {
        if self.year < 0 {
            out.push('-');
            padded(out, -self.year, 4);
        } else {
            if self.year > 9999 {
                out.push('+');
            }
            padded(out, self.year, 4);
        }
        out.push('-');
        padded(out, self.month, 2);
        out.push('-');
        padded(out, self.day, 2);
    }
}
