//! The network.

/// Network access, as an effect.
pub trait Net {
    /// The address `host` names.
    fn resolve(&self, host: &str) -> String;
}

/// Why a network operation failed.
pub struct NetError { reason: String }

impl Display for NetError {
    fn fmt(&self, out: &mut String);
}

/// A URL.
pub struct Url { text: String }

impl Url {
    /// Its scheme: what comes before `:` (`https`).
    pub const fn scheme(&self) -> &str {
        let text: &str = &self.text;
        match text.split_once(":") {
            Some((scheme, _)) => scheme,
            None => "",
        }
    }
}

/// A URL is written as its text.
impl mod::serde::Serialize for Url {
    fn serialize(&self, out: &mut mod::serde::json::Encoder) {
        out.text(&self.text);
    }
}

/// A URL is read from its text.
impl mod::serde::Deserialize for Url {
    fn deserialize(d: mod::serde::json::Decoder) -> Url with fail(mod::serde::DecodeError) {
        Url { text: d.text()? }
    }
}

impl Clone for Url {
    fn clone(&self) -> Url;
}

impl Debug for Url {
    fn fmt(&self, out: &mut String);
}

impl PartialEq for Url {
    fn eq(&self, other: &Url) -> bool;
}

/// A socket listening for connections.
pub struct Listener { handle: int }

impl Listener {
    /// The next connection.
    #[selectable]
    pub fn accept(&self) -> Conn with suspend;
}

/// A connection.
pub struct Conn { handle: int }
