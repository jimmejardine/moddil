//! HTTP (`stdlib.md`: HTTP).

use mod::net::{Conn, Net, Url};
use mod::serde::Serialize;

/// A response's status.
#[derive(Debug, Clone, PartialEq)]
pub enum Status {
    Ok,
    Created,
    PermanentRedirect,
    BadRequest,
    NotFound,
    Conflict,
}

/// A request.
pub struct Request { handle: int }

impl Request {
    pub fn get(path: String) -> Request;
    pub fn post(path: &str, body: &str) -> Request;
    pub fn body(&self) -> &str;
}

/// A response.
pub struct Response { handle: int }

impl Response {
    /// A response with `status` and no body; `r.status()` reads it (`item.impl.same-name.1`).
    pub fn status(status: Status) -> Response;
    pub fn text(status: Status, body: String) -> Response;
    pub fn json<T: Serialize>(status: Status, value: &T) -> Response;
    pub fn redirect(status: Status, to: &Url) -> Response;
    pub fn status(&self) -> Status;
    pub fn body(&self) -> &str;
}

/// How an error becomes a response.
pub trait IntoResponse {
    fn into_response(self) -> Response;
}

/// What answers requests.
pub trait Handler {
    fn handle(&self, req: &Request) -> Response with suspend;
}

/// Routes requests to handlers by method and path.
pub struct Router { handle: int }

impl Router {
    pub fn new() -> Router;
    /// Routes `POST path` to `handler`. Every error it can fail with becomes a response, so none
    /// passes on (`expr.closure.fails.2`).
    pub fn post<F: Fn(&Request) -> Response>(self, path: &str, handler: F) -> Router
    where
        F::Fails: IntoResponse;
    /// Routes `GET path` to `handler`, which takes the path's parameter.
    pub fn get<P, F: Fn(P) -> Response>(self, path: &str, handler: F) -> Router
    where
        F::Fails: IntoResponse;
}

impl Handler for Router {
    fn handle(&self, req: &Request) -> Response with suspend;
}

/// Why an HTTP exchange failed.
pub struct HttpError { reason: String }

impl Display for HttpError {
    fn fmt(&self, out: &mut String);
}

/// Serves one connection with `app`.
pub fn serve_connection<H: Handler>(conn: Conn, app: &H) with suspend, fail(HttpError);

/// Sends a `POST` of `body` to `url`, trying again up to `retries` times.
pub fn post(url: String, body: &str, retries: int) -> Response with Net, suspend, fail(HttpError);
