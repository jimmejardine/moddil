// The float functions (`num.float.fn.1`): the same bits on every machine.
impl f32 {
    #[intrinsic]
    fn sqrt(self) -> f32;
    #[intrinsic]
    fn sin(self) -> f32;
    #[intrinsic]
    fn cos(self) -> f32;
    #[intrinsic]
    fn tan(self) -> f32;
    #[intrinsic]
    fn asin(self) -> f32;
    #[intrinsic]
    fn acos(self) -> f32;
    #[intrinsic]
    fn atan(self) -> f32;
    #[intrinsic]
    fn exp(self) -> f32;
    #[intrinsic]
    fn ln(self) -> f32;
    #[intrinsic]
    fn log2(self) -> f32;
    #[intrinsic]
    fn log10(self) -> f32;
    #[intrinsic]
    fn abs(self) -> f32;
    #[intrinsic]
    fn floor(self) -> f32;
    #[intrinsic]
    fn ceil(self) -> f32;
    #[intrinsic]
    fn trunc(self) -> f32;
    #[intrinsic]
    fn atan2(self, x: f32) -> f32;
    #[intrinsic]
    fn powf(self, n: f32) -> f32;
    #[intrinsic]
    fn min(self, other: f32) -> f32;
    #[intrinsic]
    fn max(self, other: f32) -> f32;
    #[intrinsic]
    fn is_nan(self) -> bool;
    #[intrinsic]
    fn is_finite(self) -> bool;

    // `self` raised to the whole number `n`.
    fn powi(self, n: int) -> f32 {
        let mut r: f32 = 1.0;
        let mut k = if n < 0 { -n } else { n };
        while k > 0 {
            r = r * self;
            k -= 1;
        }
        if n < 0 { 1.0 / r } else { r }
    }

    // The part after the point: `self - self.trunc()`.
    fn fract(self) -> f32 {
        self - self.trunc()
    }

    // The whole number `mode` rounds `self` to, as a `T`; NaN, an infinity, or a value
    // outside `T`'s range fails with `RangeError` (`num.round.1`).
    fn round<T: Number>(self, mode: Round) -> T with fail(RangeError) {
        let t = self.trunc();
        let f = self - t;
        let away = if self < 0.0 { t - 1.0 } else { t + 1.0 };
        let r = match mode {
            Round::Down => self.floor(),
            Round::Up => self.ceil(),
            Round::TowardZero => t,
            Round::NearestAway => if f.abs() >= 0.5 { away } else { t },
            Round::NearestEven => {
                if f.abs() > 0.5 {
                    away
                } else if f.abs() < 0.5 {
                    t
                } else if (t / 2.0).fract() == 0.0 {
                    t
                } else {
                    away
                }
            }
        };
        r.to::<T>()?
    }

    // `self`, or `lo` if it is below, or `hi` if it is above.
    fn clamp(self, lo: f32, hi: f32) -> f32 {
        if self < lo {
            lo
        } else if self > hi {
            hi
        } else {
            self
        }
    }
}

// The float functions (`num.float.fn.1`): the same bits on every machine.
impl f64 {
    #[intrinsic]
    fn sqrt(self) -> f64;
    #[intrinsic]
    fn sin(self) -> f64;
    #[intrinsic]
    fn cos(self) -> f64;
    #[intrinsic]
    fn tan(self) -> f64;
    #[intrinsic]
    fn asin(self) -> f64;
    #[intrinsic]
    fn acos(self) -> f64;
    #[intrinsic]
    fn atan(self) -> f64;
    #[intrinsic]
    fn exp(self) -> f64;
    #[intrinsic]
    fn ln(self) -> f64;
    #[intrinsic]
    fn log2(self) -> f64;
    #[intrinsic]
    fn log10(self) -> f64;
    #[intrinsic]
    fn abs(self) -> f64;
    #[intrinsic]
    fn floor(self) -> f64;
    #[intrinsic]
    fn ceil(self) -> f64;
    #[intrinsic]
    fn trunc(self) -> f64;
    #[intrinsic]
    fn atan2(self, x: f64) -> f64;
    #[intrinsic]
    fn powf(self, n: f64) -> f64;
    #[intrinsic]
    fn min(self, other: f64) -> f64;
    #[intrinsic]
    fn max(self, other: f64) -> f64;
    #[intrinsic]
    fn is_nan(self) -> bool;
    #[intrinsic]
    fn is_finite(self) -> bool;

    // `self` raised to the whole number `n`.
    fn powi(self, n: int) -> f64 {
        let mut r: f64 = 1.0;
        let mut k = if n < 0 { -n } else { n };
        while k > 0 {
            r = r * self;
            k -= 1;
        }
        if n < 0 { 1.0 / r } else { r }
    }

    // The part after the point: `self - self.trunc()`.
    fn fract(self) -> f64 {
        self - self.trunc()
    }

    // The whole number `mode` rounds `self` to, as a `T`; NaN, an infinity, or a value
    // outside `T`'s range fails with `RangeError` (`num.round.1`).
    fn round<T: Number>(self, mode: Round) -> T with fail(RangeError) {
        let t = self.trunc();
        let f = self - t;
        let away = if self < 0.0 { t - 1.0 } else { t + 1.0 };
        let r = match mode {
            Round::Down => self.floor(),
            Round::Up => self.ceil(),
            Round::TowardZero => t,
            Round::NearestAway => if f.abs() >= 0.5 { away } else { t },
            Round::NearestEven => {
                if f.abs() > 0.5 {
                    away
                } else if f.abs() < 0.5 {
                    t
                } else if (t / 2.0).fract() == 0.0 {
                    t
                } else {
                    away
                }
            }
        };
        r.to::<T>()?
    }

    // `self`, or `lo` if it is below, or `hi` if it is above.
    fn clamp(self, lo: f64, hi: f64) -> f64 {
        if self < lo {
            lo
        } else if self > hi {
            hi
        } else {
            self
        }
    }
}

// `bool`: `false` orders before `true`.

impl Clone for bool {
    fn clone(&self) -> bool {
        *self
    }
}

impl Copy for bool {}

impl PartialEq for bool {
    fn eq(&self, other: &bool) -> bool {
        *self == *other
    }
}

impl Eq for bool {}

impl PartialOrd for bool {
    fn partial_cmp(&self, other: &bool) -> Option<Ordering> {
        Some(self.cmp(other))
    }
}

impl Ord for bool {
    fn cmp(&self, other: &bool) -> Ordering {
        if *self == *other {
            Ordering::Equal
        } else if *other {
            Ordering::Less
        } else {
            Ordering::Greater
        }
    }
}

impl Not for bool {
    type Output = bool;
    fn not(self) -> bool {
        !self
    }
}

// `()`.

impl Clone for () {
    fn clone(&self) -> () {
        ()
    }
}

impl Copy for () {}

impl PartialEq for () {
    fn eq(&self, other: &()) -> bool {
        true
    }
}

impl Eq for () {}

// Text: `char`, `str` and `String`. Their methods marked `#[intrinsic]` are built in.

// How a value is written as text: in `fmt"…"`'s holes, and by `to_string`.
trait Display {
    fn fmt(&self, out: &mut String);

    fn to_string(&self) -> String {
        let mut s = String::new();
        self.fmt(&mut s);
        s
    }
}

impl Display for int {
    fn fmt(&self, out: &mut String) {
        out.push_str(self.text());
    }
}

impl Display for bool {
    fn fmt(&self, out: &mut String) {
        out.push_str(self.text());
    }
}

impl bool {
    // `true` or `false`.
    #[intrinsic]
    fn text(&self) -> &str;
}

impl Display for char {
    fn fmt(&self, out: &mut String) {
        out.push_str(self.text());
    }
}

impl Display for str {
    fn fmt(&self, out: &mut String) {
        out.push_str(self);
    }
}

impl Display for String {
    fn fmt(&self, out: &mut String) {
        out.push_str(self.as_str());
    }
}

impl char {
    // The code point, and the `char` of one (`None` for a surrogate or past U+10FFFF).
    #[intrinsic]
    fn code(self) -> int;
    #[intrinsic]
    fn from_code(n: int) -> Option<char>;
    #[intrinsic]
    fn is_alphabetic(self) -> bool;
    #[intrinsic]
    fn is_numeric(self) -> bool;
    #[intrinsic]
    fn is_whitespace(self) -> bool;
    #[intrinsic]
    fn is_uppercase(self) -> bool;
    #[intrinsic]
    fn is_lowercase(self) -> bool;
    // How many bytes it takes in UTF-8.
    #[intrinsic]
    fn len_utf8(self) -> int;
}

impl Clone for char {
    fn clone(&self) -> char {
        *self
    }
}

impl Copy for char {}

impl PartialEq for char {
    fn eq(&self, other: &char) -> bool {
        *self == *other
    }
}

impl Eq for char {}

impl PartialOrd for char {
    fn partial_cmp(&self, other: &char) -> Option<Ordering> {
        Some(self.cmp(other))
    }
}

impl Ord for char {
    fn cmp(&self, other: &char) -> Ordering {
        if *self < *other {
            Ordering::Less
        } else if *self == *other {
            Ordering::Equal
        } else {
            Ordering::Greater
        }
    }
}

impl str {
    // Its length in bytes.
    #[intrinsic]
    fn len(&self) -> int;

    fn is_empty(&self) -> bool {
        self.len() == 0
    }

    // Its `i`th byte; traps if there is none.
    #[intrinsic]
    fn byte_at(&self, i: int) -> u8;

    // The first `len` bytes of `bytes`, which are UTF-8, as text (`text.string.inline.1`).
    #[intrinsic]
    fn view(bytes: &[u8], len: int) -> &str;

    // Whether `part`'s bytes are at byte `at`.
    fn has_at<P: Pattern>(&self, part: &P, at: int) -> bool {
        let n = part.pattern_len();
        if at < 0 || at + n > self.len() {
            return false;
        }
        let mut i = 0;
        while i < n {
            if self.byte_at(at + i) != part.pattern_byte(i) {
                return false;
            }
            i += 1;
        }
        true
    }

    fn starts_with<P: Pattern>(&self, prefix: P) -> bool {
        self.has_at(&prefix, 0)
    }

    fn ends_with<P: Pattern>(&self, suffix: P) -> bool {
        let at = self.len() - suffix.pattern_len();
        self.has_at(&suffix, at)
    }

    fn contains<P: Pattern>(&self, part: P) -> bool {
        let mut at = 0;
        while at + part.pattern_len() <= self.len() {
            if self.has_at(&part, at) {
                return true;
            }
            at += 1;
        }
        false
    }

    // Without the white space at its ends.
    #[intrinsic]
    fn trim(&self) -> &str;

    // Unicode's case mappings, which need its tables.
    #[intrinsic]
    fn upper_text(&self) -> &str;
    #[intrinsic]
    fn lower_text(&self) -> &str;

    fn to_uppercase(&self) -> String {
        String::from_str(self.upper_text())
    }

    fn to_lowercase(&self) -> String {
        String::from_str(self.lower_text())
    }
}

impl PartialEq for str {
    #[intrinsic]
    fn eq(&self, other: &str) -> bool;
}

impl Eq for str {}

impl PartialOrd for str {
    fn partial_cmp(&self, other: &str) -> Option<Ordering> {
        Some(self.cmp(other))
    }
}

// Byte by byte, which for UTF-8 is by code point.
impl Ord for str {
    #[intrinsic]
    fn cmp(&self, other: &str) -> Ordering;
}

// `String` (`text.string.1`): owned, growable UTF-8, over `u8` bytes in the small-string form
// (`text.string.inline.1`): up to 23 bytes inside the `String` itself, more in a heap buffer.
struct String {
    repr: StringRepr,
}

// Where a `String`'s bytes are: inline, with how many there are, or in a heap buffer.
enum StringRepr {
    Inline([u8; 23], u8),
    Heap(Buf<u8>),
}

impl String {
    fn new() -> String {
        String {
            repr: StringRepr::Inline([0; 23], 0),
        }
    }

    // Room for `capacity` bytes: on the heap if that is more than fit inline.
    fn with_capacity(capacity: int) -> String {
        if capacity <= 23 {
            String::new()
        } else {
            String {
                repr: StringRepr::Heap(Buf::with_capacity(capacity)),
            }
        }
    }

    // A `String` of the text `s`.
    fn from_str(s: &str) -> String {
        let mut out = String::with_capacity(s.len());
        out.push_str(s);
        out
    }

    // How many bytes it can hold before it grows: never fewer than the 23 inline.
    fn capacity(&self) -> int {
        match &self.repr {
            StringRepr::Inline(_, _) => 23,
            StringRepr::Heap(b) => b.capacity(),
        }
    }

    // Its length in bytes.
    fn len(&self) -> int {
        match &self.repr {
            StringRepr::Inline(_, n) => {
                let k: int = *n;
                k
            }
            StringRepr::Heap(b) => b.len(),
        }
    }

    // Its `i`th byte.
    fn byte(&self, i: int) -> u8 {
        match &self.repr {
            StringRepr::Inline(bytes, _) => bytes[i],
            StringRepr::Heap(b) => b.as_slice()[i],
        }
    }

    fn as_str(&self) -> &str {
        match &self.repr {
            StringRepr::Inline(bytes, n) => {
                let k: int = *n;
                str::view(bytes, k)
            }
            StringRepr::Heap(b) => str::view(b.as_slice(), b.len()),
        }
    }

    // Adds byte `b` at the end; when the inline room is full the bytes move to the heap, and a
    // full heap buffer doubles.
    fn push_byte(&mut self, b: u8) {
        match &mut self.repr {
            StringRepr::Inline(bytes, n) => {
                let k: int = *n;
                if k < 23 {
                    bytes[k] = b;
                    *n = *n + 1;
                    return;
                }
            }
            StringRepr::Heap(buf) => {
                if buf.len() == buf.capacity() {
                    buf.set_capacity(buf.capacity() * 2);
                }
                buf.push(b);
                return;
            }
        }
        let mut buf: Buf<u8> = Buf::with_capacity(46);
        let mut i = 0;
        while i < 23 {
            buf.push(self.byte(i));
            i += 1;
        }
        buf.push(b);
        self.repr = StringRepr::Heap(buf);
    }

    fn push_str(&mut self, s: &str) {
        let mut i = 0;
        while i < s.len() {
            self.push_byte(s.byte_at(i));
            i += 1;
        }
    }

    // Adds `c`, encoded as UTF-8: one to four bytes.
    fn push(&mut self, c: char) {
        let n = c.len_utf8();
        let mut i = 0;
        while i < n {
            self.push_byte(utf8_byte(c, i));
            i += 1;
        }
    }

    // Takes off its last character.
    fn pop(&mut self) -> Option<char> {
        let n = self.len();
        if n == 0 {
            return None;
        }
        // Back over the continuation bytes (`10xxxxxx`) to where the character starts.
        let mut start = n - 1;
        while start > 0 && self.byte(start) & 0xC0 == 0x80 {
            start -= 1;
        }
        let c = self.as_str().char_at_byte(start);
        self.cut(start);
        c
    }

    // Keeps its first `len` bytes.
    fn cut(&mut self, len: int) {
        match &mut self.repr {
            StringRepr::Inline(_, n) => {
                *n = len.truncate::<u8>();
            }
            StringRepr::Heap(buf) => {
                while buf.len() > len {
                    buf.pop();
                }
            }
        }
    }

    fn clear(&mut self) {
        self.cut(0);
    }

    fn is_empty(&self) -> bool {
        self.len() == 0
    }

    fn starts_with<P: Pattern>(&self, prefix: P) -> bool {
        self.as_str().starts_with(prefix)
    }

    fn ends_with<P: Pattern>(&self, suffix: P) -> bool {
        self.as_str().ends_with(suffix)
    }

    fn contains<P: Pattern>(&self, part: P) -> bool {
        self.as_str().contains(part)
    }

    fn trim(&self) -> &str {
        self.as_str().trim()
    }

    fn to_uppercase(&self) -> String {
        self.as_str().to_uppercase()
    }

    fn to_lowercase(&self) -> String {
        self.as_str().to_lowercase()
    }
}

impl FromIterator<char> for String {
    fn from_iter<I: Iterator<Item = char>>(iter: I) -> String with fail(I::Fails) {
        let mut s = String::new();
        let mut it = iter;
        while let Some(c) = it.next() {
            s.push(c);
        }
        s
    }
}

// What `contains`, `starts_with` and `ends_with` look for (`text.pattern.1`): a string or a
// character.
trait Pattern {
    // How many bytes it is.
    fn pattern_len(&self) -> int;
    // Its `i`th byte.
    fn pattern_byte(&self, i: int) -> u8;
}

impl Pattern for &str {
    fn pattern_len(&self) -> int {
        self.len()
    }
    fn pattern_byte(&self, i: int) -> u8 {
        self.byte_at(i)
    }
}

impl Pattern for &String {
    fn pattern_len(&self) -> int {
        self.len()
    }
    fn pattern_byte(&self, i: int) -> u8 {
        self.byte(i)
    }
}

impl Pattern for char {
    fn pattern_len(&self) -> int {
        self.len_utf8()
    }
    fn pattern_byte(&self, i: int) -> u8 {
        utf8_byte(*self, i)
    }
}

impl Clone for String {
    fn clone(&self) -> String {
        String::from_str(self.as_str())
    }
}

// Byte `i` of `c`'s UTF-8 encoding.
fn utf8_byte(c: char, i: int) -> u8 {
    let code = c.code();
    let n = c.len_utf8();
    if n == 1 {
        return code.truncate::<u8>();
    }
    // The first byte holds the length and the top bits; each other byte six bits.
    let shift = 6 * (n - 1 - i);
    if i == 0 {
        let lead = match n {
            2 => 0xC0,
            3 => 0xE0,
            _ => 0xF0,
        };
        (lead | (code >> shift)).truncate::<u8>()
    } else {
        (0x80 | ((code >> shift) & 0x3F)).truncate::<u8>()
    }
}

impl PartialEq for String {
    fn eq(&self, other: &String) -> bool {
        self.as_str() == other.as_str()
    }
}

impl Eq for String {}

impl PartialOrd for String {
    fn partial_cmp(&self, other: &String) -> Option<Ordering> {
        Some(self.cmp(other))
    }
}

impl Ord for String {
    fn cmp(&self, other: &String) -> Ordering {
        self.as_str().cmp(other.as_str())
    }
}

// Arrays and slices.

impl<T> [T] {
    // How many elements it has.
    #[intrinsic]
    fn len(&self) -> int;

    fn is_empty(&self) -> bool {
        self.len() == 0
    }
}

impl<T, const N: int> [T; N] {
    fn len(&self) -> int {
        N
    }

    fn is_empty(&self) -> bool {
        N == 0
    }

    fn as_slice(&self) -> &[T] {
        self
    }
}

impl<T: PartialEq> PartialEq for [T] {
    fn eq(&self, other: &[T]) -> bool {
        if self.len() != other.len() {
            return false;
        }
        let mut i = 0;
        while i < self.len() {
            if self[i] != other[i] {
                return false;
            }
            i += 1;
        }
        true
    }
}

impl<T: Eq> Eq for [T] {}

impl<T: PartialEq, const N: int> PartialEq for [T; N] {
    fn eq(&self, other: &[T; N]) -> bool {
        self.as_slice() == other.as_slice()
    }
}

impl<T: Eq, const N: int> Eq for [T; N] {}

// What `main` can give back (`main.exit.1`): each `sysexits.h` code by name, or another.
#[derive(Debug, Clone, PartialEq)]
enum ExitCode {
    Ok,
    Usage,
    DataErr,
    NoInput,
    NoUser,
    NoHost,
    Unavailable,
    Software,
    OsErr,
    OsFile,
    CantCreate,
    IoErr,
    TempFail,
    Protocol,
    NoPerm,
    Config,
    Other(int),
}

impl ExitCode {
    // The exit code `n`, by its name if it has one.
    fn new(n: int) -> ExitCode {
        match n {
            0 => ExitCode::Ok,
            64 => ExitCode::Usage,
            65 => ExitCode::DataErr,
            66 => ExitCode::NoInput,
            67 => ExitCode::NoUser,
            68 => ExitCode::NoHost,
            69 => ExitCode::Unavailable,
            70 => ExitCode::Software,
            71 => ExitCode::OsErr,
            72 => ExitCode::OsFile,
            73 => ExitCode::CantCreate,
            74 => ExitCode::IoErr,
            75 => ExitCode::TempFail,
            76 => ExitCode::Protocol,
            77 => ExitCode::NoPerm,
            78 => ExitCode::Config,
            n => ExitCode::Other(n),
        }
    }

    // The number the process exits with.
    fn code(&self) -> int {
        match self {
            ExitCode::Ok => 0,
            ExitCode::Usage => 64,
            ExitCode::DataErr => 65,
            ExitCode::NoInput => 66,
            ExitCode::NoUser => 67,
            ExitCode::NoHost => 68,
            ExitCode::Unavailable => 69,
            ExitCode::Software => 70,
            ExitCode::OsErr => 71,
            ExitCode::OsFile => 72,
            ExitCode::CantCreate => 73,
            ExitCode::IoErr => 74,
            ExitCode::TempFail => 75,
            ExitCode::Protocol => 76,
            ExitCode::NoPerm => 77,
            ExitCode::Config => 78,
            ExitCode::Other(n) => *n,
        }
    }
}

// The ambient log (`obs.log.1`): write-only, so it needs no effect. For now the interpreters
// print its events to standard error, with their level.
struct Log;

impl Log {
    #[intrinsic]
    fn debug(&self, msg: String);
    #[intrinsic]
    fn info(&self, msg: String);
    #[intrinsic]
    fn warn(&self, msg: String);
    #[intrinsic]
    fn error(&self, msg: String);
}

const log: Log = Log;

// Iteration (`expr.for.1`): `for p in e` calls `IntoIterator::into_iter(e)`, then `next` until
// it gives `None`.

trait Iterator {
    type Item;
    // What `next` can fail with (`iter.fails.1`): nothing, unless the impl says.
    type Fails = !;
    fn next(&mut self) -> Option<Self::Item> with fail(Self::Fails);

    // Whether `f` holds for every item left, stopping at the first it does not hold for.
    fn all(self, f: impl FnMut(Self::Item) -> bool) -> bool with fail(Self::Fails) {
        let mut it = self;
        while let Some(x) = it.next() {
            if !f(x) {
                return false;
            }
        }
        true
    }

    // Whether `f` holds for some item left, stopping at the first it holds for.
    fn any(self, f: impl FnMut(Self::Item) -> bool) -> bool with fail(Self::Fails) {
        let mut it = self;
        while let Some(x) = it.next() {
            if f(x) {
                return true;
            }
        }
        false
    }

    // How many items are left, using them up.
    fn count(self) -> int with fail(Self::Fails) {
        let mut it = self;
        let mut n = 0;
        while let Some(_) = it.next() {
            n += 1;
        }
        n
    }

    // The items, each passed through `f` as it is asked for (`iter.adapt.1`): `f` runs in
    // `next`, so its errors are the adapter's, not `map`'s, which names them (`E`) to say so.
    fn map<B, F: FnMut(Self::Item) -> B with E, E>(self, f: F) -> Map<Self, F> {
        Map { iter: self, f }
    }

    // The items `f` holds for, each found as it is asked for.
    fn filter<F: FnMut(&Self::Item) -> bool with E, E>(self, f: F) -> Filter<Self, F> {
        Filter { iter: self, f }
    }

    // The items left, gathered into a collection of the type the context names
    // (`iter.collect.1`).
    fn collect<C: FromIterator<Self::Item>>(self) -> C with fail(Self::Fails) {
        C::from_iter(self)
    }
}

// `it.map(f)` (`iter.adapt.1`): it holds the closure, so it is a view of what that borrows.
struct Map<I, F> {
    iter: I,
    f: F,
}

impl<I: Iterator, B, F: FnMut(I::Item) -> B> Iterator for Map<I, F> {
    type Item = B;
    type Fails = I::Fails | F::Fails;
    fn next(&mut self) -> Option<B> with fail(I::Fails | F::Fails) {
        match self.iter.next() {
            Some(x) => Some((self.f)(x)),
            None => None,
        }
    }
}

// `it.filter(f)` (`iter.adapt.1`).
struct Filter<I, F> {
    iter: I,
    f: F,
}

impl<I: Iterator, F: FnMut(&I::Item) -> bool> Iterator for Filter<I, F> {
    type Item = I::Item;
    type Fails = I::Fails | F::Fails;
    fn next(&mut self) -> Option<I::Item> with fail(I::Fails | F::Fails) {
        while let Some(x) = self.iter.next() {
            if (self.f)(&x) {
                return Some(x);
            }
        }
        None
    }
}

// A collection that can be made from the items of an iterator (`iter.collect.1`); it fails as
// the iterator does.
trait FromIterator<A> {
    fn from_iter<I: Iterator<Item = A>>(iter: I) -> Self with fail(I::Fails);
}

trait IntoIterator {
    type Item;
    type IntoIter;
    fn into_iter(self) -> Self::IntoIter;
}

// An iterator is one itself.
impl<I: Iterator> IntoIterator for I {
    type Item = <I as Iterator>::Item;
    type IntoIter = I;
    fn into_iter(self) -> I {
        self
    }
}

// `a..b`: the integers from `a` up to but not including `b`.
struct Range {
    start: int,
    end: int,
}

impl Iterator for Range {
    type Item = int;
    fn next(&mut self) -> Option<int> {
        if self.start < self.end {
            let x = self.start;
            self.start = x + 1;
            Some(x)
        } else {
            None
        }
    }
}

// `a..=b`: the integers from `a` to `b`, both included.
struct RangeInclusive {
    start: int,
    end: int,
    done: bool,
}

impl Iterator for RangeInclusive {
    type Item = int;
    fn next(&mut self) -> Option<int> {
        if self.done || self.start > self.end {
            return None;
        }
        let x = self.start;
        if x == self.end {
            self.done = true;
        } else {
            self.start = x + 1;
        }
        Some(x)
    }
}

// `a..`: the integers from `a` on.
struct RangeFrom {
    start: int,
}

impl Iterator for RangeFrom {
    type Item = int;
    fn next(&mut self) -> Option<int> {
        let x = self.start;
        self.start = x + 1;
        Some(x)
    }
}

// The elements of a slice, borrowed in order.
view Iter<T> {
    slice: &[T],
    pos: int,
}

impl<T> Iterator for Iter<T> {
    type Item = &T;
    fn next(&mut self) -> Option<&T> {
        if self.pos < self.slice.len() {
            let x = &self.slice[self.pos];
            self.pos += 1;
            Some(x)
        } else {
            None
        }
    }
}

impl<T> [T] {
    fn iter(&self) -> Iter<T> {
        Iter { slice: self, pos: 0 }
    }

    // The elements before `at` and from `at` on (`expr.slice.1`); traps if `at` is past the end.
    fn split_at(&self, at: int) -> (&[T], &[T]) {
        (&self[..at], &self[at..])
    }

    // As `split_at`, each part borrowed with `&mut`.
    fn split_at_mut(&mut self, at: int) -> (&mut [T], &mut [T]) {
        let n = self.len();
        let (a, b) = self.split_at_mut_unchecked(at, n);
        (a, b)
    }

    // The two parts, disjoint, of an `&mut` borrow (`expr.slice.1`).
    #[intrinsic]
    fn split_at_mut_unchecked(&mut self, at: int, len: int) -> (&mut [T], &mut [T]);
}

impl<T, const N: int> [T; N] {
    fn iter(&self) -> Iter<T> {
        Iter { slice: self, pos: 0 }
    }

    fn split_at(&self, at: int) -> (&[T], &[T]) {
        (&self[..at], &self[at..])
    }

    fn split_at_mut(&mut self, at: int) -> (&mut [T], &mut [T]) {
        let all: &mut [T] = &mut self[..];
        all.split_at_mut(at)
    }
}

impl<T> IntoIterator for &[T] {
    type Item = &T;
    type IntoIter = Iter<T>;
    fn into_iter(self) -> Iter<T> {
        self.iter()
    }
}

impl<T, const N: int> IntoIterator for &[T; N] {
    type Item = &T;
    type IntoIter = Iter<T>;
    fn into_iter(self) -> Iter<T> {
        self.iter()
    }
}

// An array's elements, by value: they move into a buffer that gives them out in order.
impl<T, const N: int> IntoIterator for [T; N] {
    type Item = T;
    type IntoIter = IntoIter<T>;
    fn into_iter(self) -> IntoIter<T> {
        IntoIter { buf: Buf::from_array(self) }
    }
}

// Indexing: `xs[i]` on a type other than an array or slice is `*xs.index(i)`, or
// `*xs.index_mut(i)` where the element is changed.

trait Index {
    type Output;
    fn index(&self, i: int) -> &Self::Output;
}

trait IndexMut: Index {
    fn index_mut(&mut self, i: int) -> &mut Self::Output;
}

// Dereferencing (`type.box.1`): `*x` on a type other than a borrow is `*x.deref()`, or
// `*x.deref_mut()` where the value is changed.

trait Deref {
    type Output;
    fn deref(&self) -> &Self::Output;
}

trait DerefMut: Deref {
    fn deref_mut(&mut self) -> &mut Self::Output;
}

// `Box<T>`: one value kept on the heap, owned (`type.box.1`); `Box<dyn Trait>` owns a value of
// any type that implements the trait (`type.box.dyn.1`). Its value is dropped with it.
struct Box<T> {
    buf: Buf<T>,
}

impl<T> Box<T> {
    fn new(x: T) -> Box<T> {
        let mut buf = Buf::with_capacity(1);
        buf.push(x);
        Box { buf }
    }

    // Its value, out of the box.
    fn into_inner(self) -> T {
        let mut buf = self.buf;
        buf.pop() ?! "a box holds its value"
    }
}

impl<T> Deref for Box<T> {
    type Output = T;
    fn deref(&self) -> &T {
        &self.buf.as_slice()[0]
    }
}

impl<T> DerefMut for Box<T> {
    fn deref_mut(&mut self) -> &mut T {
        &mut self.buf.as_mut_slice()[0]
    }
}

// Collection literals (`expr.array.from.1`): `[a, b]` and `[x; n]` make the type the context
// expects, if it implements this.
trait FromArrayLiteral<T> {
    fn from_array<const N: int>(items: [T; N]) -> Self;
    fn from_repeat(x: T, n: int) -> Self where T: Clone;
}

// `Buf<T>`: built-in storage with a fixed capacity, of which a prefix holds elements. `Vec` is
// written over it. Its elements are dropped with it, first to last.
impl<T> Buf<T> {
    // An empty buffer with room for `capacity` elements.
    #[intrinsic]
    fn with_capacity(capacity: int) -> Buf<T>;
    // A full buffer of the array's elements.
    #[intrinsic]
    fn from_array<const N: int>(items: [T; N]) -> Buf<T>;
    #[intrinsic]
    fn len(&self) -> int;
    #[intrinsic]
    fn capacity(&self) -> int;
    // Changes its capacity: to its length if given less.
    #[intrinsic]
    fn set_capacity(&mut self, capacity: int);
    // Adds `x` at the end; traps if it is full.
    #[intrinsic]
    fn push(&mut self, x: T);
    #[intrinsic]
    fn pop(&mut self) -> Option<T>;
    // Puts `x` at `i`, moving the elements from `i` on along; traps if it is full or `i` is past
    // the end.
    #[intrinsic]
    fn insert(&mut self, i: int, x: T);
    // Takes out the element at `i`, moving those after it back; traps if there is none.
    #[intrinsic]
    fn remove(&mut self, i: int) -> T;
    #[intrinsic]
    fn swap(&mut self, i: int, j: int);
    #[intrinsic]
    fn as_slice(&self) -> &[T];
    #[intrinsic]
    fn as_mut_slice(&mut self) -> &mut [T];
}

// `Vec<T>`: a growable array, written over `Buf`.
struct Vec<T> {
    buf: Buf<T>,
}

impl<T> Vec<T> {
    fn new() -> Vec<T> {
        Vec { buf: Buf::with_capacity(0) }
    }

    fn with_capacity(capacity: int) -> Vec<T> {
        Vec { buf: Buf::with_capacity(capacity) }
    }

    fn len(&self) -> int {
        self.buf.len()
    }

    fn is_empty(&self) -> bool {
        self.buf.len() == 0
    }

    fn capacity(&self) -> int {
        self.buf.capacity()
    }

    // Makes room for `extra` more elements.
    fn reserve(&mut self, extra: int) {
        let want = self.buf.len() + extra;
        if want > self.buf.capacity() {
            let mut cap = self.buf.capacity() * 2;
            if cap < want {
                cap = want;
            }
            self.buf.set_capacity(cap);
        }
    }

    fn push(&mut self, x: T) {
        if self.buf.len() == self.buf.capacity() {
            self.reserve(1);
        }
        self.buf.push(x);
    }

    fn pop(&mut self) -> Option<T> {
        self.buf.pop()
    }

    #[track_caller]
    fn insert(&mut self, i: int, x: T) {
        if self.buf.len() == self.buf.capacity() {
            self.reserve(1);
        }
        self.buf.insert(i, x);
    }

    #[track_caller]
    fn remove(&mut self, i: int) -> T {
        self.buf.remove(i)
    }

    #[track_caller]
    fn swap(&mut self, i: int, j: int) {
        self.buf.swap(i, j);
    }

    // Drops the elements from `len` on.
    fn truncate(&mut self, len: int) {
        while self.buf.len() > len {
            self.buf.pop();
        }
    }

    fn clear(&mut self) {
        self.truncate(0);
    }

    fn get(&self, i: int) -> Option<&T> {
        if 0 <= i && i < self.buf.len() {
            Some(&self.buf.as_slice()[i])
        } else {
            None
        }
    }

    fn get_mut(&mut self, i: int) -> Option<&mut T> {
        if 0 <= i && i < self.buf.len() {
            Some(&mut self.buf.as_mut_slice()[i])
        } else {
            None
        }
    }

    fn first(&self) -> Option<&T> {
        self.get(0)
    }

    fn last(&self) -> Option<&T> {
        self.get(self.buf.len() - 1)
    }

    fn as_slice(&self) -> &[T] {
        self.buf.as_slice()
    }

    fn as_mut_slice(&mut self) -> &mut [T] {
        self.buf.as_mut_slice()
    }

    fn iter(&self) -> Iter<T> {
        self.buf.as_slice().iter()
    }
}

impl<T: PartialEq> Vec<T> {
    fn contains(&self, x: &T) -> bool {
        for y in self.as_slice() {
            if *y == *x {
                return true;
            }
        }
        false
    }
}

impl<T> Index for Vec<T> {
    type Output = T;
    #[track_caller]
    fn index(&self, i: int) -> &T {
        &self.buf.as_slice()[i]
    }
}

impl<T> IndexMut for Vec<T> {
    #[track_caller]
    fn index_mut(&mut self, i: int) -> &mut T {
        &mut self.buf.as_mut_slice()[i]
    }
}

impl<T> FromArrayLiteral<T> for Vec<T> {
    fn from_array<const N: int>(items: [T; N]) -> Vec<T> {
        Vec { buf: Buf::from_array(items) }
    }

    fn from_repeat(x: T, n: int) -> Vec<T> where T: Clone {
        let mut v = Vec::with_capacity(n);
        if n > 0 {
            let mut i = 1;
            while i < n {
                v.push(x.clone());
                i += 1;
            }
            v.push(x);
        }
        v
    }
}

impl<T> FromIterator<T> for Vec<T> {
    fn from_iter<I: Iterator<Item = T>>(iter: I) -> Vec<T> with fail(I::Fails) {
        let mut v = Vec::new();
        let mut it = iter;
        while let Some(x) = it.next() {
            v.push(x);
        }
        v
    }
}

impl<T: Clone> Clone for Vec<T> {
    fn clone(&self) -> Vec<T> {
        let mut v = Vec::with_capacity(self.len());
        for x in self.as_slice() {
            v.push(x.clone());
        }
        v
    }
}

impl<T: PartialEq> PartialEq for Vec<T> {
    fn eq(&self, other: &Vec<T>) -> bool {
        self.as_slice() == other.as_slice()
    }
}

impl<T: Eq> Eq for Vec<T> {}

impl<T> IntoIterator for &Vec<T> {
    type Item = &T;
    type IntoIter = Iter<T>;
    fn into_iter(self) -> Iter<T> {
        self.iter()
    }
}

// A `Vec`'s elements, by value: it is used up.
struct IntoIter<T> {
    buf: Buf<T>,
}

impl<T> Iterator for IntoIter<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        if self.buf.len() == 0 {
            None
        } else {
            Some(self.buf.remove(0))
        }
    }
}

impl<T> IntoIterator for Vec<T> {
    type Item = T;
    type IntoIter = IntoIter<T>;
    fn into_iter(self) -> IntoIter<T> {
        IntoIter { buf: self.buf }
    }
}

// `replace` puts `value` where `dest` points and gives back what was there; `swap` exchanges two
// values. Both are built in.
#[intrinsic]
fn replace<T>(dest: &mut T, value: T) -> T;

#[intrinsic]
fn swap<T>(a: &mut T, b: &mut T);

// Wrapping arithmetic on the bits of an `int`, until the wrapping operators (slice S10).
impl int {
    #[intrinsic]
    fn wrapping_add(self, other: int) -> int;
    #[intrinsic]
    fn wrapping_sub(self, other: int) -> int;
    #[intrinsic]
    fn wrapping_mul(self, other: int) -> int;
    // The 64 bits rotated left by `n` places (taken modulo 64).
    #[intrinsic]
    fn rotate_left(self, n: int) -> int;
}

// Hashing (`coll.hash.1`): a type says what it hashes, a `Hasher` how.
trait Hasher {
    fn write_int(&mut self, x: int);
    fn finish(&self) -> int;
}

trait Hash {
    fn hash<H: Hasher>(&self, state: &mut H);
}

impl Hash for int {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_int(*self);
    }
}

// The sized integers hash their value (`coll.hash.1`): the 128-bit ones as two `int`s.
impl Hash for i8 {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_int(self.wrap::<int>());
    }
}

impl Hash for i16 {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_int(self.wrap::<int>());
    }
}

impl Hash for i32 {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_int(self.wrap::<int>());
    }
}

impl Hash for u8 {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_int(self.wrap::<int>());
    }
}

impl Hash for u16 {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_int(self.wrap::<int>());
    }
}

impl Hash for u32 {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_int(self.wrap::<int>());
    }
}

impl Hash for u64 {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_int(self.wrap::<int>());
    }
}

impl Hash for i128 {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_int(self.truncate::<int>());
        state.write_int((*self >> 64).truncate::<int>());
    }
}

impl Hash for u128 {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_int(self.truncate::<int>());
        state.write_int((*self >> 64).truncate::<int>());
    }
}

impl Hash for bool {
    fn hash<H: Hasher>(&self, state: &mut H) {
        if *self {
            state.write_int(1);
        } else {
            state.write_int(0);
        }
    }
}

impl Hash for char {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_int(self.code());
    }
}

impl Hash for str {
    fn hash<H: Hasher>(&self, state: &mut H) {
        for c in self.chars() {
            state.write_int(c.code());
        }
        state.write_int(self.len());
    }
}

impl Hash for String {
    fn hash<H: Hasher>(&self, state: &mut H) {
        self.as_str().hash(state);
    }
}

impl<T: Hash> Hash for [T] {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_int(self.len());
        for x in self {
            x.hash(state);
        }
    }
}

impl<T: Hash> Hash for Vec<T> {
    fn hash<H: Hasher>(&self, state: &mut H) {
        self.as_slice().hash(state);
    }
}

impl<T: Hash> Hash for Option<T> {
    fn hash<H: Hasher>(&self, state: &mut H) {
        match self {
            None => state.write_int(0),
            Some(x) => {
                state.write_int(1);
                x.hash(state);
            }
        }
    }
}

impl<A: Hash, B: Hash> Hash for (A, B) {
    fn hash<H: Hasher>(&self, state: &mut H) {
        self.0.hash(state);
        self.1.hash(state);
    }
}

// A string's characters, in order.
view Chars {
    text: &str,
    at: int,
}

impl Iterator for Chars {
    type Item = char;
    fn next(&mut self) -> Option<char> {
        match self.text.char_at_byte(self.at) {
            Some(c) => {
                self.at += c.len_utf8();
                Some(c)
            }
            None => None,
        }
    }
}

// A position in text (`text.pos.1`): a byte offset on a character boundary of the text it was
// found in, which it borrows, so the text cannot change while it is live. Slicing other text with
// it traps, for now.
view StrPos {
    text: &str,
    at: int,
}

impl Clone for StrPos {
    fn clone(&self) -> StrPos {
        *self
    }
}

impl Copy for StrPos {}

impl StrPos {
    // Its byte offset in its text.
    fn offset(self) -> int {
        self.at
    }

    // The position just past `part`, which is at this one; traps if it is not.
    fn after<P: Pattern>(self, part: P) -> StrPos {
        assert(self.text.has_at(&part, self.at));
        StrPos { text: self.text, at: self.at + part.pattern_len() }
    }
}

// A byte offset that is not a character boundary of the text, or is past its end (`text.pos.1`).
struct NotABoundary {
    offset: int,
}

impl str {
    // Where the text starts, and where it ends (`text.pos.1`).
    fn start(&self) -> StrPos {
        StrPos { text: self, at: 0 }
    }

    fn end(&self) -> StrPos {
        StrPos { text: self, at: self.len() }
    }

    // Where `part` first is, if it is (`text.find.1`).
    fn find<P: Pattern>(&self, part: P) -> Option<StrPos> {
        let mut at = 0;
        while at + part.pattern_len() <= self.len() {
            if self.has_at(&part, at) {
                return Some(StrPos { text: self, at });
            }
            at += 1;
        }
        None
    }

    // Where `part` last is, if it is.
    fn rfind<P: Pattern>(&self, part: P) -> Option<StrPos> {
        let mut at = self.len() - part.pattern_len();
        while at >= 0 {
            if self.has_at(&part, at) {
                return Some(StrPos { text: self, at });
            }
            at -= 1;
        }
        None
    }

    // The text before the first `part`, and the text after it, if it is there.
    fn split_once<P: Pattern>(&self, part: P) -> Option<(&str, &str)> {
        let n = part.pattern_len();
        match self.find(part) {
            Some(at) => Some((
                self.bytes_between(0, at.at),
                self.bytes_between(at.at + n, self.len()),
            )),
            None => None,
        }
    }

    // Whether byte `offset` is a character boundary: the start of a character, or the end.
    fn is_boundary(&self, offset: int) -> bool {
        if offset == self.len() {
            return true;
        }
        offset >= 0 && offset < self.len() && (self.byte_at(offset) & 0xC0) != 0x80
    }

    // The position at byte `offset`, an offset that came from outside (`text.pos.1`).
    fn pos_at(&self, offset: int) -> StrPos with fail(NotABoundary) {
        if !self.is_boundary(offset) {
            fail(NotABoundary { offset });
        }
        StrPos { text: self, at: offset }
    }

    // The text between two byte offsets, which must be boundaries, in order.
    fn slice_bytes(&self, r: Range) -> &str with fail(NotABoundary) {
        if !self.is_boundary(r.start) {
            fail(NotABoundary { offset: r.start });
        }
        if !self.is_boundary(r.end) || r.end < r.start {
            fail(NotABoundary { offset: r.end });
        }
        self.bytes_between(r.start, r.end)
    }

    // `&s[a..b]` (`text.pos.1`): the text between two of its positions; traps if one is not
    // this text's, or they are out of order.
    fn between(&self, a: StrPos, b: StrPos) -> &str {
        assert(a.text == self && b.text == self && a.at <= b.at);
        self.bytes_between(a.at, b.at)
    }

    // The text between two byte offsets that are boundaries.
    #[intrinsic]
    fn bytes_between(&self, a: int, b: int) -> &str;

    // Bytes that are UTF-8, as text (`text.utf8.1`).
    fn from_utf8(bytes: &[u8]) -> &str with fail(Utf8Error) {
        let n = utf8_valid_up_to(bytes);
        if n < bytes.len() {
            fail(Utf8Error { valid_up_to: n });
        }
        str::view(bytes, n)
    }

    fn chars(&self) -> Chars {
        Chars { text: self, at: 0 }
    }

    // The character that starts at byte `at`, if one does (for `Chars`).
    #[intrinsic]
    fn char_at_byte(&self, at: int) -> Option<char>;
}

impl String {
    fn chars(&self) -> Chars {
        self.as_str().chars()
    }

    // As `str`'s (`text.pos.1`, `text.find.1`): the positions borrow the string.
    fn start(&self) -> StrPos {
        self.as_str().start()
    }

    fn end(&self) -> StrPos {
        self.as_str().end()
    }

    fn find<P: Pattern>(&self, part: P) -> Option<StrPos> {
        self.as_str().find(part)
    }

    fn rfind<P: Pattern>(&self, part: P) -> Option<StrPos> {
        self.as_str().rfind(part)
    }

    fn split_once<P: Pattern>(&self, part: P) -> Option<(&str, &str)> {
        self.as_str().split_once(part)
    }

    fn pos_at(&self, offset: int) -> StrPos with fail(NotABoundary) {
        self.as_str().pos_at(offset)?
    }

    fn slice_bytes(&self, r: Range) -> &str with fail(NotABoundary) {
        self.as_str().slice_bytes(r)?
    }

    // The bytes as text, if they are UTF-8; else the bytes are given back (`text.utf8.1`).
    fn from_utf8(bytes: Vec<u8>) -> String with fail(FromUtf8Error) {
        let n = utf8_valid_up_to(bytes.as_slice());
        if n < bytes.len() {
            fail(FromUtf8Error { bytes, valid_up_to: n });
        }
        String::from_str(str::view(bytes.as_slice(), n))
    }
}

// Bytes that are not UTF-8 (`text.utf8.1`): how many from the start are.
struct Utf8Error {
    valid_up_to: int,
}

// The same, for `String::from_utf8`, which gives the bytes back.
struct FromUtf8Error {
    bytes: Vec<u8>,
    valid_up_to: int,
}

// How many of `bytes`, from the start, are UTF-8 (`text.utf8.1`): each character its shortest
// encoding, and no surrogate.
fn utf8_valid_up_to(bytes: &[u8]) -> int {
    let n = bytes.len();
    let mut i = 0;
    while i < n {
        let b = bytes[i];
        let (len, lo, hi) = if b < 0x80 {
            (1, 0x80, 0xBF)
        } else if b >= 0xC2 && b <= 0xDF {
            (2, 0x80, 0xBF)
        } else if b == 0xE0 {
            (3, 0xA0, 0xBF)
        } else if b == 0xED {
            (3, 0x80, 0x9F)
        } else if b >= 0xE1 && b <= 0xEF {
            (3, 0x80, 0xBF)
        } else if b == 0xF0 {
            (4, 0x90, 0xBF)
        } else if b >= 0xF1 && b <= 0xF3 {
            (4, 0x80, 0xBF)
        } else if b == 0xF4 {
            (4, 0x80, 0x8F)
        } else {
            return i;
        };
        if i + len > n {
            return i;
        }
        let mut k = 1;
        while k < len {
            let c = bytes[i + k];
            let (l, h) = if k == 1 { (lo, hi) } else { (0x80, 0xBF) };
            if c < l || c > h {
                return i;
            }
            k += 1;
        }
        i += len;
    }
    n
}

// How a value is shown to a developer (`expr.fmt.debug.1`): by `{x:?}` in `fmt"…"`, written as
// Moddil source writes it.
trait Debug {
    fn fmt(&self, out: &mut String);
}

impl Debug for int {
    fn fmt(&self, out: &mut String) {
        Display::fmt(self, out);
    }
}

impl Debug for bool {
    fn fmt(&self, out: &mut String) {
        Display::fmt(self, out);
    }
}

impl Debug for char {
    fn fmt(&self, out: &mut String) {
        out.push_str(&self.quoted());
    }
}

impl Debug for str {
    fn fmt(&self, out: &mut String) {
        out.push_str(&self.quoted());
    }
}

impl Debug for String {
    fn fmt(&self, out: &mut String) {
        out.push_str(&self.as_str().quoted());
    }
}

impl Debug for () {
    fn fmt(&self, out: &mut String) {
        out.push_str("()");
    }
}

impl<T: Debug> Debug for [T] {
    fn fmt(&self, out: &mut String) {
        out.push('[');
        let mut first = true;
        for x in self {
            if !first {
                out.push_str(", ");
            }
            first = false;
            Debug::fmt(x, out);
        }
        out.push(']');
    }
}

impl<T: Debug, const N: int> Debug for [T; N] {
    fn fmt(&self, out: &mut String) {
        Debug::fmt(self.as_slice(), out);
    }
}

impl<T: Debug> Debug for Vec<T> {
    fn fmt(&self, out: &mut String) {
        Debug::fmt(self.as_slice(), out);
    }
}

impl<T: Debug> Debug for Option<T> {
    fn fmt(&self, out: &mut String) {
        match self {
            None => out.push_str("None"),
            Some(x) => {
                out.push_str("Some(");
                Debug::fmt(x, out);
                out.push(')');
            }
        }
    }
}

impl<T: Debug, E: Debug> Debug for Result<T, E> {
    fn fmt(&self, out: &mut String) {
        match self {
            Ok(x) => {
                out.push_str("Ok(");
                Debug::fmt(x, out);
                out.push(')');
            }
            Err(e) => {
                out.push_str("Err(");
                Debug::fmt(e, out);
                out.push(')');
            }
        }
    }
}

impl<A: Debug, B: Debug> Debug for (A, B) {
    fn fmt(&self, out: &mut String) {
        out.push('(');
        Debug::fmt(&self.0, out);
        out.push_str(", ");
        Debug::fmt(&self.1, out);
        out.push(')');
    }
}

impl char {
    // The character as Debug shows it: in quotes, escaped.
    fn quoted(self) -> String {
        String::from_str((&self).quoted_text())
    }

    #[intrinsic]
    fn quoted_text(&self) -> &str;

    // The character itself, as text.
    #[intrinsic]
    fn text(&self) -> &str;
}

impl str {
    // The text as Debug shows it: in quotes, escaped.
    fn quoted(&self) -> String {
        String::from_str(self.quoted_text())
    }

    #[intrinsic]
    fn quoted_text(&self) -> &str;
}

// A type's default value (`attr.derive.default.1`).
trait Default {
    fn default() -> Self;
}

impl Default for int {
    fn default() -> int {
        0
    }
}

impl Default for bool {
    fn default() -> bool {
        false
    }
}

impl Default for String {
    fn default() -> String {
        String::new()
    }
}

impl Default for () {
    fn default() -> () {
        ()
    }
}

impl<T> Default for Vec<T> {
    fn default() -> Vec<T> {
        Vec::new()
    }
}

impl<T> Default for Option<T> {
    fn default() -> Option<T> {
        None
    }
}

// The error `X::new(v)` fails with when `v` is not an `X` (`refine.new.1`): the refined type's
// name, its `where` clause as written, and the value as `Debug` shows it.
#[derive(Debug, Clone, PartialEq)]
struct RefinementError {
    ty: String,
    clause: String,
    value: String,
}

// What a wrapper is told of the function it wraps (`attr.around.1`): its path, and each
// parameter's name and type as written.
#[derive(Debug, Clone, PartialEq)]
struct FnInfo {
    path: String,
    params: Vec<ParamInfo>,
}

#[derive(Debug, Clone, PartialEq)]
struct ParamInfo {
    name: String,
    ty: String,
}

// Structured concurrency (`task.scope.1`): `scope` runs its body as its first task, with a handle
// further tasks are spawned into, and ends once every one of them has. A task's errors go to its
// `join`; one that fails with its `Task` dropped, or a failing body, fails the scope, whose other
// tasks are then cancelled (`task.cancel.1`).

// A scope's handle. It holds what its tasks borrow, until the scope ends.
view Scope {
    id: int,
}

// A task spawned into a scope, running closure `F`, which gives a `T`.
view Task<F, T> {
    id: int,
}

// With `isolate: true`, a trap in the scope cancels it, and it fails with `Trapped`
// (`task.isolate.1`); otherwise a trap ends the program. Only an isolated scope's call can fail
// with `Trapped`.
fn scope<F: FnOnce(&mut Scope) -> R, R>(body: F, isolate: bool = false) -> R
    with spawn, fail(Trapped)
{
    let mut s = Scope { id: __scope_open(isolate) };
    __scope_run::<F, R>(&mut s, body)?
}

impl Scope {
    // Starts a task running `f`, queued to run when the running task suspends.
    #[intrinsic]
    fn spawn<F: FnOnce() -> T, T>(&mut self, f: F) -> Task<F, T> from f with spawn;

    // Asks the scope's tasks to stop, the scopes inside it first (`task.stop.1`).
    #[intrinsic]
    fn stop(&self);
}

impl<F: FnOnce() -> T, T> Task<F, T> {
    // Waits for the task to end: its result, or its error.
    #[intrinsic]
    fn join(self) -> T with suspend, fail(F::Fails);
}

// A task given up without a `join`: an error it fails with fails its scope.
impl<F, T> Drop for Task<F, T> {
    #[intrinsic]
    fn drop(self);
}

// Lets the other tasks that are ready run first.
#[intrinsic]
fn yield_now() with suspend;

// Waits until the running task's scope, or one around it, has been asked to stop, once the
// scopes inside its scope have ended (`task.stop.1`).
#[intrinsic]
fn stop_requested() with suspend;

// What an isolated scope fails with when a trap ends it: the trap's kind (`overflow`) and where
// it was, as `line:column` in its file.
#[derive(Debug, Clone, PartialEq)]
struct Trapped {
    class: String,
    at: String,
}

impl Display for Trapped {
    fn fmt(&self, out: &mut String) {
        out.push_str(&self.class);
        out.push_str(" at ");
        out.push_str(&self.at);
    }
}

#[intrinsic]
fn __scope_open(isolate: bool) -> int;

// Waits until one of a `select`'s operations, described by `ops`, is ready, does it, and gives
// its arm's index (`task.select.1`).
#[intrinsic]
fn __select<T>(ops: T) -> int with suspend;

// Runs the body as the scope's first task, waits for every task of the scope, and gives the
// body's value, or fails with the scope's failure.
#[intrinsic]
fn __scope_run<F: FnOnce(&mut Scope) -> R, R>(s: &mut Scope, body: F) -> R
    with spawn, fail(Trapped);

// Channels (`task.channel.1`): a bounded queue of values between tasks.

// The error a `send` fails with once its channel's `Receiver` is gone.
#[derive(Debug, Clone, PartialEq)]
struct Closed;

// The sending end of a channel; there may be several.
struct Sender<T> {
    id: int,
}

// The receiving end of a channel.
struct Receiver<T> {
    id: int,
}

// A channel holding up to `capacity` values; with capacity 0, a `send` waits until its value is
// received.
#[intrinsic]
fn channel<T>(capacity: int) -> (Sender<T>, Receiver<T>);

impl<T> Sender<T> {
    // Puts `value` in the channel, waiting while it is full.
    #[intrinsic]
    fn send(&self, value: T) with suspend, fail(Closed);
}

impl<T> Receiver<T> {
    // The next value, waiting while the channel is empty; `None` once every `Sender` is gone.
    #[intrinsic]
    fn recv(&self) -> Option<T> with suspend;
}

impl<T> Clone for Sender<T> {
    #[intrinsic]
    fn clone(&self) -> Sender<T>;
}

impl<T> Drop for Sender<T> {
    #[intrinsic]
    fn drop(self);
}

impl<T> Drop for Receiver<T> {
    #[intrinsic]
    fn drop(self);
}
