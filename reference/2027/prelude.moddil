// The prelude: the items every Moddil file can name without importing them (`prelude.md`).
//
// The compiler and the reference interpreter both read this file. A file may not define an item
// with the same name as one of these.

// Optional values.

#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord)]
enum Option<T> {
    None,
    Some(T),
}

impl<T> Option<T> {
    fn is_some(&self) -> bool {
        match self {
            Some(_) => true,
            None => false,
        }
    }

    fn is_none(&self) -> bool {
        !self.is_some()
    }

    fn unwrap_or(self, fallback: T) -> T {
        match self {
            Some(x) => x,
            None => fallback,
        }
    }
}

// Results: a value or an error (`errors.md`).

#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord)]
enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result<T, E> {
    fn is_ok(&self) -> bool {
        match self {
            Ok(_) => true,
            Err(_) => false,
        }
    }

    fn is_err(&self) -> bool {
        !self.is_ok()
    }
}

// Copying and cloning.

trait Clone {
    fn clone(&self) -> Self;
}

trait Copy: Clone {}

// Equality and ordering.

#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord)]
enum Ordering {
    Less,
    Equal,
    Greater,
}

trait PartialEq {
    fn eq(&self, other: &Self) -> bool;

    fn ne(&self, other: &Self) -> bool {
        !self.eq(other)
    }
}

trait Eq: PartialEq {}

trait PartialOrd: PartialEq {
    fn partial_cmp(&self, other: &Self) -> Option<Ordering>;

    fn lt(&self, other: &Self) -> bool {
        match self.partial_cmp(other) {
            Some(Ordering::Less) => true,
            _ => false,
        }
    }

    fn le(&self, other: &Self) -> bool {
        match self.partial_cmp(other) {
            Some(Ordering::Less) | Some(Ordering::Equal) => true,
            _ => false,
        }
    }

    fn gt(&self, other: &Self) -> bool {
        match self.partial_cmp(other) {
            Some(Ordering::Greater) => true,
            _ => false,
        }
    }

    fn ge(&self, other: &Self) -> bool {
        match self.partial_cmp(other) {
            Some(Ordering::Greater) | Some(Ordering::Equal) => true,
            _ => false,
        }
    }
}

trait Ord: Eq + PartialOrd {
    fn cmp(&self, other: &Self) -> Ordering;
}

// Operators.

trait Add {
    type Output;
    fn add(self, rhs: Self) -> Self::Output;
}

trait Sub {
    type Output;
    fn sub(self, rhs: Self) -> Self::Output;
}

trait Mul {
    type Output;
    fn mul(self, rhs: Self) -> Self::Output;
}

trait Div {
    type Output;
    fn div(self, rhs: Self) -> Self::Output;
}

trait Rem {
    type Output;
    fn rem(self, rhs: Self) -> Self::Output;
}

trait Neg {
    type Output;
    fn neg(self) -> Self::Output;
}

trait Not {
    type Output;
    fn not(self) -> Self::Output;
}

// Destructors.

trait Drop {
    fn drop(self);
}

// Ends `x` early: it is moved in, and dropped at the end of the call.
fn drop<T>(x: T) {}

// Closures: what a closure, or a value of a type parameter bounded by one, can be called as.
// `Args` is the tuple of the parameters' types, `Fails` the errors a call can fail with. Every
// closure implements `FnOnce`; one that does not move out what it captures, `FnMut`; one that does
// not change it either, `Fn`.

trait FnOnce<Args> {
    type Output;
    type Fails;
    fn call_once(self, args: Args) -> Self::Output with fail(Self::Fails);
}

trait FnMut<Args>: FnOnce<Args> {
    fn call_mut(&mut self, args: Args) -> Self::Output with fail(Self::Fails);
}

trait Fn<Args>: FnMut<Args> {
    fn call(&self, args: Args) -> Self::Output with fail(Self::Fails);
}

// `int`.

impl Clone for int {
    fn clone(&self) -> int {
        *self
    }
}

impl Copy for int {}

impl PartialEq for int {
    fn eq(&self, other: &int) -> bool {
        *self == *other
    }
}

impl Eq for int {}

impl PartialOrd for int {
    fn partial_cmp(&self, other: &int) -> Option<Ordering> {
        Some(self.cmp(other))
    }

    fn lt(&self, other: &int) -> bool {
        *self < *other
    }

    fn le(&self, other: &int) -> bool {
        *self <= *other
    }

    fn gt(&self, other: &int) -> bool {
        *self > *other
    }

    fn ge(&self, other: &int) -> bool {
        *self >= *other
    }
}

impl Ord for int {
    fn cmp(&self, other: &int) -> Ordering {
        if *self < *other {
            Ordering::Less
        } else if *self == *other {
            Ordering::Equal
        } else {
            Ordering::Greater
        }
    }
}

impl Add for int {
    type Output = int;
    #[track_caller]
    fn add(self, rhs: int) -> int {
        self + rhs
    }
}

impl Sub for int {
    type Output = int;
    #[track_caller]
    fn sub(self, rhs: int) -> int {
        self - rhs
    }
}

impl Mul for int {
    type Output = int;
    #[track_caller]
    fn mul(self, rhs: int) -> int {
        self * rhs
    }
}

impl Div for int {
    type Output = int;
    #[track_caller]
    fn div(self, rhs: int) -> int {
        self / rhs
    }
}

impl Rem for int {
    type Output = int;
    #[track_caller]
    fn rem(self, rhs: int) -> int {
        self % rhs
    }
}

impl Neg for int {
    type Output = int;
    #[track_caller]
    fn neg(self) -> int {
        -self
    }
}

impl Not for int {
    type Output = int;
    fn not(self) -> int {
        !self
    }
}

// `bool`: `false` orders before `true`.

impl Clone for bool {
    fn clone(&self) -> bool {
        *self
    }
}

impl Copy for bool {}

impl PartialEq for bool {
    fn eq(&self, other: &bool) -> bool {
        *self == *other
    }
}

impl Eq for bool {}

impl PartialOrd for bool {
    fn partial_cmp(&self, other: &bool) -> Option<Ordering> {
        Some(self.cmp(other))
    }
}

impl Ord for bool {
    fn cmp(&self, other: &bool) -> Ordering {
        if *self == *other {
            Ordering::Equal
        } else if *other {
            Ordering::Less
        } else {
            Ordering::Greater
        }
    }
}

impl Not for bool {
    type Output = bool;
    fn not(self) -> bool {
        !self
    }
}

// `()`.

impl Clone for () {
    fn clone(&self) -> () {
        ()
    }
}

impl Copy for () {}

impl PartialEq for () {
    fn eq(&self, other: &()) -> bool {
        true
    }
}

impl Eq for () {}

// Text: `char`, `str` and `String`. Their methods marked `#[intrinsic]` are built in.

// How a value is written as text: in `fmt"…"`'s holes, and by `to_string`.
trait Display {
    fn fmt(&self, out: &mut String);

    fn to_string(&self) -> String {
        let mut s = String::new();
        self.fmt(&mut s);
        s
    }
}

impl Display for int {
    #[intrinsic]
    fn fmt(&self, out: &mut String);
}

impl Display for bool {
    #[intrinsic]
    fn fmt(&self, out: &mut String);
}

impl Display for char {
    #[intrinsic]
    fn fmt(&self, out: &mut String);
}

impl Display for str {
    fn fmt(&self, out: &mut String) {
        out.push_str(self);
    }
}

impl Display for String {
    fn fmt(&self, out: &mut String) {
        out.push_str(self.as_str());
    }
}

impl char {
    // The code point, and the `char` of one (`None` for a surrogate or past U+10FFFF).
    #[intrinsic]
    fn code(self) -> int;
    #[intrinsic]
    fn from_code(n: int) -> Option<char>;
    #[intrinsic]
    fn is_alphabetic(self) -> bool;
    #[intrinsic]
    fn is_numeric(self) -> bool;
    #[intrinsic]
    fn is_whitespace(self) -> bool;
    #[intrinsic]
    fn is_uppercase(self) -> bool;
    #[intrinsic]
    fn is_lowercase(self) -> bool;
    // How many bytes it takes in UTF-8.
    #[intrinsic]
    fn len_utf8(self) -> int;
}

impl Clone for char {
    fn clone(&self) -> char {
        *self
    }
}

impl Copy for char {}

impl PartialEq for char {
    fn eq(&self, other: &char) -> bool {
        *self == *other
    }
}

impl Eq for char {}

impl PartialOrd for char {
    fn partial_cmp(&self, other: &char) -> Option<Ordering> {
        Some(self.cmp(other))
    }
}

impl Ord for char {
    fn cmp(&self, other: &char) -> Ordering {
        if *self < *other {
            Ordering::Less
        } else if *self == *other {
            Ordering::Equal
        } else {
            Ordering::Greater
        }
    }
}

impl str {
    // Its length in bytes.
    #[intrinsic]
    fn len(&self) -> int;

    fn is_empty(&self) -> bool {
        self.len() == 0
    }

    #[intrinsic]
    fn starts_with(&self, prefix: &str) -> bool;
    #[intrinsic]
    fn ends_with(&self, suffix: &str) -> bool;
    #[intrinsic]
    fn contains(&self, part: &str) -> bool;
    // Without the white space at its ends.
    #[intrinsic]
    fn trim(&self) -> &str;
    #[intrinsic]
    fn to_uppercase(&self) -> String;
    #[intrinsic]
    fn to_lowercase(&self) -> String;
}

impl PartialEq for str {
    #[intrinsic]
    fn eq(&self, other: &str) -> bool;
}

impl Eq for str {}

impl PartialOrd for str {
    fn partial_cmp(&self, other: &str) -> Option<Ordering> {
        Some(self.cmp(other))
    }
}

// Byte by byte, which for UTF-8 is by code point.
impl Ord for str {
    #[intrinsic]
    fn cmp(&self, other: &str) -> Ordering;
}

impl String {
    #[intrinsic]
    fn new() -> String;
    #[intrinsic]
    fn push_str(&mut self, s: &str);
    #[intrinsic]
    fn push(&mut self, c: char);
    #[intrinsic]
    fn pop(&mut self) -> Option<char>;
    #[intrinsic]
    fn clear(&mut self);
    #[intrinsic]
    fn as_str(&self) -> &str;

    fn len(&self) -> int {
        self.as_str().len()
    }

    fn is_empty(&self) -> bool {
        self.len() == 0
    }

    fn starts_with(&self, prefix: &str) -> bool {
        self.as_str().starts_with(prefix)
    }

    fn ends_with(&self, suffix: &str) -> bool {
        self.as_str().ends_with(suffix)
    }

    fn contains(&self, part: &str) -> bool {
        self.as_str().contains(part)
    }

    fn trim(&self) -> &str {
        self.as_str().trim()
    }

    fn to_uppercase(&self) -> String {
        self.as_str().to_uppercase()
    }

    fn to_lowercase(&self) -> String {
        self.as_str().to_lowercase()
    }
}

impl Clone for String {
    #[intrinsic]
    fn clone(&self) -> String;
}

impl PartialEq for String {
    fn eq(&self, other: &String) -> bool {
        self.as_str() == other.as_str()
    }
}

impl Eq for String {}

impl PartialOrd for String {
    fn partial_cmp(&self, other: &String) -> Option<Ordering> {
        Some(self.cmp(other))
    }
}

impl Ord for String {
    fn cmp(&self, other: &String) -> Ordering {
        self.as_str().cmp(other.as_str())
    }
}
