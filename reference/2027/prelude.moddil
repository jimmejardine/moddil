// The prelude: the items every Moddil file can name without importing them (`prelude.md`).
//
// The compiler and the reference interpreter both read this file. A file may not define an item
// with the same name as one of these.

// Optional values.

#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord)]
enum Option<T> {
    None,
    Some(T),
}

impl<T> Option<T> {
    fn is_some(&self) -> bool {
        match self {
            Some(_) => true,
            None => false,
        }
    }

    fn is_none(&self) -> bool {
        !self.is_some()
    }

    fn unwrap_or(self, fallback: T) -> T {
        match self {
            Some(x) => x,
            None => fallback,
        }
    }
}

// Results: a value or an error (`errors.md`).

#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord)]
enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result<T, E> {
    fn is_ok(&self) -> bool {
        match self {
            Ok(_) => true,
            Err(_) => false,
        }
    }

    fn is_err(&self) -> bool {
        !self.is_ok()
    }
}

// Copying and cloning.

trait Clone {
    fn clone(&self) -> Self;
}

trait Copy: Clone {}

// Equality and ordering.

#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord)]
enum Ordering {
    Less,
    Equal,
    Greater,
}

trait PartialEq {
    fn eq(&self, other: &Self) -> bool;

    fn ne(&self, other: &Self) -> bool {
        !self.eq(other)
    }
}

trait Eq: PartialEq {}

trait PartialOrd: PartialEq {
    fn partial_cmp(&self, other: &Self) -> Option<Ordering>;

    fn lt(&self, other: &Self) -> bool {
        match self.partial_cmp(other) {
            Some(Ordering::Less) => true,
            _ => false,
        }
    }

    fn le(&self, other: &Self) -> bool {
        match self.partial_cmp(other) {
            Some(Ordering::Less) | Some(Ordering::Equal) => true,
            _ => false,
        }
    }

    fn gt(&self, other: &Self) -> bool {
        match self.partial_cmp(other) {
            Some(Ordering::Greater) => true,
            _ => false,
        }
    }

    fn ge(&self, other: &Self) -> bool {
        match self.partial_cmp(other) {
            Some(Ordering::Greater) | Some(Ordering::Equal) => true,
            _ => false,
        }
    }
}

trait Ord: Eq + PartialOrd {
    fn cmp(&self, other: &Self) -> Ordering;
}

// Operators.

trait Add {
    type Output;
    fn add(self, rhs: Self) -> Self::Output;
}

trait Sub {
    type Output;
    fn sub(self, rhs: Self) -> Self::Output;
}

trait Mul {
    type Output;
    fn mul(self, rhs: Self) -> Self::Output;
}

trait Div {
    type Output;
    fn div(self, rhs: Self) -> Self::Output;
}

trait Rem {
    type Output;
    fn rem(self, rhs: Self) -> Self::Output;
}

trait Neg {
    type Output;
    fn neg(self) -> Self::Output;
}

trait Not {
    type Output;
    fn not(self) -> Self::Output;
}

// Destructors.

trait Drop {
    fn drop(self);
}

// Ends `x` early: it is moved in, and dropped at the end of the call.
fn drop<T>(x: T) {}

// Closures: what a closure, or a value of a type parameter bounded by one, can be called as.
// `Args` is the tuple of the parameters' types, `Fails` the errors a call can fail with. Every
// closure implements `FnOnce`; one that does not move out what it captures, `FnMut`; one that does
// not change it either, `Fn`.

trait FnOnce<Args> {
    type Output;
    type Fails;
    fn call_once(self, args: Args) -> Self::Output with fail(Self::Fails);
}

trait FnMut<Args>: FnOnce<Args> {
    fn call_mut(&mut self, args: Args) -> Self::Output with fail(Self::Fails);
}

trait Fn<Args>: FnMut<Args> {
    fn call(&self, args: Args) -> Self::Output with fail(Self::Fails);
}

// `int`.

impl Clone for int {
    fn clone(&self) -> int {
        *self
    }
}

impl Copy for int {}

impl PartialEq for int {
    fn eq(&self, other: &int) -> bool {
        *self == *other
    }
}

impl Eq for int {}

impl PartialOrd for int {
    fn partial_cmp(&self, other: &int) -> Option<Ordering> {
        Some(self.cmp(other))
    }

    fn lt(&self, other: &int) -> bool {
        *self < *other
    }

    fn le(&self, other: &int) -> bool {
        *self <= *other
    }

    fn gt(&self, other: &int) -> bool {
        *self > *other
    }

    fn ge(&self, other: &int) -> bool {
        *self >= *other
    }
}

impl Ord for int {
    fn cmp(&self, other: &int) -> Ordering {
        if *self < *other {
            Ordering::Less
        } else if *self == *other {
            Ordering::Equal
        } else {
            Ordering::Greater
        }
    }
}

impl Add for int {
    type Output = int;
    #[track_caller]
    fn add(self, rhs: int) -> int {
        self + rhs
    }
}

impl Sub for int {
    type Output = int;
    #[track_caller]
    fn sub(self, rhs: int) -> int {
        self - rhs
    }
}

impl Mul for int {
    type Output = int;
    #[track_caller]
    fn mul(self, rhs: int) -> int {
        self * rhs
    }
}

impl Div for int {
    type Output = int;
    #[track_caller]
    fn div(self, rhs: int) -> int {
        self / rhs
    }
}

impl Rem for int {
    type Output = int;
    #[track_caller]
    fn rem(self, rhs: int) -> int {
        self % rhs
    }
}

impl Neg for int {
    type Output = int;
    #[track_caller]
    fn neg(self) -> int {
        -self
    }
}

impl Not for int {
    type Output = int;
    fn not(self) -> int {
        !self
    }
}

// `bool`: `false` orders before `true`.

impl Clone for bool {
    fn clone(&self) -> bool {
        *self
    }
}

impl Copy for bool {}

impl PartialEq for bool {
    fn eq(&self, other: &bool) -> bool {
        *self == *other
    }
}

impl Eq for bool {}

impl PartialOrd for bool {
    fn partial_cmp(&self, other: &bool) -> Option<Ordering> {
        Some(self.cmp(other))
    }
}

impl Ord for bool {
    fn cmp(&self, other: &bool) -> Ordering {
        if *self == *other {
            Ordering::Equal
        } else if *other {
            Ordering::Less
        } else {
            Ordering::Greater
        }
    }
}

impl Not for bool {
    type Output = bool;
    fn not(self) -> bool {
        !self
    }
}

// `()`.

impl Clone for () {
    fn clone(&self) -> () {
        ()
    }
}

impl Copy for () {}

impl PartialEq for () {
    fn eq(&self, other: &()) -> bool {
        true
    }
}

impl Eq for () {}

// Text: `char`, `str` and `String`. Their methods marked `#[intrinsic]` are built in.

// How a value is written as text: in `fmt"…"`'s holes, and by `to_string`.
trait Display {
    fn fmt(&self, out: &mut String);

    fn to_string(&self) -> String {
        let mut s = String::new();
        self.fmt(&mut s);
        s
    }
}

impl Display for int {
    #[intrinsic]
    fn fmt(&self, out: &mut String);
}

impl Display for bool {
    #[intrinsic]
    fn fmt(&self, out: &mut String);
}

impl Display for char {
    #[intrinsic]
    fn fmt(&self, out: &mut String);
}

impl Display for str {
    fn fmt(&self, out: &mut String) {
        out.push_str(self);
    }
}

impl Display for String {
    fn fmt(&self, out: &mut String) {
        out.push_str(self.as_str());
    }
}

impl char {
    // The code point, and the `char` of one (`None` for a surrogate or past U+10FFFF).
    #[intrinsic]
    fn code(self) -> int;
    #[intrinsic]
    fn from_code(n: int) -> Option<char>;
    #[intrinsic]
    fn is_alphabetic(self) -> bool;
    #[intrinsic]
    fn is_numeric(self) -> bool;
    #[intrinsic]
    fn is_whitespace(self) -> bool;
    #[intrinsic]
    fn is_uppercase(self) -> bool;
    #[intrinsic]
    fn is_lowercase(self) -> bool;
    // How many bytes it takes in UTF-8.
    #[intrinsic]
    fn len_utf8(self) -> int;
}

impl Clone for char {
    fn clone(&self) -> char {
        *self
    }
}

impl Copy for char {}

impl PartialEq for char {
    fn eq(&self, other: &char) -> bool {
        *self == *other
    }
}

impl Eq for char {}

impl PartialOrd for char {
    fn partial_cmp(&self, other: &char) -> Option<Ordering> {
        Some(self.cmp(other))
    }
}

impl Ord for char {
    fn cmp(&self, other: &char) -> Ordering {
        if *self < *other {
            Ordering::Less
        } else if *self == *other {
            Ordering::Equal
        } else {
            Ordering::Greater
        }
    }
}

impl str {
    // Its length in bytes.
    #[intrinsic]
    fn len(&self) -> int;

    fn is_empty(&self) -> bool {
        self.len() == 0
    }

    #[intrinsic]
    fn starts_with(&self, prefix: &str) -> bool;
    #[intrinsic]
    fn ends_with(&self, suffix: &str) -> bool;
    #[intrinsic]
    fn contains(&self, part: &str) -> bool;
    // Without the white space at its ends.
    #[intrinsic]
    fn trim(&self) -> &str;
    #[intrinsic]
    fn to_uppercase(&self) -> String;
    #[intrinsic]
    fn to_lowercase(&self) -> String;
}

impl PartialEq for str {
    #[intrinsic]
    fn eq(&self, other: &str) -> bool;
}

impl Eq for str {}

impl PartialOrd for str {
    fn partial_cmp(&self, other: &str) -> Option<Ordering> {
        Some(self.cmp(other))
    }
}

// Byte by byte, which for UTF-8 is by code point.
impl Ord for str {
    #[intrinsic]
    fn cmp(&self, other: &str) -> Ordering;
}

impl String {
    #[intrinsic]
    fn new() -> String;
    #[intrinsic]
    fn push_str(&mut self, s: &str);
    #[intrinsic]
    fn push(&mut self, c: char);
    #[intrinsic]
    fn pop(&mut self) -> Option<char>;
    #[intrinsic]
    fn clear(&mut self);
    #[intrinsic]
    fn as_str(&self) -> &str;

    fn len(&self) -> int {
        self.as_str().len()
    }

    fn is_empty(&self) -> bool {
        self.len() == 0
    }

    fn starts_with(&self, prefix: &str) -> bool {
        self.as_str().starts_with(prefix)
    }

    fn ends_with(&self, suffix: &str) -> bool {
        self.as_str().ends_with(suffix)
    }

    fn contains(&self, part: &str) -> bool {
        self.as_str().contains(part)
    }

    fn trim(&self) -> &str {
        self.as_str().trim()
    }

    fn to_uppercase(&self) -> String {
        self.as_str().to_uppercase()
    }

    fn to_lowercase(&self) -> String {
        self.as_str().to_lowercase()
    }
}

impl Clone for String {
    #[intrinsic]
    fn clone(&self) -> String;
}

impl PartialEq for String {
    fn eq(&self, other: &String) -> bool {
        self.as_str() == other.as_str()
    }
}

impl Eq for String {}

impl PartialOrd for String {
    fn partial_cmp(&self, other: &String) -> Option<Ordering> {
        Some(self.cmp(other))
    }
}

impl Ord for String {
    fn cmp(&self, other: &String) -> Ordering {
        self.as_str().cmp(other.as_str())
    }
}

// Arrays and slices.

impl<T> [T] {
    // How many elements it has.
    #[intrinsic]
    fn len(&self) -> int;

    fn is_empty(&self) -> bool {
        self.len() == 0
    }
}

impl<T, const N: int> [T; N] {
    fn len(&self) -> int {
        N
    }

    fn is_empty(&self) -> bool {
        N == 0
    }

    fn as_slice(&self) -> &[T] {
        self
    }
}

impl<T: PartialEq> PartialEq for [T] {
    fn eq(&self, other: &[T]) -> bool {
        if self.len() != other.len() {
            return false;
        }
        let mut i = 0;
        while i < self.len() {
            if self[i] != other[i] {
                return false;
            }
            i += 1;
        }
        true
    }
}

impl<T: Eq> Eq for [T] {}

impl<T: PartialEq, const N: int> PartialEq for [T; N] {
    fn eq(&self, other: &[T; N]) -> bool {
        self.as_slice() == other.as_slice()
    }
}

impl<T: Eq, const N: int> Eq for [T; N] {}

// Iteration (`expr.for.1`): `for p in e` calls `IntoIterator::into_iter(e)`, then `next` until
// it gives `None`.

trait Iterator {
    type Item;
    fn next(&mut self) -> Option<Self::Item>;

    // How many items are left, using them up.
    fn count(self) -> int {
        let mut it = self;
        let mut n = 0;
        while let Some(_) = it.next() {
            n += 1;
        }
        n
    }
}

trait IntoIterator {
    type Item;
    type IntoIter;
    fn into_iter(self) -> Self::IntoIter;
}

// An iterator is one itself.
impl<I: Iterator> IntoIterator for I {
    type Item = <I as Iterator>::Item;
    type IntoIter = I;
    fn into_iter(self) -> I {
        self
    }
}

// `a..b`: the integers from `a` up to but not including `b`.
struct Range {
    start: int,
    end: int,
}

impl Iterator for Range {
    type Item = int;
    fn next(&mut self) -> Option<int> {
        if self.start < self.end {
            let x = self.start;
            self.start = x + 1;
            Some(x)
        } else {
            None
        }
    }
}

// `a..=b`: the integers from `a` to `b`, both included.
struct RangeInclusive {
    start: int,
    end: int,
    done: bool,
}

impl Iterator for RangeInclusive {
    type Item = int;
    fn next(&mut self) -> Option<int> {
        if self.done || self.start > self.end {
            return None;
        }
        let x = self.start;
        if x == self.end {
            self.done = true;
        } else {
            self.start = x + 1;
        }
        Some(x)
    }
}

// `a..`: the integers from `a` on.
struct RangeFrom {
    start: int,
}

impl Iterator for RangeFrom {
    type Item = int;
    fn next(&mut self) -> Option<int> {
        let x = self.start;
        self.start = x + 1;
        Some(x)
    }
}

// The elements of a slice, borrowed in order.
view Iter<T> {
    slice: &[T],
    pos: int,
}

impl<T> Iterator for Iter<T> {
    type Item = &T;
    fn next(&mut self) -> Option<&T> {
        if self.pos < self.slice.len() {
            let x = &self.slice[self.pos];
            self.pos += 1;
            Some(x)
        } else {
            None
        }
    }
}

impl<T> [T] {
    fn iter(&self) -> Iter<T> {
        Iter { slice: self, pos: 0 }
    }
}

impl<T, const N: int> [T; N] {
    fn iter(&self) -> Iter<T> {
        Iter { slice: self, pos: 0 }
    }
}

impl<T> IntoIterator for &[T] {
    type Item = &T;
    type IntoIter = Iter<T>;
    fn into_iter(self) -> Iter<T> {
        self.iter()
    }
}

impl<T, const N: int> IntoIterator for &[T; N] {
    type Item = &T;
    type IntoIter = Iter<T>;
    fn into_iter(self) -> Iter<T> {
        self.iter()
    }
}

// An array's elements, by value: they move into a buffer that gives them out in order.
impl<T, const N: int> IntoIterator for [T; N] {
    type Item = T;
    type IntoIter = IntoIter<T>;
    fn into_iter(self) -> IntoIter<T> {
        IntoIter { buf: Buf::from_array(self) }
    }
}

// Indexing: `xs[i]` on a type other than an array or slice is `*xs.index(i)`, or
// `*xs.index_mut(i)` where the element is changed.

trait Index {
    type Output;
    fn index(&self, i: int) -> &Self::Output;
}

trait IndexMut: Index {
    fn index_mut(&mut self, i: int) -> &mut Self::Output;
}

// Collection literals (`expr.array.from.1`): `[a, b]` and `[x; n]` make the type the context
// expects, if it implements this.
trait FromArrayLiteral<T> {
    fn from_array<const N: int>(items: [T; N]) -> Self;
    fn from_repeat(x: T, n: int) -> Self where T: Clone;
}

// `Buf<T>`: built-in storage with a fixed capacity, of which a prefix holds elements. `Vec` is
// written over it. Its elements are dropped with it, first to last.
impl<T> Buf<T> {
    // An empty buffer with room for `capacity` elements.
    #[intrinsic]
    fn with_capacity(capacity: int) -> Buf<T>;
    // A full buffer of the array's elements.
    #[intrinsic]
    fn from_array<const N: int>(items: [T; N]) -> Buf<T>;
    #[intrinsic]
    fn len(&self) -> int;
    #[intrinsic]
    fn capacity(&self) -> int;
    // Changes its capacity, to no less than its length.
    #[intrinsic]
    fn set_capacity(&mut self, capacity: int);
    // Adds `x` at the end; traps if it is full.
    #[intrinsic]
    fn push(&mut self, x: T);
    #[intrinsic]
    fn pop(&mut self) -> Option<T>;
    // Puts `x` at `i`, moving the elements from `i` on along; traps if it is full or `i` is past
    // the end.
    #[intrinsic]
    fn insert(&mut self, i: int, x: T);
    // Takes out the element at `i`, moving those after it back; traps if there is none.
    #[intrinsic]
    fn remove(&mut self, i: int) -> T;
    #[intrinsic]
    fn swap(&mut self, i: int, j: int);
    #[intrinsic]
    fn as_slice(&self) -> &[T];
    #[intrinsic]
    fn as_mut_slice(&mut self) -> &mut [T];
}

// `Vec<T>`: a growable array, written over `Buf`.
struct Vec<T> {
    buf: Buf<T>,
}

impl<T> Vec<T> {
    fn new() -> Vec<T> {
        Vec { buf: Buf::with_capacity(0) }
    }

    fn with_capacity(capacity: int) -> Vec<T> {
        Vec { buf: Buf::with_capacity(capacity) }
    }

    fn len(&self) -> int {
        self.buf.len()
    }

    fn is_empty(&self) -> bool {
        self.buf.len() == 0
    }

    fn capacity(&self) -> int {
        self.buf.capacity()
    }

    // Makes room for `extra` more elements.
    fn reserve(&mut self, extra: int) {
        let want = self.buf.len() + extra;
        if want > self.buf.capacity() {
            let mut cap = self.buf.capacity() * 2;
            if cap < want {
                cap = want;
            }
            self.buf.set_capacity(cap);
        }
    }

    fn push(&mut self, x: T) {
        if self.buf.len() == self.buf.capacity() {
            self.reserve(1);
        }
        self.buf.push(x);
    }

    fn pop(&mut self) -> Option<T> {
        self.buf.pop()
    }

    #[track_caller]
    fn insert(&mut self, i: int, x: T) {
        if self.buf.len() == self.buf.capacity() {
            self.reserve(1);
        }
        self.buf.insert(i, x);
    }

    #[track_caller]
    fn remove(&mut self, i: int) -> T {
        self.buf.remove(i)
    }

    #[track_caller]
    fn swap(&mut self, i: int, j: int) {
        self.buf.swap(i, j);
    }

    // Drops the elements from `len` on.
    fn truncate(&mut self, len: int) {
        while self.buf.len() > len {
            self.buf.pop();
        }
    }

    fn clear(&mut self) {
        self.truncate(0);
    }

    fn get(&self, i: int) -> Option<&T> {
        if 0 <= i && i < self.buf.len() {
            Some(&self.buf.as_slice()[i])
        } else {
            None
        }
    }

    fn get_mut(&mut self, i: int) -> Option<&mut T> {
        if 0 <= i && i < self.buf.len() {
            Some(&mut self.buf.as_mut_slice()[i])
        } else {
            None
        }
    }

    fn first(&self) -> Option<&T> {
        self.get(0)
    }

    fn last(&self) -> Option<&T> {
        self.get(self.buf.len() - 1)
    }

    fn as_slice(&self) -> &[T] {
        self.buf.as_slice()
    }

    fn as_mut_slice(&mut self) -> &mut [T] {
        self.buf.as_mut_slice()
    }

    fn iter(&self) -> Iter<T> {
        self.buf.as_slice().iter()
    }
}

impl<T: PartialEq> Vec<T> {
    fn contains(&self, x: &T) -> bool {
        for y in self.as_slice() {
            if *y == *x {
                return true;
            }
        }
        false
    }
}

impl<T> Index for Vec<T> {
    type Output = T;
    #[track_caller]
    fn index(&self, i: int) -> &T {
        &self.buf.as_slice()[i]
    }
}

impl<T> IndexMut for Vec<T> {
    #[track_caller]
    fn index_mut(&mut self, i: int) -> &mut T {
        &mut self.buf.as_mut_slice()[i]
    }
}

impl<T> FromArrayLiteral<T> for Vec<T> {
    fn from_array<const N: int>(items: [T; N]) -> Vec<T> {
        Vec { buf: Buf::from_array(items) }
    }

    fn from_repeat(x: T, n: int) -> Vec<T> where T: Clone {
        let mut v = Vec::with_capacity(n);
        if n > 0 {
            let mut i = 1;
            while i < n {
                v.push(x.clone());
                i += 1;
            }
            v.push(x);
        }
        v
    }
}

impl<T: Clone> Clone for Vec<T> {
    fn clone(&self) -> Vec<T> {
        let mut v = Vec::with_capacity(self.len());
        for x in self.as_slice() {
            v.push(x.clone());
        }
        v
    }
}

impl<T: PartialEq> PartialEq for Vec<T> {
    fn eq(&self, other: &Vec<T>) -> bool {
        self.as_slice() == other.as_slice()
    }
}

impl<T: Eq> Eq for Vec<T> {}

impl<T> IntoIterator for &Vec<T> {
    type Item = &T;
    type IntoIter = Iter<T>;
    fn into_iter(self) -> Iter<T> {
        self.iter()
    }
}

// A `Vec`'s elements, by value: it is used up.
struct IntoIter<T> {
    buf: Buf<T>,
}

impl<T> Iterator for IntoIter<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        if self.buf.len() == 0 {
            None
        } else {
            Some(self.buf.remove(0))
        }
    }
}

impl<T> IntoIterator for Vec<T> {
    type Item = T;
    type IntoIter = IntoIter<T>;
    fn into_iter(self) -> IntoIter<T> {
        IntoIter { buf: self.buf }
    }
}

// `replace` puts `value` where `dest` points and gives back what was there; `swap` exchanges two
// values. Both are built in.
#[intrinsic]
fn replace<T>(dest: &mut T, value: T) -> T;

#[intrinsic]
fn swap<T>(a: &mut T, b: &mut T);

// Wrapping arithmetic on the bits of an `int`, until the wrapping operators (slice S10).
impl int {
    #[intrinsic]
    fn wrapping_add(self, other: int) -> int;
    #[intrinsic]
    fn wrapping_sub(self, other: int) -> int;
    #[intrinsic]
    fn wrapping_mul(self, other: int) -> int;
    // The 64 bits rotated left by `n` places (taken modulo 64).
    #[intrinsic]
    fn rotate_left(self, n: int) -> int;
}

// Hashing (`coll.hash.1`): a type says what it hashes, a `Hasher` how.
trait Hasher {
    fn write_int(&mut self, x: int);
    fn finish(&self) -> int;
}

trait Hash {
    fn hash<H: Hasher>(&self, state: &mut H);
}

impl Hash for int {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_int(*self);
    }
}

impl Hash for bool {
    fn hash<H: Hasher>(&self, state: &mut H) {
        if *self {
            state.write_int(1);
        } else {
            state.write_int(0);
        }
    }
}

impl Hash for char {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_int(self.code());
    }
}

impl Hash for str {
    fn hash<H: Hasher>(&self, state: &mut H) {
        for c in self.chars() {
            state.write_int(c.code());
        }
        state.write_int(self.len());
    }
}

impl Hash for String {
    fn hash<H: Hasher>(&self, state: &mut H) {
        self.as_str().hash(state);
    }
}

impl<T: Hash> Hash for [T] {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_int(self.len());
        for x in self {
            x.hash(state);
        }
    }
}

impl<T: Hash> Hash for Vec<T> {
    fn hash<H: Hasher>(&self, state: &mut H) {
        self.as_slice().hash(state);
    }
}

impl<T: Hash> Hash for Option<T> {
    fn hash<H: Hasher>(&self, state: &mut H) {
        match self {
            None => state.write_int(0),
            Some(x) => {
                state.write_int(1);
                x.hash(state);
            }
        }
    }
}

impl<A: Hash, B: Hash> Hash for (A, B) {
    fn hash<H: Hasher>(&self, state: &mut H) {
        self.0.hash(state);
        self.1.hash(state);
    }
}

// A string's characters, in order.
view Chars {
    text: &str,
    at: int,
}

impl Iterator for Chars {
    type Item = char;
    fn next(&mut self) -> Option<char> {
        match self.text.char_at_byte(self.at) {
            Some(c) => {
                self.at += c.len_utf8();
                Some(c)
            }
            None => None,
        }
    }
}

impl str {
    fn chars(&self) -> Chars {
        Chars { text: self, at: 0 }
    }

    // The character that starts at byte `at`, if one does (for `Chars`).
    #[intrinsic]
    fn char_at_byte(&self, at: int) -> Option<char>;
}

impl String {
    fn chars(&self) -> Chars {
        self.as_str().chars()
    }
}
