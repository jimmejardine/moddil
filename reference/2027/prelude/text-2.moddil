// A string's characters, in order.
view Chars {
    text: &str,
    at: int,
}

impl Iterator for Chars {
    type Item = char;
    fn next(&mut self) -> Option<char> {
        match self.text.char_at_byte(self.at) {
            Some(c) => {
                self.at += c.len_utf8();
                Some(c)
            }
            None => None,
        }
    }
}

// A position in text (`text.pos.1`): a byte offset on a character boundary of the text it was
// found in, which it borrows, so the text cannot change while it is live. Slicing other text with
// it traps, for now.
view StrPos {
    text: &str,
    at: int,
}

impl Clone for StrPos {
    fn clone(&self) -> StrPos {
        *self
    }
}

impl Copy for StrPos {}

impl StrPos {
    // Its byte offset in its text.
    fn offset(self) -> int {
        self.at
    }

    // The position just past `part`, which is at this one; traps if it is not.
    fn after<P: Pattern>(self, part: P) -> StrPos {
        assert(self.text.has_at(&part, self.at));
        StrPos { text: self.text, at: self.at + part.pattern_len() }
    }
}

// A byte offset that is not a character boundary of the text, or is past its end (`text.pos.1`).
struct NotABoundary {
    offset: int,
}

impl str {
    // Where the text starts, and where it ends (`text.pos.1`).
    fn start(&self) -> StrPos {
        StrPos { text: self, at: 0 }
    }

    fn end(&self) -> StrPos {
        StrPos { text: self, at: self.len() }
    }

    // Where `part` first is, if it is (`text.find.1`).
    fn find<P: Pattern>(&self, part: P) -> Option<StrPos> {
        let mut at = 0;
        while at + part.pattern_len() <= self.len() {
            if self.has_at(&part, at) {
                return Some(StrPos { text: self, at });
            }
            at += 1;
        }
        None
    }

    // Where `part` last is, if it is.
    fn rfind<P: Pattern>(&self, part: P) -> Option<StrPos> {
        let mut at = self.len() - part.pattern_len();
        while at >= 0 {
            if self.has_at(&part, at) {
                return Some(StrPos { text: self, at });
            }
            at -= 1;
        }
        None
    }

    // The text before the first `part`, and the text after it, if it is there.
    fn split_once<P: Pattern>(&self, part: P) -> Option<(&str, &str)> {
        let n = part.pattern_len();
        match self.find(part) {
            Some(at) => Some((
                self.bytes_between(0, at.at),
                self.bytes_between(at.at + n, self.len()),
            )),
            None => None,
        }
    }

    // Whether byte `offset` is a character boundary: the start of a character, or the end.
    fn is_boundary(&self, offset: int) -> bool {
        if offset == self.len() {
            return true;
        }
        offset >= 0 && offset < self.len() && (self.byte_at(offset) & 0xC0) != 0x80
    }

    // The position at byte `offset`, an offset that came from outside (`text.pos.1`).
    fn pos_at(&self, offset: int) -> StrPos with fail(NotABoundary) {
        if !self.is_boundary(offset) {
            fail(NotABoundary { offset });
        }
        StrPos { text: self, at: offset }
    }

    // The text between two byte offsets, which must be boundaries, in order.
    fn slice_bytes(&self, r: Range) -> &str with fail(NotABoundary) {
        if !self.is_boundary(r.start) {
            fail(NotABoundary { offset: r.start });
        }
        if !self.is_boundary(r.end) || r.end < r.start {
            fail(NotABoundary { offset: r.end });
        }
        self.bytes_between(r.start, r.end)
    }

    // `&s[a..b]` (`text.pos.1`): the text between two of its positions; traps if one is not
    // this text's, or they are out of order.
    fn between(&self, a: StrPos, b: StrPos) -> &str {
        assert(a.text == self && b.text == self && a.at <= b.at);
        self.bytes_between(a.at, b.at)
    }

    // The text between two byte offsets that are boundaries.
    #[intrinsic]
    fn bytes_between(&self, a: int, b: int) -> &str;

    // Bytes that are UTF-8, as text (`text.utf8.1`).
    fn from_utf8(bytes: &[u8]) -> &str with fail(Utf8Error) {
        let n = utf8_valid_up_to(bytes);
        if n < bytes.len() {
            fail(Utf8Error { valid_up_to: n });
        }
        str::view(bytes, n)
    }

    fn chars(&self) -> Chars {
        Chars { text: self, at: 0 }
    }

    // The character that starts at byte `at`, if one does (for `Chars`).
    #[intrinsic]
    fn char_at_byte(&self, at: int) -> Option<char>;
}

impl String {
    fn chars(&self) -> Chars {
        self.as_str().chars()
    }

    // As `str`'s (`text.pos.1`, `text.find.1`): the positions borrow the string.
    fn start(&self) -> StrPos {
        self.as_str().start()
    }

    fn end(&self) -> StrPos {
        self.as_str().end()
    }

    fn find<P: Pattern>(&self, part: P) -> Option<StrPos> {
        self.as_str().find(part)
    }

    fn rfind<P: Pattern>(&self, part: P) -> Option<StrPos> {
        self.as_str().rfind(part)
    }

    fn split_once<P: Pattern>(&self, part: P) -> Option<(&str, &str)> {
        self.as_str().split_once(part)
    }

    fn pos_at(&self, offset: int) -> StrPos with fail(NotABoundary) {
        self.as_str().pos_at(offset)?
    }

    fn slice_bytes(&self, r: Range) -> &str with fail(NotABoundary) {
        self.as_str().slice_bytes(r)?
    }

    // The bytes as text, if they are UTF-8; else the bytes are given back (`text.utf8.1`).
    fn from_utf8(bytes: Vec<u8>) -> String with fail(FromUtf8Error) {
        let n = utf8_valid_up_to(bytes.as_slice());
        if n < bytes.len() {
            fail(FromUtf8Error { bytes, valid_up_to: n });
        }
        String::from_str(str::view(bytes.as_slice(), n))
    }
}

// Bytes that are not UTF-8 (`text.utf8.1`): how many from the start are.
struct Utf8Error {
    valid_up_to: int,
}

// The same, for `String::from_utf8`, which gives the bytes back.
struct FromUtf8Error {
    bytes: Vec<u8>,
    valid_up_to: int,
}

// How many of `bytes`, from the start, are UTF-8 (`text.utf8.1`): each character its shortest
// encoding, and no surrogate.
fn utf8_valid_up_to(bytes: &[u8]) -> int {
    let n = bytes.len();
    let mut i = 0;
    while i < n {
        let b = bytes[i];
        let (len, lo, hi) = if b < 0x80 {
            (1, 0x80, 0xBF)
        } else if b >= 0xC2 && b <= 0xDF {
            (2, 0x80, 0xBF)
        } else if b == 0xE0 {
            (3, 0xA0, 0xBF)
        } else if b == 0xED {
            (3, 0x80, 0x9F)
        } else if b >= 0xE1 && b <= 0xEF {
            (3, 0x80, 0xBF)
        } else if b == 0xF0 {
            (4, 0x90, 0xBF)
        } else if b >= 0xF1 && b <= 0xF3 {
            (4, 0x80, 0xBF)
        } else if b == 0xF4 {
            (4, 0x80, 0x8F)
        } else {
            return i;
        };
        if i + len > n {
            return i;
        }
        let mut k = 1;
        while k < len {
            let c = bytes[i + k];
            let (l, h) = if k == 1 { (lo, hi) } else { (0x80, 0xBF) };
            if c < l || c > h {
                return i;
            }
            k += 1;
        }
        i += len;
    }
    n
}

