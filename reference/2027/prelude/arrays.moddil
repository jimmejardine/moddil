// Part of the prelude (`../prelude.md`): arrays and slices.

// Arrays and slices.

impl<T> [T] {
    // How many elements it has.
    #[intrinsic]
    fn len(&self) -> int;

    fn is_empty(&self) -> bool {
        self.len() == 0
    }
}

impl<T, const N: int> [T; N] {
    fn len(&self) -> int {
        N
    }

    fn is_empty(&self) -> bool {
        N == 0
    }

    fn as_slice(&self) -> &[T] {
        self
    }
}

// `[x; n]` for an `x` that is not `Copy` (`expr.array.repeat.1`): `n - 1` clones of `x`, then
// `x` itself. A trap in a clone drops the elements made so far, which the buffer holds.
fn repeat_array<T: Clone, const N: int>(x: T) -> [T; N] {
    let mut b: Buf<T> = Buf::with_capacity(N);
    if N > 0 {
        let mut i = 1;
        while i < N {
            b.push(x.clone());
            i += 1;
        }
        b.push(x);
    }
    b.into_array()
}

// An array of elements that are `Clone` but not `Copy` (or past the size `Copy` allows): each
// element cloned, in order (`type.array.1`).
impl<T: Clone, const N: int> Clone for [T; N] {
    fn clone(&self) -> [T; N] {
        let mut b: Buf<T> = Buf::with_capacity(N);
        let mut i = 0;
        while i < N {
            b.push(self[i].clone());
            i += 1;
        }
        b.into_array()
    }
}

impl<T: PartialEq> PartialEq for [T] {
    fn eq(&self, other: &[T]) -> bool {
        if self.len() != other.len() {
            return false;
        }
        let mut i = 0;
        while i < self.len() {
            if self[i] != other[i] {
                return false;
            }
            i += 1;
        }
        true
    }
}

impl<T: Eq> Eq for [T] {}

impl<T: PartialEq, const N: int> PartialEq for [T; N] {
    fn eq(&self, other: &[T; N]) -> bool {
        self.as_slice() == other.as_slice()
    }
}

impl<T: Eq, const N: int> Eq for [T; N] {}

