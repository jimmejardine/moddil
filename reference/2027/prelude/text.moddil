// Part of the prelude (`../prelude.md`): `TextWrite`, `Display`, `char`, `str` and `String`, `Pattern`,
// `Chars`, text positions and UTF-8.

// Text: `char`, `str` and `String`. Their methods marked `#[intrinsic]` are built in.

// Where text is written (`text.write.1`): what `Display` and `Debug` write to. Writing cannot
// fail.
trait TextWrite {
    fn write_str(&mut self, s: &str);

    // `w.write_fmt(fmt"…")` (`text.write.2`): the literal is written straight onto the sink,
    // each part through `write_str`, with no `String` made for it; any other `String` is
    // written as it is.
    fn write_fmt(&mut self, text: String) {
        self.write_str(text.as_str());
    }

    fn write_char(&mut self, c: char) {
        let mut one = String::new();
        one.push(c);
        self.write_str(one.as_str());
    }
}

impl TextWrite for String {
    fn write_str(&mut self, s: &str) {
        self.push_str(s);
    }

    fn write_char(&mut self, c: char) {
        self.push(c);
    }
}

// How a value is written as text: in `fmt"…"`'s holes, and by `to_string`.
trait Display {
    fn fmt(&self, out: &mut dyn TextWrite);

    fn to_string(&self) -> String {
        let mut s = String::new();
        self.fmt(&mut s);
        s
    }
}

impl Display for int {
    fn fmt(&self, out: &mut dyn TextWrite) {
        out.write_str(self.text());
    }
}

impl Display for bool {
    fn fmt(&self, out: &mut dyn TextWrite) {
        out.write_str(self.text());
    }
}

impl bool {
    // `true` or `false`.
    #[intrinsic]
    fn text(&self) -> &str;
}

impl Display for char {
    fn fmt(&self, out: &mut dyn TextWrite) {
        out.write_str(self.text());
    }
}

impl Display for str {
    fn fmt(&self, out: &mut dyn TextWrite) {
        out.write_str(self);
    }
}

impl Display for String {
    fn fmt(&self, out: &mut dyn TextWrite) {
        out.write_str(self.as_str());
    }
}

impl char {
    // The code point, and the `char` of one (`None` for a surrogate or past U+10FFFF).
    #[intrinsic]
    fn code(self) -> int;
    #[intrinsic]
    fn from_code(n: int) -> Option<char>;
    #[intrinsic]
    fn is_alphabetic(self) -> bool;
    #[intrinsic]
    fn is_numeric(self) -> bool;
    #[intrinsic]
    fn is_whitespace(self) -> bool;
    #[intrinsic]
    fn is_uppercase(self) -> bool;
    #[intrinsic]
    fn is_lowercase(self) -> bool;
    // How many bytes it takes in UTF-8.
    #[intrinsic]
    fn len_utf8(self) -> int;
}

impl Clone for char {
    fn clone(&self) -> char {
        *self
    }
}

impl Copy for char {}

impl PartialEq for char {
    fn eq(&self, other: &char) -> bool {
        *self == *other
    }
}

impl Eq for char {}

impl PartialOrd for char {
    fn partial_cmp(&self, other: &char) -> Option<Ordering> {
        Some(self.cmp(other))
    }
}

impl Ord for char {
    fn cmp(&self, other: &char) -> Ordering {
        if *self < *other { Ordering::Less } else if *self == *other { Ordering::Equal } else { Ordering::Greater }
    }
}

impl str {
    // Its length in bytes.
    #[intrinsic]
    fn len(&self) -> int;

    fn is_empty(&self) -> bool {
        self.len() == 0
    }

    // Its `i`th byte; traps if there is none.
    #[intrinsic]
    fn byte_at(&self, i: int) -> u8;

    // Its bytes, which are UTF-8 (`text.bytes.1`).
    #[intrinsic]
    fn as_bytes(&self) -> &[u8];

    // The first `len` bytes of `bytes`, which are UTF-8, as text (`text.string.inline.1`).
    #[intrinsic]
    fn view(bytes: &[u8], len: int) -> &str;

    // Whether `part`'s bytes are at byte `at`.
    fn has_at<P: Pattern>(&self, part: &P, at: int) -> bool {
        let n = part.pattern_len();
        if at < 0 || at + n > self.len() {
            return false;
        }
        let mut i = 0;
        while i < n {
            if self.byte_at(at + i) != part.pattern_byte(i) {
                return false;
            }
            i += 1;
        }
        true
    }

    fn starts_with<P: Pattern>(&self, prefix: P) -> bool {
        self.has_at(&prefix, 0)
    }

    fn ends_with<P: Pattern>(&self, suffix: P) -> bool {
        let at = self.len() - suffix.pattern_len();
        self.has_at(&suffix, at)
    }

    fn contains<P: Pattern>(&self, part: P) -> bool {
        let mut at = 0;
        while at + part.pattern_len() <= self.len() {
            if self.has_at(&part, at) {
                return true;
            }
            at += 1;
        }
        false
    }

    // Without the white space at its ends.
    #[intrinsic]
    fn trim(&self) -> &str;

    // Unicode's case mappings, which need its tables.
    #[intrinsic]
    fn upper_text(&self) -> &str;
    #[intrinsic]
    fn lower_text(&self) -> &str;

    fn to_uppercase(&self) -> String {
        String::from_str(self.upper_text())
    }

    fn to_lowercase(&self) -> String {
        String::from_str(self.lower_text())
    }
}

impl PartialEq for str {
    #[intrinsic]
    fn eq(&self, other: &str) -> bool;
}

impl Eq for str {}

impl PartialOrd for str {
    fn partial_cmp(&self, other: &str) -> Option<Ordering> {
        Some(self.cmp(other))
    }
}

// Byte by byte, which for UTF-8 is by code point.
impl Ord for str {
    #[intrinsic]
    fn cmp(&self, other: &str) -> Ordering;
}

// `String` (`text.string.1`): owned, growable UTF-8, over `u8` bytes in the small-string form
// (`text.string.inline.1`): up to 23 bytes inside the `String` itself, more in a heap buffer.
struct String {
    repr: StringRepr,
}

// Where a `String`'s bytes are: inline, with how many there are, or in a heap buffer.
enum StringRepr {
    Inline([u8; 23], u8),
    Heap(Buf<u8>),
}

impl String {
    fn new() -> String {
        String { repr: StringRepr::Inline([0; 23], 0) }
    }

    // Room for `capacity` bytes: on the heap if that is more than fit inline.
    fn with_capacity(capacity: int) -> String {
        if capacity <= 23 { String::new() } else { String { repr: StringRepr::Heap(Buf::with_capacity(capacity)) } }
    }

    // A `String` of the text `s`.
    fn from_str(s: &str) -> String {
        let mut out = String::with_capacity(s.len());
        out.push_str(s);
        out
    }

    // How many bytes it can hold before it grows: never fewer than the 23 inline.
    fn capacity(&self) -> int {
        match &self.repr {
            StringRepr::Inline(_, _) => 23,
            StringRepr::Heap(b)      => b.capacity(),
        }
    }

    // Its length in bytes.
    fn len(&self) -> int {
        match &self.repr {
            StringRepr::Inline(_, n) => {
                let k: int = *n;
                k
            }
            StringRepr::Heap(b) => b.len(),
        }
    }

    // Its `i`th byte.
    fn byte(&self, i: int) -> u8 {
        match &self.repr {
            StringRepr::Inline(bytes, _) => bytes[i],
            StringRepr::Heap(b)          => b.as_slice()[i],
        }
    }

    // Its text's bytes, which are UTF-8 (`text.bytes.1`).
    fn as_bytes(&self) -> &[u8] {
        self.as_str().as_bytes()
    }

    fn as_str(&self) -> &str {
        match &self.repr {
            StringRepr::Inline(bytes, n) => {
                let k: int = *n;
                str::view (bytes, k)
            }
            StringRepr::Heap(b) => str::view (b.as_slice(), b.len()),
        }
    }

    // Adds byte `b` at the end; when the inline room is full the bytes move to the heap, and a
    // full heap buffer doubles.
    fn push_byte(&mut self, b: u8) {
        match &mut self.repr {
            StringRepr::Inline(bytes, n) => {
                let k: int = *n;
                if k < 23 {
                    bytes[k] = b;
                    *n = *n + 1;
                    return;
                }
            }
            StringRepr::Heap(buf) => {
                if buf.len() == buf.capacity() {
                    buf.set_capacity(buf.capacity() * 2);
                }
                buf.push(b);
                return;
            }
        }
        let mut buf: Buf<u8> = Buf::with_capacity(46);
        let mut i = 0;
        while i < 23 {
            buf.push(self.byte(i));
            i += 1;
        }
        buf.push(b);
        self.repr = StringRepr::Heap(buf);
    }

    fn push_str(&mut self, s: &str) {
        let mut i = 0;
        while i < s.len() {
            self.push_byte(s.byte_at(i));
            i += 1;
        }
    }

    // `s` written as a hole's format spec says (`expr.fmt.spec.1`): cut to its first `keep`
    // characters unless `keep` is -1, then filled with `fill` to `width` characters, the text
    // to the left (`align` 0), centred (1) or to the right (2); or, with `zero`, filled with
    // `0`s after a leading sign.
    fn push_padded(&mut self, s: String, fill: char, align: int, width: int, zero: bool, keep: int) {
        let s = s.as_str();
        let mut end = 0;
        let mut count = 0;
        while end < s.len() && (keep < 0 || count < keep) {
            let c = s.char_at_byte(end) ?! "a character starts at each character's end";
            end += c.len_utf8();
            count += 1;
        }
        let room = if width > count { width - count } else { 0 };
        if zero {
            let mut sign = if end > 0 && (s.byte_at(0) == 45 || s.byte_at(0) == 43) { 1 } else { 0 };
            // And a base's prefix (`{n:#06x}` is `0x002a`).
            if sign + 1 < end && s.byte_at(sign) == 48 {
                let p = s.byte_at(sign + 1);
                if p == 120 || p == 111 || p == 98 {
                    sign += 2;
                }
            }
            self.push_str(s.bytes_between(0, sign));
            for _ in 0..room {
                self.push('0');
            }
            self.push_str(s.bytes_between(sign, end));
            return;
        }
        let before = if align == 0 { 0 } else if align == 1 { room / 2 } else { room };
        for _ in 0..before {
            self.push(fill);
        }
        self.push_str(s.bytes_between(0, end));
        for _ in 0..room - before {
            self.push(fill);
        }
    }

    // `+` before a number's text that has no `-` (`{x:+}`, `expr.fmt.spec.4`).
    fn sign_plus(&mut self) {
        if self.len() == 0 || self.as_str().byte_at(0) != 45 {
            let digits = replace(self, String::new());
            self.push('+');
            self.push_str(digits.as_str());
        }
    }

    // Adds `c`, encoded as UTF-8: one to four bytes.
    fn push(&mut self, c: char) {
        let n = c.len_utf8();
        let mut i = 0;
        while i < n {
            self.push_byte(utf8_byte(c, i));
            i += 1;
        }
    }

    // Takes off its last character.
    fn pop(&mut self) -> Option<char> {
        let n = self.len();
        if n == 0 {
            return None;
        }
        // Back over the continuation bytes (`10xxxxxx`) to where the character starts.
        let mut start = n - 1;
        while start > 0 && self.byte(start) & 0xC0 == 0x80 {
            start -= 1;
        }
        let c = self.as_str().char_at_byte(start);
        self.cut(start);
        c
    }

    // Keeps its first `len` bytes.
    fn cut(&mut self, len: int) {
        match &mut self.repr {
            StringRepr::Inline(_, n) => {
                *n = len.truncate::<u8>();
            }
            StringRepr::Heap(buf) => {
                while buf.len() > len {
                    buf.pop();
                }
            }
        }
    }

    fn clear(&mut self) {
        self.cut(0);
    }

    fn is_empty(&self) -> bool {
        self.len() == 0
    }

    fn starts_with<P: Pattern>(&self, prefix: P) -> bool {
        self.as_str().starts_with(prefix)
    }

    fn ends_with<P: Pattern>(&self, suffix: P) -> bool {
        self.as_str().ends_with(suffix)
    }

    fn contains<P: Pattern>(&self, part: P) -> bool {
        self.as_str().contains(part)
    }

    fn trim(&self) -> &str {
        self.as_str().trim()
    }

    fn to_uppercase(&self) -> String {
        self.as_str().to_uppercase()
    }

    fn to_lowercase(&self) -> String {
        self.as_str().to_lowercase()
    }
}

impl FromIterator<char> for String {
    fn from_iter<I: Iterator<Item = char>>(iter: I) -> String with fail(I::Fails) {
        let mut s = String::new();
        let mut it = iter;
        while let Some(c) = it.next() {
            s.push(c);
        }
        s
    }
}

// What `contains`, `starts_with` and `ends_with` look for (`text.pattern.1`): a string or a
// character.
trait Pattern {
    // How many bytes it is.
    fn pattern_len(&self) -> int;
    // Its `i`th byte.
    fn pattern_byte(&self, i: int) -> u8;
}

impl Pattern for &str {
    fn pattern_len(&self) -> int {
        self.len()
    }
    fn pattern_byte(&self, i: int) -> u8 {
        self.byte_at(i)
    }
}

impl Pattern for &String {
    fn pattern_len(&self) -> int {
        self.len()
    }
    fn pattern_byte(&self, i: int) -> u8 {
        self.byte(i)
    }
}

impl Pattern for char {
    fn pattern_len(&self) -> int {
        self.len_utf8()
    }
    fn pattern_byte(&self, i: int) -> u8 {
        utf8_byte(*self, i)
    }
}

impl Clone for String {
    fn clone(&self) -> String {
        String::from_str(self.as_str())
    }
}

// Byte `i` of `c`'s UTF-8 encoding.
fn utf8_byte(c: char, i: int) -> u8 {
    let code = c.code();
    let n = c.len_utf8();
    if n == 1 {
        return code.truncate::<u8>();
    }
    // The first byte holds the length and the top bits; each other byte six bits.
    let shift = 6 * (n - 1 - i);
    if i == 0 {
        let lead = match n {
            2 => 0xC0,
            3 => 0xE0,
            _ => 0xF0,
        };
        (lead | (code >> shift)).truncate::<u8>()
    } else {
        (0x80 | ((code >> shift) & 0x3F)).truncate::<u8>()
    }
}

impl PartialEq for String {
    fn eq(&self, other: &String) -> bool {
        self.as_str() == other.as_str()
    }
}

impl Eq for String {}

impl PartialOrd for String {
    fn partial_cmp(&self, other: &String) -> Option<Ordering> {
        Some(self.cmp(other))
    }
}

impl Ord for String {
    fn cmp(&self, other: &String) -> Ordering {
        self.as_str().cmp(other.as_str())
    }
}

// A string's characters, in order.
view Chars {
    text: &str,
    at: int,
}

impl Iterator for Chars {
    type Item = char;
    fn next(&mut self) -> Option<char> {
        match self.text.char_at_byte(self.at) {
            Some(c) => {
                self.at += c.len_utf8();
                Some(c)
            }
            None => None,
        }
    }
}

// The characters of text in order, each with its position (`text.find.2`).
view CharIndices {
    text: &str,
    at: int,
}

impl Iterator for CharIndices {
    type Item = (StrPos, char);
    fn next(&mut self) -> Option<(StrPos, char)> {
        match self.text.char_at_byte(self.at) {
            Some(c) => {
                let p = StrPos { text: self.text, at: self.at };
                self.at += c.len_utf8();
                Some((p, c))
            }
            None => None,
        }
    }
}

// A position in text (`text.pos.1`): a byte offset on a character boundary of the text it was
// found in, which it borrows, so the text cannot change while it is live. Slicing other text with
// it is an error where the check sees both texts (E0316), and traps where it does not.
view StrPos {
    text: &str,
    at: int,
}

impl Clone for StrPos {
    fn clone(&self) -> StrPos {
        *self
    }
}

impl Copy for StrPos {}

impl StrPos {
    // Its byte offset in its text.
    fn offset(self) -> int {
        self.at
    }

    // The position just past `part`, which is at this one; traps if it is not.
    fn after<P: Pattern>(self, part: P) -> StrPos {
        assert(self.text.has_at(&part, self.at));
        StrPos { text: self.text, at: self.at + part.pattern_len() }
    }
}

// A byte offset that is not a character boundary of the text, or is past its end (`text.pos.1`).
struct NotABoundary {
    offset: int,
}

impl str {
    // Where the text starts, and where it ends (`text.pos.1`).
    fn start(&self) -> StrPos {
        StrPos { text: self, at: 0 }
    }

    fn end(&self) -> StrPos {
        StrPos { text: self, at: self.len() }
    }

    // Where `part` first is, if it is (`text.find.1`).
    fn find<P: Pattern>(&self, part: P) -> Option<StrPos> {
        let mut at = 0;
        while at + part.pattern_len() <= self.len() {
            if self.has_at(&part, at) {
                return Some(StrPos { text: self, at });
            }
            at += 1;
        }
        None
    }

    // Where `part` last is, if it is.
    fn rfind<P: Pattern>(&self, part: P) -> Option<StrPos> {
        let mut at = self.len() - part.pattern_len();
        while at >= 0 {
            if self.has_at(&part, at) {
                return Some(StrPos { text: self, at });
            }
            at -= 1;
        }
        None
    }

    // The text before the first `part`, and the text after it, if it is there.
    fn split_once<P: Pattern>(&self, part: P) -> Option<(&str, &str)> {
        let n = part.pattern_len();
        match self.find(part) {
            Some(at) => Some((self.bytes_between(0, at.at), self.bytes_between(at.at + n, self.len()))),
            None     => None,
        }
    }

    // Whether byte `offset` is a character boundary: the start of a character, or the end.
    fn is_boundary(&self, offset: int) -> bool {
        if offset == self.len() {
            return true;
        }
        offset >= 0 && offset < self.len() && (self.byte_at(offset) & 0xC0) != 0x80
    }

    // The position at byte `offset`, an offset that came from outside (`text.pos.1`).
    fn pos_at(&self, offset: int) -> StrPos with fail(NotABoundary) {
        if !self.is_boundary(offset) {
            fail(NotABoundary { offset });
        }
        StrPos { text: self, at: offset }
    }

    // The text between two byte offsets, which must be boundaries, in order.
    fn slice_bytes(&self, r: Range) -> &str with fail(NotABoundary) {
        if !self.is_boundary(r.start) {
            fail(NotABoundary { offset: r.start });
        }
        if !self.is_boundary(r.end) || r.end < r.start {
            fail(NotABoundary { offset: r.end });
        }
        self.bytes_between(r.start, r.end)
    }

    // `&s[a..b]` (`text.pos.1`): the text between two of its positions; traps if one is not
    // this text's (the same text, not only the same characters), or they are out of order.
    fn between(&self, a: StrPos, b: StrPos) -> &str {
        assert(a.text.same_text(self) && b.text.same_text(self) && a.at <= b.at);
        self.bytes_between(a.at, b.at)
    }

    // Whether `other` is this text, where it is: not only the same characters.
    #[intrinsic]
    fn same_text(&self, other: &str) -> bool;

    // The text between two byte offsets that are boundaries.
    #[intrinsic]
    fn bytes_between(&self, a: int, b: int) -> &str;

    // Bytes that are UTF-8, as text (`text.utf8.1`).
    fn from_utf8(bytes: &[u8]) -> &str with fail(Utf8Error) {
        let n = utf8_valid_up_to(bytes);
        if n < bytes.len() {
            fail(Utf8Error { valid_up_to: n });
        }
        str::view (bytes, n)
    }

    fn chars(&self) -> Chars {
        Chars { text: self, at: 0 }
    }

    fn char_indices(&self) -> CharIndices {
        CharIndices { text: self, at: 0 }
    }

    // The character that starts at byte `at`, if one does (for `Chars`).
    #[intrinsic]
    fn char_at_byte(&self, at: int) -> Option<char>;
}

impl String {
    fn chars(&self) -> Chars {
        self.as_str().chars()
    }

    fn char_indices(&self) -> CharIndices {
        self.as_str().char_indices()
    }

    // As `str`'s (`text.pos.1`, `text.find.1`): the positions borrow the string.
    fn start(&self) -> StrPos {
        self.as_str().start()
    }

    fn end(&self) -> StrPos {
        self.as_str().end()
    }

    fn find<P: Pattern>(&self, part: P) -> Option<StrPos> {
        self.as_str().find(part)
    }

    fn rfind<P: Pattern>(&self, part: P) -> Option<StrPos> {
        self.as_str().rfind(part)
    }

    fn split_once<P: Pattern>(&self, part: P) -> Option<(&str, &str)> {
        self.as_str().split_once(part)
    }

    fn pos_at(&self, offset: int) -> StrPos with fail(NotABoundary) {
        self.as_str().pos_at(offset)?
    }

    fn slice_bytes(&self, r: Range) -> &str with fail(NotABoundary) {
        self.as_str().slice_bytes(r)?
    }

    // The bytes as text, if they are UTF-8; else the bytes are given back (`text.utf8.1`).
    fn from_utf8(bytes: Vec<u8>) -> String with fail(FromUtf8Error) {
        let n = utf8_valid_up_to(bytes.as_slice());
        if n < bytes.len() {
            fail(FromUtf8Error { bytes, valid_up_to: n });
        }
        String::from_str(str::view (bytes.as_slice(), n))
    }
}

// Bytes that are not UTF-8 (`text.utf8.1`): how many from the start are.
struct Utf8Error {
    valid_up_to: int,
}

// The same, for `String::from_utf8`, which gives the bytes back.
struct FromUtf8Error {
    bytes: Vec<u8>,
    valid_up_to: int,
}

// How many of `bytes`, from the start, are UTF-8 (`text.utf8.1`): each character its shortest
// encoding, and no surrogate.
fn utf8_valid_up_to(bytes: &[u8]) -> int {
    let n = bytes.len();
    let mut i = 0;
    while i < n {
        let b = bytes[i];
        let (len, lo, hi) = if b < 0x80 {
            (1, 0x80, 0xBF)
        } else if b >= 0xC2 && b <= 0xDF {
            (2, 0x80, 0xBF)
        } else if b == 0xE0 {
            (3, 0xA0, 0xBF)
        } else if b == 0xED {
            (3, 0x80, 0x9F)
        } else if b >= 0xE1 && b <= 0xEF {
            (3, 0x80, 0xBF)
        } else if b == 0xF0 {
            (4, 0x90, 0xBF)
        } else if b >= 0xF1 && b <= 0xF3 {
            (4, 0x80, 0xBF)
        } else if b == 0xF4 {
            (4, 0x80, 0x8F)
        } else {
            return i;
        };
        if i + len > n {
            return i;
        }
        let mut k = 1;
        while k < len {
            let c = bytes[i + k];
            let (l, h) = if k == 1 { (lo, hi) } else { (0x80, 0xBF) };
            if c < l || c > h {
                return i;
            }
            k += 1;
        }
        i += len;
    }
    n
}

// `RcStr` (`text.rcstr.1`): a slice of shared text, a reference-counted `String` and the byte
// range of it the slice is. `s.to_rcstr()` moves a `String` into one; `r.slice(a, b)` and
// `r.share()` give another slice of the same text, adding one to the count and copying nothing,
// so a parser can keep its tokens' text in owned data.
struct RcStr {
    buf: Rc<String>,
    start: int,
    end: int,
}

impl String {
    // The whole string, shared (`text.rcstr.1`).
    fn to_rcstr(self) -> RcStr {
        let end = self.len();
        RcStr { buf: self.to_rc(), start: 0, end }
    }
}

impl RcStr {
    // The slice's text: its positions are those `slice` takes.
    fn as_str(&self) -> &str {
        self.buf.deref().as_str().bytes_between(self.start, self.end)
    }

    // The text between two positions of `self.as_str()`, sharing the buffer; traps as `&s[a..b]`
    // does if a position is not one of its text's, or they are out of order.
    fn slice(&self, a: StrPos, b: StrPos) -> RcStr {
        let _ = self.as_str().between(a, b);
        RcStr { buf: self.buf.share(), start: self.start + a.offset(), end: self.start + b.offset() }
    }

    // Another owner of the same slice.
    fn share(&self) -> RcStr {
        RcStr { buf: self.buf.share(), start: self.start, end: self.end }
    }

    // Its length in bytes.
    fn len(&self) -> int {
        self.end - self.start
    }

    fn is_empty(&self) -> bool {
        self.end == self.start
    }

    // A new `String` of its text.
    fn to_string(&self) -> String {
        String::from_str(self.as_str())
    }
}

// Cloned as `share`, and compared, hashed and shown as its text.
impl Clone for RcStr {
    fn clone(&self) -> RcStr {
        self.share()
    }
}

impl PartialEq for RcStr {
    fn eq(&self, other: &RcStr) -> bool {
        PartialEq::eq(self.as_str(), other.as_str())
    }
}

impl Eq for RcStr {}

impl PartialOrd for RcStr {
    fn partial_cmp(&self, other: &RcStr) -> Option<Ordering> {
        Some(Ord::cmp(self.as_str(), other.as_str()))
    }
}

impl Ord for RcStr {
    fn cmp(&self, other: &RcStr) -> Ordering {
        Ord::cmp(self.as_str(), other.as_str())
    }
}

impl Hash for RcStr {
    fn hash<H: Hasher>(&self, state: &mut H) {
        Hash::hash(self.as_str(), state);
    }
}

impl Display for RcStr {
    fn fmt(&self, out: &mut dyn TextWrite) {
        out.write_str(self.as_str());
    }
}

impl Debug for RcStr {
    fn fmt(&self, out: &mut dyn TextWrite) {
        Debug::fmt(self.as_str(), out);
    }
}

// What padding a hole needs to know of its text before it is written (`text.write.2`): how many
// characters it has, and how many lead it (a sign, then a base's prefix: `-0x`), which zeros
// go after. `fmt"…"` writes a padded hole once into one of these, then once onto its sink.
struct Measure {
    chars: int,
    lead: int,
    // The first characters, while they may still be a lead.
    first: char,
    second: char,
}

fn measure_new() -> Measure {
    Measure { chars: 0, lead: 0, first: '\0', second: '\0' }
}

impl TextWrite for Measure {
    fn write_str(&mut self, s: &str) {
        for c in s.chars() {
            let i = self.chars;
            self.chars += 1;
            let sign = self.first == '-' || self.first == '+';
            if i == 0 {
                self.first = c;
                if c == '-' || c == '+' {
                    self.lead = 1;
                }
            } else if i == 1 {
                self.second = c;
            }
            // `0x`, `0o` or `0b`, after a sign or not.
            let at = if sign { 2 } else { 1 };
            let zero = if sign { self.second == '0' } else { self.first == '0' };
            if i == at && zero && (c == 'x' || c == 'o' || c == 'b') {
                self.lead = at + 1;
            }
        }
    }
}

// A hole's text written onto `out`, padded (`expr.fmt.spec.1`): `fill` before it (`align` 2),
// after it (0) or on both sides (1) to `width` characters, or zeros after its lead for `zero`;
// cut to `keep` characters if `keep` is not -1; with `+` first if `plus` and it has no sign.
view Padded {
    out: &mut dyn TextWrite,
    // Characters written so far, of the hole's (and the `+`).
    at: int,
    keep: int,
    // Where the zeros go, and how many, while they are still to write.
    zeros_at: int,
    zeros: int,
    // Fill still to write after the text.
    after: int,
    fill: char,
}

fn padded_start(out: &mut dyn TextWrite, m: &Measure, fill: char, align: int, width: int, zero: bool, keep: int, plus: bool) -> Padded {
    let plus = plus && m.first != '-';
    let total = m.chars + if plus { 1 } else { 0 };
    let shown = if keep >= 0 && keep < total { keep } else { total };
    let room = if width > shown { width - shown } else { 0 };
    let mut p = Padded { out, at: 0, keep, zeros_at: 0, zeros: 0, after: 0, fill };
    if zero {
        p.zeros_at = m.lead + if plus { 1 } else { 0 };
        p.zeros = room;
    } else {
        let before = if align == 0 { 0 } else if align == 1 { room / 2 } else { room };
        let mut i = 0;
        while i < before {
            p.out.write_char(fill);
            i += 1;
        }
        p.after = room - before;
    }
    if plus {
        p.write_str("+");
    }
    p
}

impl Padded {
    fn zeros_now(&mut self) {
        while self.zeros > 0 {
            self.out.write_char('0');
            self.zeros -= 1;
        }
    }

    // The fill after the text, and the zeros if the text was all lead.
    fn finish(&mut self) {
        self.zeros_now();
        let mut i = 0;
        while i < self.after {
            self.out.write_char(self.fill);
            i += 1;
        }
    }
}

impl TextWrite for Padded {
    fn write_str(&mut self, s: &str) {
        // Each run of `s` between the points where zeros go or the text is cut, as one write.
        let mut start = 0;
        let mut end = 0;
        while end < s.len() {
            if self.keep >= 0 && self.at >= self.keep {
                break;
            }
            if self.zeros > 0 && self.at == self.zeros_at {
                if end > start {
                    self.out.write_str(s.bytes_between(start, end));
                }
                start = end;
                self.zeros_now();
            }
            let c = s.char_at_byte(end) ?! "a character starts at each character's end";
            end += c.len_utf8();
            self.at += 1;
        }
        if end > start {
            self.out.write_str(s.bytes_between(start, end));
        }
    }
}

// A value read from its text (`text.fromstr.1`), as a tagged literal's typed field is
// (`comptime.tag.fields.3`): `None` if the text is not one.
trait FromStr {
    fn from_str(s: &str) -> Option<Self>;
}

// An integer's decimal digits, after an optional `-` or `+`, of a value in its type's range and
// in `int`'s.
#[derive_for(int, i8, i16, i32, i128, u8, u16, u32, u64, u128, isize, usize)]
const fn int_from_str(t: type) -> Impl<FromStr> {
    impl FromStr for t {
        fn from_str(s: &str) -> Option<t> {
            let n = s.len();
            let mut i = 0;
            let negative = n > 0 && s.byte_at(0) == 45;
            if n > 0 && (s.byte_at(0) == 45 || s.byte_at(0) == 43) {
                i = 1;
            }
            if i == n {
                return None;
            }
            // Gathered negated, so the least `int` is read too.
            let mut v: int = 0;
            while i < n {
                let b = s.byte_at(i);
                if b < 48 || b > 57 {
                    return None;
                }
                let d = (b - 48).checked_to::<int>()?;
                v = v
                    .checked_mul(10)?
                    .checked_sub(d)?;
                i += 1;
            }
            if !negative {
                v = 0.checked_sub(v)?;
            }
            v.checked_to::<t>()
        }
    }
}

// `true` or `false`.
impl FromStr for bool {
    fn from_str(s: &str) -> Option<bool> {
        if s == "true" { Some(true) } else if s == "false" { Some(false) } else { None }
    }
}

// One character.
impl FromStr for char {
    fn from_str(s: &str) -> Option<char> {
        let mut cs = s.chars();
        let Some(c) = cs.next() else {
            return None;
        };
        if cs.next().is_some() { None } else { Some(c) }
    }
}

// The text as it is.
impl FromStr for String {
    fn from_str(s: &str) -> Option<String> {
        Some(s.to_string())
    }
}
