// Part of the prelude (`../prelude.md`): `Index`, `Deref`, `Box` and `Rc`.

// Indexing: `xs[i]` on a type other than an array or slice is `*xs.index(i)`, or
// `*xs.index_mut(i)` where the element is changed. `i` is an `int` unless an impl takes another
// type (`impl Index<Key> for Table`), and `xs[a..b]` is `Index<Range>`'s (`expr.index.trait.1`).

trait Index<Idx = int> {
    type Output;
    fn index(&self, i: Idx) -> &Self::Output;
}

trait IndexMut<Idx = int>: Index<Idx> {
    fn index_mut(&mut self, i: Idx) -> &mut Self::Output;
}

// Dereferencing (`type.box.1`): `*x` on a type other than a borrow is `*x.deref()`, or
// `*x.deref_mut()` where the value is changed.

trait Deref {
    type Output;
    fn deref(&self) -> &Self::Output;
}

trait DerefMut: Deref {
    fn deref_mut(&mut self) -> &mut Self::Output;
}

// `Box<T>`: one value kept on the heap, owned (`type.box.1`); `Box<dyn Trait>` owns a value of
// any type that implements the trait (`type.box.dyn.1`). Its value is dropped with it.
struct Box<T> {
    buf: Buf<T>,
}

impl<T> Box<T> {
    fn new(x: T) -> Box<T> {
        let mut buf = Buf::with_capacity(1);
        buf.push(x);
        Box { buf }
    }

    // Its value, out of the box.
    fn into_inner(self) -> T {
        let mut buf = self.buf;
        buf.pop() ?! "a box holds its value"
    }
}

impl<T> Deref for Box<T> {
    type Output = T;
    fn deref(&self) -> &T {
        &self.buf.as_slice()[0]
    }
}

impl<T> DerefMut for Box<T> {
    fn deref_mut(&mut self) -> &mut T {
        &mut self.buf.as_mut_slice()[0]
    }
}

// `Rc<T>`: a value shared by counting its owners (`rc.1`). `x.to_rc()` moves `x` into an
// allocation; `rc.share()` gives another owner of the same value; the value is dropped with its
// last owner. What an `Rc` holds cannot be changed through it (`rc.immutable.1`). A `Weak<T>`
// (`rc.weak.1`) keeps the allocation but not the value: `upgrade` gives an owner while there is
// one.
//
// The counts are biased to the task that made the allocation (`specs/memory.md`: Biased
// reference counting): that task counts its owners with plain arithmetic, and every other task
// with atomic arithmetic on a count of its own. The owners are the two counts together. Under the
// deterministic runtime one task runs at a time (`task.sched.1`), so any task may read the
// owner's count. Under the parallel runtime no task is any allocation's owner (`__task_id` is not
// the number of a task an `Rc` was made in), so every count is the atomic one, and the owner's
// stays as it was.

// The allocation: the task it is biased to, the owners that task counts, the owners the other
// tasks count (atomically; below 0 while that task counts owners the others have let go), the
// weak count (atomically; the owners together hold one), and the value while an owner lives.
struct RcBox<T> {
    owner: int,
    count: int,
    shared: int,
    weak: int,
    value: Option<T>,
}

struct Rc<T> {
    p: *mut RcBox<T>,
}

struct Weak<T> {
    p: *mut RcBox<T>,
}

// `.to_rc()`, on any value.
trait ToRc {
    fn to_rc(self) -> Rc<Self>;
}

impl<T> ToRc for T {
    fn to_rc(self) -> Rc<T> {
        // Under the parallel runtime, no task's: `__task_id` there is no task's number, and -1
        // is not it either, so no task takes the owner's count.
        let t = __task_id();
        let owner = if t < 0 { -1 } else { t };
        let b = Box::new(RcBox { owner, count: 1, shared: 0, weak: 1, value: Some(self) });
        Rc { p: core::ffi::into_raw(b) }
    }
}

// How many owners the allocation at `p` has: both counts.
fn rc_owners<T>(p: *mut RcBox<T>) -> int {
    unsafe("p is live; its owner's count changes only while one task runs at a time") {
        (*p).count + core::atomic::load(&(*p).shared, core::atomic::Ordering::Acquire)
    }
}

impl<T> Rc<T> {
    // Another owner of the same value: the count goes up by one, and nothing is copied.
    fn share(&self) -> Rc<T> {
        // Written out here, in `drop` and in `upgrade`, not called: they are what an `Rc` costs.
        let p = self.p;
        unsafe("p is a live allocation: this owner keeps it") {
            if core::atomic::load(&(*p).owner, core::atomic::Ordering::Relaxed) == __task_id() {
                (*p).count += 1;
            } else {
                core::atomic::fetch_add(&mut (*p).shared, 1, core::atomic::Ordering::Relaxed);
            }
        }
        Rc { p }
    }

    // A weak handle to the value, which does not keep it alive.
    fn weak(&self) -> Weak<T> {
        unsafe("p is a live allocation: this owner keeps it") {
            core::atomic::fetch_add(&mut (*self.p).weak, 1, core::atomic::Ordering::Relaxed);
        }
        Weak { p: self.p }
    }

    // Whether `a` and `b` share one value (`rc.1`): the only test of identity.
    fn ptr_eq(a: &Rc<T>, b: &Rc<T>) -> bool {
        core::ptr::addr_eq(a.p, b.p)
    }

    // How many owners the value has.
    fn strong_count(rc: &Rc<T>) -> int {
        rc_owners(rc.p)
    }

    // How many weak handles the value has.
    fn weak_count(rc: &Rc<T>) -> int {
        unsafe("p is a live allocation: rc keeps it") {
            core::atomic::load(&(*rc.p).weak, core::atomic::Ordering::Acquire) - 1
        }
    }

    // The value, if `rc` is its only owner (`rc.unwrap.1`); otherwise `rc` back. Its weak
    // handles see it gone.
    fn try_unwrap(rc: Rc<T>) -> Result<T, Rc<T>> {
        if Rc::strong_count(&rc) != 1 {
            return Err(rc);
        }
        let value = unsafe("p is a live allocation: rc, its only owner, keeps it") {
            replace(&mut (*rc.p).value, None)
        };
        // The last owner goes, its value already taken: only the allocation is let go.
        drop(rc);
        Ok(value ?! "an owned rc has its value")
    }
}

impl<T> Deref for Rc<T> {
    type Output = T;
    fn deref(&self) -> &T {
        unsafe("p is a live allocation, and its value lives while an owner does") {
            let v = match &(*self.p).value {
                Some(v) => Some(v),
                None    => None,
            };
            v ?! "an owned rc has its value"
        }
    }
}

// The last owner drops the value; the allocation goes with the last weak handle.
impl<T> Drop for Rc<T> {
    fn drop(self) {
        let p = self.p;
        let last = unsafe("p is a live allocation: this owner keeps it") {
            if core::atomic::load(&(*p).owner, core::atomic::Ordering::Relaxed) == __task_id() {
                (*p).count -= 1;
                (*p).count + core::atomic::load(&(*p).shared, core::atomic::Ordering::Acquire) == 0
            } else {
                // What this decrement left, from its own atomic step: of tasks dropping owners at
                // once, one sees the last go.
                let was = core::atomic::fetch_add(&mut (*p).shared, -1, core::atomic::Ordering::AcqRel);
                (*p).count + was - 1 == 0
            }
        };
        if last {
            let value = unsafe("the last owner: nothing borrows the value") {
                replace(&mut (*p).value, None)
            };
            drop(value);
            rc_release(p);
        }
    }
}

// Lets go of one weak count of the allocation at `p`, freeing it with the last.
fn rc_release<T>(p: *mut RcBox<T>) {
    let last = unsafe("p is a live allocation: the caller holds a weak count") {
        core::atomic::fetch_add(&mut (*p).weak, -1, core::atomic::Ordering::AcqRel) == 1
    };
    if last {
        drop(unsafe("the last count: into_raw's pointer, given back once") {
            core::ffi::from_raw(p)
        });
    }
}

// A share, so that code generic over `Clone` takes an `Rc` (`rc.clone.1`); written `.clone()`
// on an `Rc` it is refused, for `.share()`.
impl<T> Clone for Rc<T> {
    fn clone(&self) -> Rc<T> {
        self.share()
    }
}

impl<T> Weak<T> {
    // Another weak handle to the same value.
    fn share(&self) -> Weak<T> {
        unsafe("p is a live allocation: this handle keeps it") {
            core::atomic::fetch_add(&mut (*self.p).weak, 1, core::atomic::Ordering::Relaxed);
        }
        Weak { p: self.p }
    }

    // An owner of the value, if it still has one.
    fn upgrade(&self) -> Option<Rc<T>> {
        let p = self.p;
        unsafe("p is a live allocation: this handle keeps it") {
            if core::atomic::load(&(*p).owner, core::atomic::Ordering::Relaxed) == __task_id() {
                if rc_owners(p) == 0 {
                    return None;
                }
                (*p).count += 1;
                return Some(Rc { p });
            }
            // Another owner, counted only while there is one: a step that finds the count
            // changed by another task's tries again.
            loop {
                let n = core::atomic::load(&(*p).shared, core::atomic::Ordering::Acquire);
                if (*p).count + n <= 0 {
                    return None;
                }
                let ordering = core::atomic::Ordering::AcqRel;
                if core::atomic::compare_exchange(&mut (*p).shared, n, n + 1, ordering, ordering).is_ok() {
                    return Some(Rc { p });
                }
            }
        }
    }
}

impl<T> Drop for Weak<T> {
    fn drop(self) {
        rc_release(self.p);
    }
}

impl<T> Clone for Weak<T> {
    fn clone(&self) -> Weak<T> {
        self.share()
    }
}

// Compared, hashed and shown as the value.
impl<T: PartialEq> PartialEq for Rc<T> {
    fn eq(&self, other: &Rc<T>) -> bool {
        PartialEq::eq(self.deref(), other.deref())
    }
}

impl<T: Eq> Eq for Rc<T> {}

impl<T: PartialOrd> PartialOrd for Rc<T> {
    fn partial_cmp(&self, other: &Rc<T>) -> Option<Ordering> {
        PartialOrd::partial_cmp(self.deref(), other.deref())
    }
}

impl<T: Ord> Ord for Rc<T> {
    fn cmp(&self, other: &Rc<T>) -> Ordering {
        Ord::cmp(self.deref(), other.deref())
    }
}

impl<T: Hash> Hash for Rc<T> {
    fn hash<H: Hasher>(&self, state: &mut H) {
        Hash::hash(self.deref(), state);
    }
}

impl<T: Debug> Debug for Rc<T> {
    fn fmt(&self, out: &mut dyn TextWrite) {
        Debug::fmt(self.deref(), out);
    }
}

impl<T> Debug for Weak<T> {
    fn fmt(&self, out: &mut dyn TextWrite) {
        out.write_str("(Weak)");
    }
}
