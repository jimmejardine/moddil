// Part of the prelude (`../prelude.md`): `ExitCode`, the log, refinements, and what a wrapper
// is told of the function it wraps.

// What `main` can give back (`main.exit.1`): each `sysexits.h` code by name, or another.
#[derive(Debug, Clone, PartialEq)]
enum ExitCode {
    Ok,
    Usage,
    DataErr,
    NoInput,
    NoUser,
    NoHost,
    Unavailable,
    Software,
    OsErr,
    OsFile,
    CantCreate,
    IoErr,
    TempFail,
    Protocol,
    NoPerm,
    Config,
    Other(int),
}

impl ExitCode {
    // The exit code `n`, by its name if it has one.
    fn new(n: int) -> ExitCode {
        match n {
            0  => ExitCode::Ok,
            64 => ExitCode::Usage,
            65 => ExitCode::DataErr,
            66 => ExitCode::NoInput,
            67 => ExitCode::NoUser,
            68 => ExitCode::NoHost,
            69 => ExitCode::Unavailable,
            70 => ExitCode::Software,
            71 => ExitCode::OsErr,
            72 => ExitCode::OsFile,
            73 => ExitCode::CantCreate,
            74 => ExitCode::IoErr,
            75 => ExitCode::TempFail,
            76 => ExitCode::Protocol,
            77 => ExitCode::NoPerm,
            78 => ExitCode::Config,
            n  => ExitCode::Other(n),
        }
    }

    // The number the process exits with.
    fn code(&self) -> int {
        match self {
            ExitCode::Ok          => 0,
            ExitCode::Usage       => 64,
            ExitCode::DataErr     => 65,
            ExitCode::NoInput     => 66,
            ExitCode::NoUser      => 67,
            ExitCode::NoHost      => 68,
            ExitCode::Unavailable => 69,
            ExitCode::Software    => 70,
            ExitCode::OsErr       => 71,
            ExitCode::OsFile      => 72,
            ExitCode::CantCreate  => 73,
            ExitCode::IoErr       => 74,
            ExitCode::TempFail    => 75,
            ExitCode::Protocol    => 76,
            ExitCode::NoPerm      => 77,
            ExitCode::Config      => 78,
            ExitCode::Other(n)    => *n,
        }
    }
}

// The ambient log (`obs.log.1`): write-only, so it needs no effect. For now the interpreters
// print its events to standard error, with their level.
struct Log;

impl Log {
    #[intrinsic]
    fn debug(&self, msg: String);
    #[intrinsic]
    fn info(&self, msg: String);
    #[intrinsic]
    fn warn(&self, msg: String);
    #[intrinsic]
    fn error(&self, msg: String);
}

const log: Log = Log;

// The error `X::new(v)` fails with when `v` is not an `X` (`refine.new.1`): the refined type's
// name, its `where` clause as written, and the value as `Debug` shows it.
#[derive(Debug, Clone, PartialEq)]
struct RefinementError {
    ty: String,
    clause: String,
    value: String,
}

// Every refinement implements `Refined`, built in, and nothing else does (`refine.trait.1`):
// generic code makes a value of a refined type with it. `refine` is the type's `new`.
trait Refined {
    type Base;
    fn refine(v: Self::Base) -> Self with fail(RefinementError);
}

// What a wrapper is told of the function it wraps (`attr.around.info.1`): its path, each
// parameter's name and type, its attributes and its effects, as written.
#[derive(Debug, Clone, PartialEq)]
struct FnInfo {
    path: String,
    params: Vec<ParamInfo>,
    attrs: Vec<String>,
    effects: Vec<String>,
}

#[derive(Debug, Clone, PartialEq)]
struct ParamInfo {
    name: String,
    ty: String,
}

// `compile_error(message, start, end)` (`comptime.error.1`): compile-time code's error, reported
// when compiling with `message` at bytes `start` to `end` of the text of the tagged literal being
// evaluated (or at the const or block). Run when the program runs, it traps.
#[intrinsic]
fn compile_error(message: &str, start: int, end: int) -> !;

// A tagged literal's value whose literal has fields (`comptime.tag.fields.1`), as a regex's named
// groups: the literal can `read` a text into a struct with one field each.
trait TagFields {
    // The fields, asked for while the program is collected: each one's name, and whether every
    // reading has it (a `String` field) or may not (an `Option<String>`).
    fn field_names(&self) -> Vec<(String, bool)>;

    // The fields read from `text`, in `field_names`' order, or `None` if it has none.
    fn field_values(&self, text: &str) -> Option<Vec<Option<String>>>;

    // Each field's type, in `field_names`' order, as text (`comptime.tag.fields.3`): `"String"`,
    // `"Match"` (where it is in the text read, a `core::text::Match`), or a type the prelude's
    // `FromStr` reads (`"int"`, `"u8"`, `"bool"`, `"char"`). A field given none is a `String`.
    fn field_types(&self) -> Vec<String> {
        Vec::new()
    }

    // Where each field is in `text`, in `field_names`' order: its first byte and the byte after
    // its last, or `None` where a reading has none; `None` if `text` has no fields. A literal
    // with a `Match` field reads it from here.
    fn field_spans(&self, text: &str) -> Option<Vec<Option<(int, int)>>> {
        None
    }
}
