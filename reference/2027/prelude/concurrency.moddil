// Part of the prelude (`../prelude.md`): scopes and tasks, channels and time.

// Structured concurrency (`task.scope.1`): `scope` runs its body as its first task, with a handle
// further tasks are spawned into, and ends once every one of them has. A task's errors go to its
// `join`; one that fails with its `Task` dropped, or a failing body, fails the scope, whose other
// tasks are then cancelled (`task.cancel.1`).

// A scope's handle. It holds what its tasks borrow, until the scope ends.
view Scope {
    id: int,
}

// A task spawned into a scope, running closure `F`, which gives a `T`.
view Task<F, T> {
    id: int,
}

// With `isolate: true`, a trap in the scope cancels it, and it fails with `Trapped`
// (`task.isolate.1`); otherwise a trap ends the program. Only an isolated scope's call can fail
// with `Trapped`. With `on: e`, its body runs on executor `e` (`task.executor.1`); otherwise on
// the running task's.
fn scope<F: FnOnce(&mut Scope) -> R, R>(body: F, isolate: bool = false, on: Executor = Executor { id: -1 }) -> R with spawn, fail(Trapped) {
    let mut s = Scope { id: __scope_open(isolate, on.id) };
    __scope_run::<F, R>(&mut s, body)?
}

// Where tasks run (`task.executor.1`): a pool of threads with a priority, which `main` makes from
// the `Cpus` root capability (`moddil/runtime`). Executor 0 is the default one; a task runs on
// its spawner's unless it is spawned `on:` another.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
struct Executor {
    id: int,
}

impl Executor {
    // The executor the running task runs on.
    fn current() -> Executor {
        Executor { id: __executor_of_task() }
    }

    // A new executor: what `moddil/runtime`'s constructors make, of kind `kind` (0 a pool, 1
    // pinned, 2 for blocking calls, 3 affine) on cores `cores` of NUMA node `node` (-1 for any),
    // with priority `priority` (0 low to 3 real-time), busy-polling or not, for up to `threads`
    // threads (0 for one a core). The runtime keeps what it is; under `runtime-sim` that is all.
    fn __new(kind: int, cores: Range, node: int, priority: int, busy_poll: bool, threads: int) -> Executor {
        Executor { id: __executor_new(kind, cores.start, cores.end, node, priority, busy_poll, threads) }
    }
}

#[intrinsic]
fn __executor_of_task() -> int;

#[intrinsic]
fn __executor_new(kind: int, first: int, end: int, node: int, priority: int, busy_poll: bool, threads: int) -> int;

impl Scope {
    // Starts a task running `f`, queued to run when the running task suspends: on executor `on`
    // (`task.executor.1`), or the running task's.
    #[intrinsic]
    fn spawn<F: FnOnce() -> T, T>(&mut self, f: F, on: Executor = Executor { id: -1 }) -> Task<F, T> from f with spawn;

    // Asks the scope's tasks to stop, the scopes inside it first (`task.stop.1`).
    #[intrinsic]
    fn stop(&self);
}

impl<F: FnOnce() -> T, T> Task<F, T> {
    // Waits for the task to end: its result, or its error.
    #[intrinsic]
    fn join(self) -> T with suspend, fail(F::Fails);
}

// A task given up without a `join`: an error it fails with fails its scope.
impl<F, T> Drop for Task<F, T> {
    #[intrinsic]
    fn drop(self);
}

// Lets the other tasks that are ready run first.
#[intrinsic]
fn yield_now() with suspend;

// How a program's tasks run (`task.runtime.1`), installed by `main`'s outermost `with`:
// `with Runtime = Runtime::seeded(42) { … }`. Without one, a program runs under the deterministic
// runtime with seed 0.
struct Runtime {
    seed: int,
    // How many tasks run at once under the parallel runtime: 0 for the deterministic one, -1
    // for one a core.
    workers: int,
}

impl Runtime {
    // The deterministic runtime (`runtime-sim`), one task at a time: the ready tasks run in the
    // order seed `seed` picks, and with 0, first in, first out (`task.sched.1`).
    fn seeded(seed: int) -> Runtime {
        Runtime { seed, workers: 0 }
    }

    // The parallel runtime, its tasks running at once, up to `workers` (one a core if -1): what
    // `moddil/runtime`'s `parallel` gives. The interpreters and WASM run its tasks one at a time.
    fn __parallel(workers: int) -> Runtime {
        Runtime { seed: 0, workers }
    }
}

// Whether the run's tasks run in parallel (`task.runtime.1`): what code that assumes one task at
// a time refuses.
#[intrinsic]
fn __parallel() -> bool;

// What `with Runtime = rt` does before its body.
fn __runtime_install(rt: &Runtime) {
    __install_runtime(rt.seed, rt.workers);
}

#[intrinsic]
fn __install_runtime(seed: int, workers: int);

// Waits, if the word at `p` holds `expected`, until a task unparks `p` (`task.park.1`): what a
// sync cell waits with. A cancelled task unwinds from it.
#[intrinsic]
fn __park(p: *const int, expected: int) with suspend;

// Makes ready up to `n` of the tasks parked on `p`, in the order they parked: how many.
#[intrinsic]
fn __unpark(p: *const int, n: int) -> int;

// The running task's number, which no other task of the run has: what an `Rc` is biased to
// (`rc.1`).
#[intrinsic]
fn __task_id() -> int;

// Waits until the running task's scope, or one around it, has been asked to stop, once the
// scopes inside its scope have ended (`task.stop.1`).
#[intrinsic]
fn stop_requested() with suspend;

// What an isolated scope fails with when a trap ends it: the trap's kind (`overflow`) and where
// it was, as `line:column` in its file.
#[derive(Debug, Clone, PartialEq)]
struct Trapped {
    class: String,
    at: String,
}

impl Display for Trapped {
    fn fmt(&self, out: &mut dyn TextWrite) {
        out.write_str(&self.class);
        out.write_str(" at ");
        out.write_str(&self.at);
    }
}

#[intrinsic]
fn __scope_open(isolate: bool, on: int) -> int;

// Waits until one of a `select`'s operations, described by `ops`, is ready, does it, and gives
// its arm's index (`task.select.1`).
#[intrinsic]
fn __select<T>(ops: T) -> int with suspend;

// Runs the body as the scope's first task, waits for every task of the scope, and gives the
// body's value, or fails with the scope's failure.
#[intrinsic]
fn __scope_run<F: FnOnce(&mut Scope) -> R, R>(s: &mut Scope, body: F) -> R with spawn, fail(Trapped);

// Channels (`task.channel.1`): a bounded queue of values between tasks.

// The error a `send` fails with once its channel's `Receiver` is gone.
#[derive(Debug, Clone, PartialEq)]
struct Closed;

// The sending end of a channel; there may be several.
struct Sender<T> {
    id: int,
}

// The receiving end of a channel.
struct Receiver<T> {
    id: int,
}

// A channel holding up to `capacity` values; with capacity 0, a `send` waits until its value is
// received.
#[intrinsic]
fn channel<T>(capacity: int) -> (Sender<T>, Receiver<T>);

impl<T> Sender<T> {
    // Puts `value` in the channel, waiting while it is full.
    #[intrinsic]
    fn send(&self, value: T) with suspend, fail(Closed);
}

impl<T> Receiver<T> {
    // The next value, waiting while the channel is empty; `None` once every `Sender` is gone.
    #[intrinsic]
    fn recv(&self) -> Option<T> with suspend;
}

impl<T> Clone for Sender<T> {
    #[intrinsic]
    fn clone(&self) -> Sender<T>;
}

impl<T> Drop for Sender<T> {
    #[intrinsic]
    fn drop(self);
}

impl<T> Drop for Receiver<T> {
    #[intrinsic]
    fn drop(self);
}

// Time (`task.timer.1`): a run's time is virtual. It starts at zero and moves only when every
// task waits, straight to the earliest timer.

// A length of time, in nanoseconds.
#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
struct Duration {
    nanos: int,
}

impl Duration {
    fn seconds(n: int) -> Duration {
        Duration { nanos: n * 1000000000 }
    }
    fn millis(n: int) -> Duration {
        Duration { nanos: n * 1000000 }
    }
    fn nanos(&self) -> int {
        self.nanos
    }
}

// A channel whose one value, `()`, arrives once `after` has passed; then it has no sender.
fn timer(after: Duration) -> Receiver<()> {
    __timer(after.nanos)
}

#[intrinsic]
fn __timer(nanos: int) -> Receiver<()>;

// Waits until `d` has passed.
fn sleep(d: Duration) with suspend {
    timer(d).recv();
}
