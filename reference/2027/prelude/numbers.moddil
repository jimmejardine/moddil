// Part of the prelude (`../prelude.md`): the sized integers and the floats, and `Number`.

// The sized integers and the floats (`num.types.1`): each is `Copy`, compares, and has the
// arithmetic operators, built in on two values of the type. The integers are `Eq` and `Ord`; the
// floats only `PartialEq` and `PartialOrd`, as IEEE 754 says (NaN is unordered).
//
// Each impl is written once, as a template that `#[derive_for]` makes for each type it lists
// (`comptime.derive.for.1`). The integers' arithmetic is `#[track_caller]`, as it can trap.

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128, f32, f64)]
const fn number_clone(t: type) -> Impl<Clone> {
    impl Clone for t {
        fn clone(&self) -> t {
            *self
        }
    }
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128, f32, f64)]
const fn number_copy(t: type) -> Impl<Copy> {
    impl Copy for t {}
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128, f32, f64)]
const fn number_partial_eq(t: type) -> Impl<PartialEq> {
    impl PartialEq for t {
        fn eq(&self, other: &t) -> bool {
            *self == *other
        }
    }
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128, f32, f64)]
const fn number_partial_ord(t: type) -> Impl<PartialOrd> {
    impl PartialOrd for t {
        fn partial_cmp(&self, other: &t) -> Option<Ordering> {
            if *self < *other {
                Some(Ordering::Less)
            } else if *self == *other {
                Some(Ordering::Equal)
            } else if *self > *other {
                Some(Ordering::Greater)
            } else {
                None
            }
        }

        fn lt(&self, other: &t) -> bool {
            *self < *other
        }

        fn le(&self, other: &t) -> bool {
            *self <= *other
        }

        fn gt(&self, other: &t) -> bool {
            *self > *other
        }

        fn ge(&self, other: &t) -> bool {
            *self >= *other
        }
    }
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128)]
const fn int_eq(t: type) -> Impl<Eq> {
    impl Eq for t {}
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128)]
const fn int_ord(t: type) -> Impl<Ord> {
    impl Ord for t {
        fn cmp(&self, other: &t) -> Ordering {
            if *self < *other {
                Ordering::Less
            } else if *self == *other {
                Ordering::Equal
            } else {
                Ordering::Greater
            }
        }
    }
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128)]
const fn int_add(t: type) -> Impl<Add> {
    impl Add for t {
        type Output = t;
        #[track_caller]
        fn add(self, rhs: t) -> t {
            self + rhs
        }
    }
}

#[derive_for(f32, f64)]
const fn float_add(t: type) -> Impl<Add> {
    impl Add for t {
        type Output = t;
        fn add(self, rhs: t) -> t {
            self + rhs
        }
    }
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128)]
const fn int_sub(t: type) -> Impl<Sub> {
    impl Sub for t {
        type Output = t;
        #[track_caller]
        fn sub(self, rhs: t) -> t {
            self - rhs
        }
    }
}

#[derive_for(f32, f64)]
const fn float_sub(t: type) -> Impl<Sub> {
    impl Sub for t {
        type Output = t;
        fn sub(self, rhs: t) -> t {
            self - rhs
        }
    }
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128)]
const fn int_mul(t: type) -> Impl<Mul> {
    impl Mul for t {
        type Output = t;
        #[track_caller]
        fn mul(self, rhs: t) -> t {
            self * rhs
        }
    }
}

#[derive_for(f32, f64)]
const fn float_mul(t: type) -> Impl<Mul> {
    impl Mul for t {
        type Output = t;
        fn mul(self, rhs: t) -> t {
            self * rhs
        }
    }
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128)]
const fn int_div(t: type) -> Impl<Div> {
    impl Div for t {
        type Output = t;
        #[track_caller]
        fn div(self, rhs: t) -> t {
            self / rhs
        }
    }
}

#[derive_for(f32, f64)]
const fn float_div(t: type) -> Impl<Div> {
    impl Div for t {
        type Output = t;
        fn div(self, rhs: t) -> t {
            self / rhs
        }
    }
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128)]
const fn int_rem(t: type) -> Impl<Rem> {
    impl Rem for t {
        type Output = t;
        #[track_caller]
        fn rem(self, rhs: t) -> t {
            self % rhs
        }
    }
}

#[derive_for(f32, f64)]
const fn float_rem(t: type) -> Impl<Rem> {
    impl Rem for t {
        type Output = t;
        fn rem(self, rhs: t) -> t {
            self % rhs
        }
    }
}

#[derive_for(i8, i16, i32, i128)]
const fn int_neg(t: type) -> Impl<Neg> {
    impl Neg for t {
        type Output = t;
        #[track_caller]
        fn neg(self) -> t {
            -self
        }
    }
}

#[derive_for(f32, f64)]
const fn float_neg(t: type) -> Impl<Neg> {
    impl Neg for t {
        type Output = t;
        fn neg(self) -> t {
            -self
        }
    }
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128)]
const fn int_not(t: type) -> Impl<Not> {
    impl Not for t {
        type Output = t;
        fn not(self) -> t {
            !self
        }
    }
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128, f32, f64)]
const fn number_display(t: type) -> Impl<Display> {
    impl Display for t {
        fn fmt(&self, out: &mut dyn TextWrite) {
            out.write_str(self.text());
        }
    }
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128, f32, f64)]
const fn number_debug(t: type) -> Impl<Debug> {
    impl Debug for t {
        fn fmt(&self, out: &mut dyn TextWrite) {
            Display::fmt(self, out);
        }
    }
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128)]
const fn int_default(t: type) -> Impl<Default> {
    impl Default for t {
        fn default() -> t {
            0
        }
    }
}

#[derive_for(f32, f64)]
const fn float_default(t: type) -> Impl<Default> {
    impl Default for t {
        fn default() -> t {
            0.0
        }
    }
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128, f32, f64)]
const fn number_marker(t: type) -> Impl<Number> {
    impl Number for t {}
}
