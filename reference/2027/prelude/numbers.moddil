// Part of the prelude (`../prelude.md`): the sized integers and the floats, and `Number`.

// The sized integers and the floats (`num.types.1`): each is `Copy`, compares, and has the
// arithmetic operators, built in on two values of the type. The integers are `Eq` and `Ord`; the
// floats only `PartialEq` and `PartialOrd`, as IEEE 754 says (NaN is unordered).
//
// Each impl is written once, as a template that `#[derive_for]` makes for each type it lists
// (`comptime.derive.for.1`). The integers' arithmetic is `#[track_caller]`, as it can trap.

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128, f32, f64)]
const fn number_clone(t: type) -> Impl<Clone> {
    impl Clone for t {
        fn clone(&self) -> t {
            *self
        }
    }
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128, f32, f64)]
const fn number_copy(t: type) -> Impl<Copy> {
    impl Copy for t {}
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128, f32, f64)]
const fn number_partial_eq(t: type) -> Impl<PartialEq> {
    impl PartialEq for t {
        fn eq(&self, other: &t) -> bool {
            *self == *other
        }
    }
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128, f32, f64)]
const fn number_partial_ord(t: type) -> Impl<PartialOrd> {
    impl PartialOrd for t {
        fn partial_cmp(&self, other: &t) -> Option<Ordering> {
            if *self < *other {
                Some(Ordering::Less)
            } else if *self == *other {
                Some(Ordering::Equal)
            } else if *self > *other {
                Some(Ordering::Greater)
            } else {
                None
            }
        }

        fn lt(&self, other: &t) -> bool {
            *self < *other
        }

        fn le(&self, other: &t) -> bool {
            *self <= *other
        }

        fn gt(&self, other: &t) -> bool {
            *self > *other
        }

        fn ge(&self, other: &t) -> bool {
            *self >= *other
        }
    }
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128)]
const fn int_eq(t: type) -> Impl<Eq> {
    impl Eq for t {}
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128)]
const fn int_ord(t: type) -> Impl<Ord> {
    impl Ord for t {
        fn cmp(&self, other: &t) -> Ordering {
            if *self < *other {
                Ordering::Less
            } else if *self == *other {
                Ordering::Equal
            } else {
                Ordering::Greater
            }
        }
    }
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128)]
const fn int_add(t: type) -> Impl<Add> {
    impl Add for t {
        type Output = t;
        #[track_caller]
        fn add(self, rhs: t) -> t {
            self + rhs
        }
    }
}

#[derive_for(f32, f64)]
const fn float_add(t: type) -> Impl<Add> {
    impl Add for t {
        type Output = t;
        fn add(self, rhs: t) -> t {
            self + rhs
        }
    }
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128)]
const fn int_sub(t: type) -> Impl<Sub> {
    impl Sub for t {
        type Output = t;
        #[track_caller]
        fn sub(self, rhs: t) -> t {
            self - rhs
        }
    }
}

#[derive_for(f32, f64)]
const fn float_sub(t: type) -> Impl<Sub> {
    impl Sub for t {
        type Output = t;
        fn sub(self, rhs: t) -> t {
            self - rhs
        }
    }
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128)]
const fn int_mul(t: type) -> Impl<Mul> {
    impl Mul for t {
        type Output = t;
        #[track_caller]
        fn mul(self, rhs: t) -> t {
            self * rhs
        }
    }
}

#[derive_for(f32, f64)]
const fn float_mul(t: type) -> Impl<Mul> {
    impl Mul for t {
        type Output = t;
        fn mul(self, rhs: t) -> t {
            self * rhs
        }
    }
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128)]
const fn int_div(t: type) -> Impl<Div> {
    impl Div for t {
        type Output = t;
        #[track_caller]
        fn div(self, rhs: t) -> t {
            self / rhs
        }
    }
}

#[derive_for(f32, f64)]
const fn float_div(t: type) -> Impl<Div> {
    impl Div for t {
        type Output = t;
        fn div(self, rhs: t) -> t {
            self / rhs
        }
    }
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128)]
const fn int_rem(t: type) -> Impl<Rem> {
    impl Rem for t {
        type Output = t;
        #[track_caller]
        fn rem(self, rhs: t) -> t {
            self % rhs
        }
    }
}

#[derive_for(f32, f64)]
const fn float_rem(t: type) -> Impl<Rem> {
    impl Rem for t {
        type Output = t;
        fn rem(self, rhs: t) -> t {
            self % rhs
        }
    }
}

#[derive_for(i8, i16, i32, i128)]
const fn int_neg(t: type) -> Impl<Neg> {
    impl Neg for t {
        type Output = t;
        #[track_caller]
        fn neg(self) -> t {
            -self
        }
    }
}

#[derive_for(f32, f64)]
const fn float_neg(t: type) -> Impl<Neg> {
    impl Neg for t {
        type Output = t;
        fn neg(self) -> t {
            -self
        }
    }
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128)]
const fn int_not(t: type) -> Impl<Not> {
    impl Not for t {
        type Output = t;
        fn not(self) -> t {
            !self
        }
    }
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128, f32, f64)]
const fn number_display(t: type) -> Impl<Display> {
    impl Display for t {
        fn fmt(&self, out: &mut dyn TextWrite) {
            out.write_str(self.text());
        }
    }
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128, f32, f64)]
const fn number_debug(t: type) -> Impl<Debug> {
    impl Debug for t {
        fn fmt(&self, out: &mut dyn TextWrite) {
            Display::fmt(self, out);
        }
    }
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128)]
const fn int_default(t: type) -> Impl<Default> {
    impl Default for t {
        fn default() -> t {
            0
        }
    }
}

#[derive_for(f32, f64)]
const fn float_default(t: type) -> Impl<Default> {
    impl Default for t {
        fn default() -> t {
            0.0
        }
    }
}

#[derive_for(i8, i16, i32, i128, u8, u16, u32, u64, u128, f32, f64)]
const fn number_marker(t: type) -> Impl<Number> {
    impl Number for t {}
}

// An integer's digits in base 2, 8 or 16, for `{n:b}`, `{n:o}`, `{n:x}` and `{n:X}`
// (`expr.fmt.spec.4`): its bits as its type holds them, so a negative one's in two's complement.
trait RadixText {
    // Writes the digits, `bits` bits each, onto `out` (letters upper-case for `upper`), after the
    // base's prefix (`0b`, `0o` or `0x`) for `prefix`.
    fn write_radix(&self, out: &mut String, bits: int, upper: bool, prefix: bool);
}

#[derive_for(int, i8, i16, i32, i128, u8, u16, u32, u64, u128)]
const fn int_radix(t: type) -> Impl<RadixText> {
    impl RadixText for t {
        fn write_radix(&self, out: &mut String, bits: int, upper: bool, prefix: bool) {
            let zero: t = 0;
            let one: t = 1;
            let all = (zero -% one).count_ones();
            // The digits, lowest first: the last may hold fewer bits than the others.
            let mut digits: Vec<int> = Vec::new();
            let mut x = *self;
            let mut left = all;
            while left > 0 {
                let k = if left < bits { left } else { bits };
                let mask = (one << k.truncate::<t>()) - one;
                digits.push((x & mask).to::<int>() ?! "a digit is less than 16");
                x = x >> bits.truncate::<t>();
                left -= k;
            }
            let mut top = digits.len() - 1;
            while top > 0 && digits[top] == 0 {
                top -= 1;
            }
            if prefix {
                out.push_str(if bits == 4 { "0x" } else if bits == 3 { "0o" } else { "0b" });
            }
            let symbols = if upper { "0123456789ABCDEF" } else { "0123456789abcdef" };
            let mut i = top;
            loop {
                let d = digits[i];
                out.push_str(symbols.bytes_between(d, d + 1));
                if i == 0 {
                    break;
                }
                i -= 1;
            }
        }
    }
}
