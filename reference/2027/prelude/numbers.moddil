// The sized integers and the floats (`num.types.1`): each is `Copy`, compares, and has the
// arithmetic operators, built in on two values of the type. The integers are `Eq` and `Ord`; the
// floats only `PartialEq` and `PartialOrd`, as IEEE 754 says (NaN is unordered).

impl Clone for i8 {
    fn clone(&self) -> i8 {
        *self
    }
}

impl Copy for i8 {}

impl PartialEq for i8 {
    fn eq(&self, other: &i8) -> bool {
        *self == *other
    }
}

impl PartialOrd for i8 {
    fn partial_cmp(&self, other: &i8) -> Option<Ordering> {
        if *self < *other {
            Some(Ordering::Less)
        } else if *self == *other {
            Some(Ordering::Equal)
        } else if *self > *other {
            Some(Ordering::Greater)
        } else {
            None
        }
    }

    fn lt(&self, other: &i8) -> bool {
        *self < *other
    }

    fn le(&self, other: &i8) -> bool {
        *self <= *other
    }

    fn gt(&self, other: &i8) -> bool {
        *self > *other
    }

    fn ge(&self, other: &i8) -> bool {
        *self >= *other
    }
}

impl Eq for i8 {}

impl Ord for i8 {
    fn cmp(&self, other: &i8) -> Ordering {
        if *self < *other {
            Ordering::Less
        } else if *self == *other {
            Ordering::Equal
        } else {
            Ordering::Greater
        }
    }
}

