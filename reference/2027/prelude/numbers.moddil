        } else if *self == *other {
            Some(Ordering::Equal)
        } else if *self > *other {
            Some(Ordering::Greater)
        } else {
            None
        }
    }

    fn lt(&self, other: &f32) -> bool {
        *self < *other
    }

    fn le(&self, other: &f32) -> bool {
        *self <= *other
    }

    fn gt(&self, other: &f32) -> bool {
        *self > *other
    }

    fn ge(&self, other: &f32) -> bool {
        *self >= *other
    }
}

