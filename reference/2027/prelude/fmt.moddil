// Part of the prelude (`../prelude.md`): `Debug` and `Default`.

// How a value is shown to a developer (`expr.fmt.debug.1`): by `{x:?}` in `fmt"…"`, written as
// Moddil source writes it. Derived by the template in `derives.moddil`.
#[derive_by(derive_debug)]
trait Debug {
    fn fmt(&self, out: &mut dyn TextWrite);
}

// A borrow is shown as what it points to (`expr.fmt.debug.1`), so a view with a borrow field
// derives `Debug` (`view.derive.1`).
impl<T: Debug> Debug for &T {
    fn fmt(&self, out: &mut dyn TextWrite) {
        Debug::fmt(*self, out);
    }
}

impl Debug for int {
    fn fmt(&self, out: &mut dyn TextWrite) {
        Display::fmt(self, out);
    }
}

impl Debug for bool {
    fn fmt(&self, out: &mut dyn TextWrite) {
        Display::fmt(self, out);
    }
}

impl Debug for char {
    fn fmt(&self, out: &mut dyn TextWrite) {
        out.write_str(&self.quoted());
    }
}

impl Debug for str {
    fn fmt(&self, out: &mut dyn TextWrite) {
        out.write_str(&self.quoted());
    }
}

impl Debug for String {
    fn fmt(&self, out: &mut dyn TextWrite) {
        out.write_str(&self.as_str().quoted());
    }
}

impl Debug for () {
    fn fmt(&self, out: &mut dyn TextWrite) {
        out.write_str("()");
    }
}

impl<T: Debug> Debug for [T] {
    fn fmt(&self, out: &mut dyn TextWrite) {
        out.write_char('[');
        let mut first = true;
        for x in self {
            if !first {
                out.write_str(", ");
            }
            first = false;
            Debug::fmt(x, out);
        }
        out.write_char(']');
    }
}

impl<T: Debug, const N: int> Debug for [T; N] {
    fn fmt(&self, out: &mut dyn TextWrite) {
        Debug::fmt(self.as_slice(), out);
    }
}

impl<T: Debug> Debug for Vec<T> {
    fn fmt(&self, out: &mut dyn TextWrite) {
        Debug::fmt(self.as_slice(), out);
    }
}

impl<T: Debug> Debug for Option<T> {
    fn fmt(&self, out: &mut dyn TextWrite) {
        match self {
            None => out.write_str("None"),
            Some(x) => {
                out.write_str("Some(");
                Debug::fmt(x, out);
                out.write_char(')');
            }
        }
    }
}

impl<T: Debug, E: Debug> Debug for Result<T, E> {
    fn fmt(&self, out: &mut dyn TextWrite) {
        match self {
            Ok(x) => {
                out.write_str("Ok(");
                Debug::fmt(x, out);
                out.write_char(')');
            }
            Err(e) => {
                out.write_str("Err(");
                Debug::fmt(e, out);
                out.write_char(')');
            }
        }
    }
}

#[derive_for(tuples(2..=12))]
const fn tuple_debug(t: type) -> Impl<Debug> {
    impl Debug for t {
        fn fmt(&self, out: &mut dyn TextWrite) {
            out.write_char('(');
            inline for f in fields(t) {
                if const f.name != "0" {
                    out.write_str(", ");
                }
                Debug::fmt(&self.[f], out);
            }
            out.write_char(')');
        }
    }
}

impl char {
    // The character as Debug shows it: in quotes, escaped.
    fn quoted(self) -> String {
        String::from_str((&self).quoted_text())
    }

    #[intrinsic]
    fn quoted_text(&self) -> &str;

    // The character itself, as text.
    #[intrinsic]
    fn text(&self) -> &str;
}

impl str {
    // The text as Debug shows it: in quotes, escaped.
    fn quoted(&self) -> String {
        String::from_str(self.quoted_text())
    }

    #[intrinsic]
    fn quoted_text(&self) -> &str;
}

// A type's default value (`attr.derive.default.1`).
#[derive_by(derive_default)]
trait Default {
    fn default() -> Self;
}

impl Default for int {
    fn default() -> int {
        0
    }
}

impl Default for bool {
    fn default() -> bool {
        false
    }
}

impl Default for String {
    fn default() -> String {
        String::new()
    }
}

impl Default for () {
    fn default() -> () {
        ()
    }
}

impl<T> Default for Vec<T> {
    fn default() -> Vec<T> {
        Vec::new()
    }
}

impl<T> Default for Option<T> {
    fn default() -> Option<T> {
        None
    }
}

// `{x:#?}` (`expr.fmt.debug.2`): `x`'s `Debug` written across lines, as `PrettyWrite` makes it.
fn debug_pretty<T: Debug>(x: &T, out: &mut dyn TextWrite) {
    let mut p = PrettyWrite {
        out,
        depth: 0,
        open: false,
        space: false,
        skip: false,
        quote: '\0',
        escaped: false,
    };
    Debug::fmt(x, &mut p);
}

// A sink that writes a value's one-line `Debug` onto `out` across lines (`expr.fmt.debug.2`):
// after each `{`, `[` or `(` a new line, one level further in (four spaces), each `, ` a new
// line, and before each closing bracket a `,` and a new line, one level back; an empty `()`,
// `[]` or `{}` stays as it is, and quoted text and characters are written as they are.
view PrettyWrite {
    out: &mut dyn TextWrite,
    // How many levels in.
    depth: int,
    // Just after an opening bracket: what follows starts a line, unless it closes.
    open: bool,
    // A space held back: written before what follows, unless that closes.
    space: bool,
    // The space after `{` or `, `, which a new line replaces.
    skip: bool,
    // Inside quoted text: its quote (`"` or `'`), else `'\0'`.
    quote: char,
    // Just after a `\` in quoted text.
    escaped: bool,
}

impl PrettyWrite {
    fn line(&mut self) {
        self.out.write_char('\n');
        let mut i = 0;
        while i < self.depth {
            self.out.write_str("    ");
            i += 1;
        }
    }

    fn push(&mut self, c: char) {
        if self.quote != '\0' {
            self.out.write_char(c);
            if self.escaped {
                self.escaped = false;
            } else if c == '\\' {
                self.escaped = true;
            } else if c == self.quote {
                self.quote = '\0';
            }
            return;
        }
        if c == ' ' {
            if self.skip {
                self.skip = false;
            } else {
                self.space = true;
            }
            return;
        }
        self.skip = false;
        if c == '}' || c == ']' || c == ')' {
            self.space = false;
            if self.open {
                self.open = false;
            } else {
                self.out.write_char(',');
                self.depth -= 1;
                self.line();
            }
            self.out.write_char(c);
            return;
        }
        if self.open {
            self.open = false;
            self.space = false;
            self.depth += 1;
            self.line();
        }
        if self.space {
            self.out.write_char(' ');
            self.space = false;
        }
        self.out.write_char(c);
        if c == '{' || c == '[' || c == '(' {
            self.open = true;
            self.skip = c == '{';
        } else if c == ',' {
            self.line();
            self.skip = true;
        } else if c == '"' || c == '\'' {
            self.quote = c;
        }
    }
}

impl TextWrite for PrettyWrite {
    fn write_str(&mut self, s: &str) {
        for c in s.chars() {
            self.push(c);
        }
    }
}
