// `int`.

impl Clone for int {
    fn clone(&self) -> int {
        *self
    }
}

impl Copy for int {}

impl PartialEq for int {
    fn eq(&self, other: &int) -> bool {
        *self == *other
    }
}

impl Eq for int {}

impl PartialOrd for int {
    fn partial_cmp(&self, other: &int) -> Option<Ordering> {
        Some(self.cmp(other))
    }

    fn lt(&self, other: &int) -> bool {
        *self < *other
    }

    fn le(&self, other: &int) -> bool {
        *self <= *other
    }

    fn gt(&self, other: &int) -> bool {
        *self > *other
    }

    fn ge(&self, other: &int) -> bool {
        *self >= *other
    }
}

impl Ord for int {
    fn cmp(&self, other: &int) -> Ordering {
        if *self < *other {
            Ordering::Less
        } else if *self == *other {
            Ordering::Equal
        } else {
            Ordering::Greater
        }
    }
}

impl Add for int {
    type Output = int;
    #[track_caller]
    fn add(self, rhs: int) -> int {
        self + rhs
    }
}

impl Sub for int {
    type Output = int;
    #[track_caller]
    fn sub(self, rhs: int) -> int {
        self - rhs
    }
}

impl Mul for int {
    type Output = int;
    #[track_caller]
    fn mul(self, rhs: int) -> int {
        self * rhs
    }
}

impl Div for int {
    type Output = int;
    #[track_caller]
    fn div(self, rhs: int) -> int {
        self / rhs
    }
}

impl Rem for int {
    type Output = int;
    #[track_caller]
    fn rem(self, rhs: int) -> int {
        self % rhs
    }
}

impl Neg for int {
    type Output = int;
    #[track_caller]
    fn neg(self) -> int {
        -self
    }
}

impl Not for int {
    type Output = int;
    fn not(self) -> int {
        !self
    }
}

