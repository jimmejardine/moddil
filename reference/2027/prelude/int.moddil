// Part of the prelude (`../prelude.md`): `int`, `bool` and `()`.

// `int`.

impl Clone for int {
    fn clone(&self) -> int {
        *self
    }
}

impl Copy for int {}

impl PartialEq for int {
    fn eq(&self, other: &int) -> bool {
        *self == *other
    }
}

impl Eq for int {}

impl PartialOrd for int {
    fn partial_cmp(&self, other: &int) -> Option<Ordering> {
        Some(self.cmp(other))
    }

    fn lt(&self, other: &int) -> bool {
        *self < *other
    }

    fn le(&self, other: &int) -> bool {
        *self <= *other
    }

    fn gt(&self, other: &int) -> bool {
        *self > *other
    }

    fn ge(&self, other: &int) -> bool {
        *self >= *other
    }
}

impl Ord for int {
    fn cmp(&self, other: &int) -> Ordering {
        if *self < *other {
            Ordering::Less
        } else if *self == *other {
            Ordering::Equal
        } else {
            Ordering::Greater
        }
    }
}

impl Add for int {
    type Output = int;
    #[track_caller]
    fn add(self, rhs: int) -> int {
        self + rhs
    }
}

impl Sub for int {
    type Output = int;
    #[track_caller]
    fn sub(self, rhs: int) -> int {
        self - rhs
    }
}

impl Mul for int {
    type Output = int;
    #[track_caller]
    fn mul(self, rhs: int) -> int {
        self * rhs
    }
}

impl Div for int {
    type Output = int;
    #[track_caller]
    fn div(self, rhs: int) -> int {
        self / rhs
    }
}

impl Rem for int {
    type Output = int;
    #[track_caller]
    fn rem(self, rhs: int) -> int {
        self % rhs
    }
}

impl Neg for int {
    type Output = int;
    #[track_caller]
    fn neg(self) -> int {
        -self
    }
}

impl Not for int {
    type Output = int;
    fn not(self) -> int {
        !self
    }
}

// `bool`: `false` orders before `true`.

impl Clone for bool {
    fn clone(&self) -> bool {
        *self
    }
}

impl Copy for bool {}

impl PartialEq for bool {
    fn eq(&self, other: &bool) -> bool {
        *self == *other
    }
}

impl Eq for bool {}

impl PartialOrd for bool {
    fn partial_cmp(&self, other: &bool) -> Option<Ordering> {
        Some(self.cmp(other))
    }
}

impl Ord for bool {
    fn cmp(&self, other: &bool) -> Ordering {
        if *self == *other {
            Ordering::Equal
        } else if *other {
            Ordering::Less
        } else {
            Ordering::Greater
        }
    }
}

impl Not for bool {
    type Output = bool;
    fn not(self) -> bool {
        !self
    }
}

// `()`.

impl Clone for () {
    fn clone(&self) -> () {
        ()
    }
}

impl Copy for () {}

impl PartialEq for () {
    fn eq(&self, other: &()) -> bool {
        true
    }
}

impl Eq for () {}

// A tuple of `Clone` elements (`type.tuple.traits.1`): each element cloned. One of `Copy`
// elements is cloned by copying it, at any size.

#[derive_for(tuples(2..=12))]
const fn tuple_clone(t: type) -> Impl<Clone> {
    impl Clone for t {
        fn clone(&self) -> t {
            t {
                inline for f in fields(t) {
                    [f]: self.[f].clone(),
                }
            }
        }
    }
}

