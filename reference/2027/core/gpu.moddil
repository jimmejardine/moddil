// The `core` mod's `gpu` module (`gpu.1`): what a kernel launch needs from the compiler and the
// host. Only a mod whose manifest lists the `os` capability may name it (`os.cap.1`); the standard
// `gpu` mod builds launches and the root capability `GpuRoot` over it.

// The WGSL of kernel `k` (a function marked `#[kernel]`, named as a value): its compute entry
// point `main`, one invocation per 8 x 8 tile. Empty where no backend made it (an interpreter).
#[intrinsic]
pub fn source<K>(k: &K) -> &str;

// The bytes of `v`, as they are laid out in memory: what a kernel's parameters are on the GPU.
// Empty where values have no bytes (an interpreter).
#[intrinsic]
pub fn bytes<T>(v: &T) -> &[u8];

// Runs kernel `source` on the GPU over a `width` x `height` image (in 8 x 8 tiles), with its
// parameters `params`, into `out` (a packed RGBA8 pixel each, row by row); with `present`, also
// shows the image in the page's canvas. False where there is no GPU, and then nothing ran.
#[intrinsic]
pub fn dispatch(source: &str, params: &[u8], width: int, height: int, out: &mut [u32], present: bool) -> bool with suspend;

// Waits for the page's next animation frame: how long since the last one in microseconds, the
// canvas's width and height, the keys held (a bit each), the mouse's movement and the wheel's
// since the last frame, and whether the page asked the program to stop. Outside a page, a frame
// of nothing, asking to stop.
#[intrinsic]
pub fn frame(out: &mut [int]) with suspend;
