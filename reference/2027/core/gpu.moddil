// The `core` mod's `gpu` module (`gpu.1`): what a kernel launch needs from the compiler and the
// host. Only a mod whose manifest lists the `os` capability may name it (`os.cap.1`); the standard
// `gpu` mod builds launches and the root capability `GpuRoot` over it.

// The WGSL of kernel `k` (a function marked `#[kernel]`, named as a value): its compute entry
// point `main`, a workgroup of 8 x 8 invocations per 8 x 8 tile. Empty where no backend made it
// (an interpreter).
#[intrinsic]
pub fn source<K>(k: &K) -> &str;

// The bytes of `v`, as they are laid out in memory: what a kernel's parameters are on the GPU.
// Empty where values have no bytes (an interpreter).
#[intrinsic]
pub fn bytes<T>(v: &T) -> &[u8];

// Runs kernel `source` on the GPU over a `width` x `height` image (in tiles of `tile_width` x
// `tile_height`, the kernel's), with its
// parameters `params`. `mode` is the sum of what to do with the image: 1, show it in the page's
// canvas (on the GPU, with no copy back); 2, read its pixels back into `out` (a packed RGBA8
// pixel each, row by row). 0 where there is no GPU, and then nothing ran; 1 if it ran; and
// `k + 2` if a check of the kernel failed there, its site `k` (`gpu.trap.1`).
#[intrinsic]
pub fn dispatch(source: &str, params: &[u8], width: int, height: int, tile_width: int, tile_height: int, out: &mut [u32], mode: int) -> int with suspend;

// Traps as kernel `k`'s check at site `site` (a `dispatch`'s code less 2) does: at that check, in
// the kernel's source, with its kind (`gpu.trap.1`).
#[intrinsic]
pub fn trap<K>(k: &K, site: int) -> !;

// Shows `pixels` (packed RGBA8, row by row), a `width` x `height` image drawn on the CPU, in the
// page's canvas. Nothing outside a page.
#[intrinsic]
pub fn show(pixels: &[u32], width: int, height: int) with suspend;

// Waits for the page's next animation frame: how long since the last one in microseconds, the
// canvas's width and height, the keys held (a bit each), the mouse's movement and the wheel's
// since the last frame, and whether the page asked the program to stop. Outside a page, a frame
// of nothing, asking to stop.
#[intrinsic]
pub fn frame(out: &mut [int]) with suspend;

// What `int` is in a kernel (`gpu.int.1`): WGSL has no 64-bit integers, so the lowering holds one
// as its low and high words, and runs each operation on it through the functions below. They are
// ordinary Moddil, on `u32`s that wrap and `i32` counts, so they run (and are tested) on the CPU
// as they do on the GPU.
#[derive(Copy, Clone, PartialEq, Debug)]
pub struct WideInt {
    pub lo: u32,
    pub hi: u32,
}

pub fn wide(lo: u32, hi: u32) -> WideInt {
    WideInt { lo: lo, hi: hi }
}

pub fn wide_add(a: WideInt, b: WideInt) -> WideInt {
    let lo = a.lo +% b.lo;
    let carry: u32 = if lo < a.lo { 1 } else { 0 };
    WideInt { lo: lo, hi: a.hi +% b.hi +% carry }
}

pub fn wide_not(a: WideInt) -> WideInt {
    WideInt { lo: !a.lo, hi: !a.hi }
}

pub fn wide_neg(a: WideInt) -> WideInt {
    wide_add(wide_not(a), WideInt { lo: 1, hi: 0 })
}

pub fn wide_sub(a: WideInt, b: WideInt) -> WideInt {
    wide_add(a, wide_neg(b))
}

pub fn wide_and(a: WideInt, b: WideInt) -> WideInt {
    WideInt { lo: a.lo & b.lo, hi: a.hi & b.hi }
}

pub fn wide_or(a: WideInt, b: WideInt) -> WideInt {
    WideInt { lo: a.lo | b.lo, hi: a.hi | b.hi }
}

pub fn wide_xor(a: WideInt, b: WideInt) -> WideInt {
    WideInt { lo: a.lo ^ b.lo, hi: a.hi ^ b.hi }
}

// The 64-bit product of two words, by their 16-bit halves.
fn wide_mul32(x: u32, y: u32) -> WideInt {
    let (x0, x1) = (x & 65535, x >> 16);
    let (y0, y1) = (y & 65535, y >> 16);
    let (p00, p01, p10, p11) = (x0 *% y0, x0 *% y1, x1 *% y0, x1 *% y1);
    let mid = (p00 >> 16) +% (p01 & 65535) +% (p10 & 65535);
    WideInt { lo: ((mid & 65535) << 16) | (p00 & 65535), hi: p11 +% (p01 >> 16) +% (p10 >> 16) +% (mid >> 16) }
}

pub fn wide_mul(a: WideInt, b: WideInt) -> WideInt {
    let low = wide_mul32(a.lo, b.lo);
    WideInt { lo: low.lo, hi: low.hi +% a.lo *% b.hi +% a.hi *% b.lo }
}

pub fn wide_eq(a: WideInt, b: WideInt) -> bool {
    a.lo == b.lo && a.hi == b.hi
}

// `a < b`, as signed numbers.
pub fn wide_lt(a: WideInt, b: WideInt) -> bool {
    let (ah, bh) = (a.hi ^ 2147483648, b.hi ^ 2147483648);
    ah < bh || (ah == bh && a.lo < b.lo)
}

fn wide_ult(a: WideInt, b: WideInt) -> bool {
    a.hi < b.hi || (a.hi == b.hi && a.lo < b.lo)
}

fn wide_negative(a: WideInt) -> bool {
    a.hi >= 2147483648
}

// `w << n` for a word, the bits shifted out dropped (a `<<` that loses one traps), `n` below 32.
fn shl32(w: u32, n: u32) -> u32 {
    (w & (4294967295 >> n)) << n
}

// `a << n`, for `n` from 0 to 63, the bits shifted out dropped.
pub fn wide_shl(a: WideInt, n: u32) -> WideInt {
    if n == 0 {
        return a;
    }
    if n >= 32 {
        return WideInt { lo: 0, hi: shl32(a.lo, n - 32) };
    }
    WideInt { lo: shl32(a.lo, n), hi: shl32(a.hi, n) | (a.lo >> (32 - n)) }
}

// `a >> n`, filling with the sign, for `n` from 0 to 63.
pub fn wide_shr(a: WideInt, n: u32) -> WideInt {
    let fill: u32 = if wide_negative(a) { 4294967295 } else { 0 };
    if n == 0 {
        a
    } else if n >= 32 {
        let s = n - 32;
        let lo = if s == 0 { a.hi } else { (a.hi >> s) | shl32(fill, 32 - s) };
        WideInt { lo: lo, hi: fill }
    } else {
        WideInt { lo: (a.lo >> n) | shl32(a.hi, 32 - n), hi: (a.hi >> n) | shl32(fill, 32 - n) }
    }
}

// The quotient and remainder of `n / d` as unsigned numbers, `d` not zero: bit by bit.
fn wide_udivrem(n: WideInt, d: WideInt) -> (WideInt, WideInt) {
    let mut q = WideInt { lo: 0, hi: 0 };
    let mut r = WideInt { lo: 0, hi: 0 };
    let mut i: i32 = 63;
    while i >= 0 {
        let k = i.wrap::<u32>();
        let bit = if k >= 32 { (n.hi >> (k - 32)) & 1 } else { (n.lo >> k) & 1 };
        r = wide_shl(r, 1);
        r.lo = r.lo | bit;
        if !wide_ult(r, d) {
            r = wide_sub(r, d);
            if k >= 32 {
                q.hi = q.hi | shl32(1, k - 32);
            } else {
                q.lo = q.lo | shl32(1, k);
            }
        }
        i -= 1;
    }
    (q, r)
}

fn wide_abs(a: WideInt) -> WideInt {
    if wide_negative(a) { wide_neg(a) } else { a }
}

// `a / b`, rounded toward zero, `b` not zero.
pub fn wide_div(a: WideInt, b: WideInt) -> WideInt {
    let (q, _) = wide_udivrem(wide_abs(a), wide_abs(b));
    if wide_negative(a) != wide_negative(b) { wide_neg(q) } else { q }
}

// `a % b`, with the sign of `a`, `b` not zero.
pub fn wide_rem(a: WideInt, b: WideInt) -> WideInt {
    let (_, r) = wide_udivrem(wide_abs(a), wide_abs(b));
    if wide_negative(a) { wide_neg(r) } else { r }
}

// Whether `a + b`, `a - b`, `a * b`, `a / b`, `-a` and `a << n` / `a >> n` overflow `int`
// (`num.ops.1`).
pub fn wide_add_overflows(a: WideInt, b: WideInt) -> bool {
    let r = wide_add(a, b);
    ((a.hi ^ r.hi) & (b.hi ^ r.hi)) >= 2147483648
}

pub fn wide_sub_overflows(a: WideInt, b: WideInt) -> bool {
    let r = wide_sub(a, b);
    ((a.hi ^ b.hi) & (a.hi ^ r.hi)) >= 2147483648
}

pub fn wide_mul_overflows(a: WideInt, b: WideInt) -> bool {
    let zero = WideInt { lo: 0, hi: 0 };
    if wide_eq(a, zero) || wide_eq(b, zero) {
        return false;
    }
    let least = WideInt { lo: 0, hi: 2147483648 };
    let minus = WideInt { lo: 4294967295, hi: 4294967295 };
    if (wide_eq(a, minus) && wide_eq(b, least)) || (wide_eq(b, minus) && wide_eq(a, least)) {
        return true;
    }
    !wide_eq(wide_div(wide_mul(a, b), a), b)
}

pub fn wide_div_overflows(a: WideInt, b: WideInt) -> bool {
    wide_eq(a, WideInt { lo: 0, hi: 2147483648 }) && wide_eq(b, WideInt { lo: 4294967295, hi: 4294967295 })
}

pub fn wide_neg_overflows(a: WideInt) -> bool {
    wide_eq(a, WideInt { lo: 0, hi: 2147483648 })
}

pub fn wide_shift_overflows(n: WideInt) -> bool {
    n.hi != 0 || n.lo >= 64
}

// `a << n` traps also if it loses a bit (`expr.bit.shift.1`): if shifting back does not give `a`.
pub fn wide_shl_overflows(a: WideInt, n: WideInt) -> bool {
    wide_shift_overflows(n) || !wide_eq(wide_shr(wide_shl(a, n.lo), n.lo), a)
}

// A pixel a kernel draws (`gpu.tile.1`): stored in an image as its word.
pub trait Pixel: Copy {
    // The pixel as the image stores it.
    fn word(&self) -> u32;
}

// A pixel of red, green, blue and alpha, a byte each, packed into a `u32` with red lowest.
#[derive(Copy, Clone, PartialEq, Debug)]
pub struct Rgba8 {
    packed: u32,
}

impl Rgba8 {
    // A grey of brightness `v`, from 0 (black) to 1 (white), clamped.
    pub fn grey(v: f32) -> Rgba8 {
        let b = byte(v);
        Rgba8 { packed: b | (b << 8) | (b << 16) | (255 << 24) }
    }

    // The colour with these components, each from 0 to 1, clamped.
    pub fn rgb(r: f32, g: f32, b: f32) -> Rgba8 {
        Rgba8 { packed: byte(r) | (byte(g) << 8) | (byte(b) << 16) | (255 << 24) }
    }

    // The pixel whose word is `packed`.
    pub fn of(packed: u32) -> Rgba8 {
        Rgba8 { packed: packed }
    }

    pub fn packed(&self) -> u32 {
        self.packed
    }
}

impl Pixel for Rgba8 {
    fn word(&self) -> u32 {
        self.packed
    }
}

// `v`, clamped to [0, 1], as a byte from 0 to 255.
fn byte(v: f32) -> u32 {
    let c = (v.clamp(0.0, 1.0) * 255.0 + 0.5).floor();
    c.to::<u32>() ?! "a whole number from 0 to 255"
}

// The `W` x `H` pixels one kernel instance draws (`gpu.tile.1`): the tile at (`x`, `y`) of the
// image. On a GPU it is a workgroup of `W` x `H` threads.
pub struct Tile<P, const W: int, const H: int> {
    // The tile's top left pixel in the image.
    pub x: int,
    pub y: int,
    // Its pixels' words, row by row, on the CPU (on a GPU the image's own).
    words: Vec<u32>,
    pixel: Option<P>,
}

impl<P: Pixel, const W: int, const H: int> Tile<P, W, H> {
    // The tile at (`x`, `y`), its pixels 0.
    pub fn at(x: int, y: int) -> Tile<P, W, H> {
        let mut words = Vec::new();
        let mut i = 0;
        while i < W * H {
            words.push(0);
            i += 1;
        }
        Tile { x: x, y: y, words: words, pixel: None }
    }

    pub fn width(&self) -> int {
        W
    }

    pub fn height(&self) -> int {
        H
    }

    // Sets pixel (`px`, `py`) of the tile, `px` from 0 to `W - 1` and `py` to `H - 1`.
    pub fn set(&mut self, px: int, py: int, c: P) {
        self.words[py * W + px] = c.word();
    }

    // Sets each pixel (`px`, `py`) of the tile to `f(px, py)`. On a GPU each is computed by its
    // own thread of the tile's workgroup, in parallel; the CPU simulator computes them in turn.
    pub fn each<F: Fn(int, int) -> P>(&mut self, f: F) {
        let mut py = 0;
        while py < H {
            let mut px = 0;
            while px < W {
                let c = f(px, py);
                self.set(px, py, c);
                px += 1;
            }
            py += 1;
        }
    }

    // The word of pixel (`px`, `py`), as the image stores it.
    pub fn word_at(&self, px: int, py: int) -> u32 {
        self.words[py * W + px]
    }
}
