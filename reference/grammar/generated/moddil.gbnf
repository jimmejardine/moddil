# Tokens
tok-whitespace ::= [ \t\r\n]+
tok-line-comment ::= ( "//" ( [^/!\n] [^\n]* )? | "////" [^\n]* )
tok-doc-outer ::= "///" ( [^/\n] [^\n]* )?
tok-doc-inner ::= "//!" [^\n]*
tok-ident ::= tok-ident-text
tok-ident-text ::= ( xid-start xid-continue* | "_" xid-continue+ )
tok-label ::= "'" tok-ident-text
tok-integer ::= ( tok-dec-digits | "0x" [0-9a-fA-F_]+ | "0o" [0-7_]+ | "0b" [01_]+ )
tok-float ::= ( tok-dec-digits "." [0-9] [0-9_]* tok-exponent? | tok-dec-digits tok-exponent )
tok-dec-digits ::= [0-9] [0-9_]*
tok-exponent ::= [eE] [+\-]? [0-9_]+
tok-string ::= "\"" ( [^"\\] | tok-escape )* "\""
tok-byte-string ::= "b\"" ( [^"\\] | tok-escape )* "\""
tok-char ::= "'" ( [^'\\\n] | tok-escape ) "'"
tok-byte ::= "b'" ( [^'\\\n] | tok-escape ) "'"
tok-escape ::= "\\" ( [nrt0\\"'s] | "x" tok-hex tok-hex | "u{" tok-hex+ "}" )
tok-hex ::= [0-9a-fA-F]
tok-tag ::= tok-ident-text
# Built-in classes (approximated: any non-ASCII character in the BMP counts as a letter).
xid-start ::= [a-zA-Z\u0080-￿]
xid-continue ::= [a-zA-Z0-9_\u0080-￿]
# Scanner tokens (see the comments in moddil.ebnf).
tok-block-comment ::= "/*" block-comment-item* "*"+ "/"
block-comment-item ::= tok-block-comment | [^*/] | "/" [^*/] | "*"+ [^*/]
tok-raw-string ::= "b"? "r" ( "\"" [^"]* "\"" | "#\"" raw-char* "\"#" | "##\"" raw-char* "\"##" | "###\"" raw-char* "\"###" )
raw-char ::= [^"] | "\""
tok-block-string ::= "r"? "\"\"\"" [ \t]* "\n" ( [^\n]* "\n" )* [ \t]* "\"\"\""
tok-tagged-string ::= tok-tag ( tagged-body | tok-raw-string | tok-block-string )
tagged-body ::= "\"" ( [^"\\{}] | tok-escape | "{{" | "}}" | "{" hole* "}" )* "\""
hole ::= [^{}"] | tok-string | "{" hole* "}"
