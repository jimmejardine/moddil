// Tokens
WHITESPACE: /(?:[ \t\r\n])+/
LINE_COMMENT: /(?:\/\/(?:[^\/!\n](?:[^\n])*)?|\/\/\/\/(?:[^\n])*)/
BLOCK_COMMENT: /\/\*(?:[^*\/]|\*(?!\/)|\/(?!\*)|\/\*(?:[^*]|\*(?!\/))*\*\/)*\*\//
DOC_OUTER: /\/\/\/(?:[^\/\n](?:[^\n])*)?/
DOC_INNER: /\/\/!(?:[^\n])*/
IDENT: /(?!(?:dimension|invariant|continue|errdefer|property|requires|default|ensures|suspend|always|escape|extern|inline|linear|nondet|resume|return|select|static|struct|unsafe|bench|break|catch|const|defer|false|group|match|spawn|super|trait|where|while|yield|else|enum|fail|from|impl|loop|note|self|Self|test|true|type|unit|view|with|dyn|for|gen|let|mod|mut|pub|ref|try|use|as|fn|if|in)\b)(?:(?:[^\W\d](?:\w)*|_(?:\w)+))/
IDENT_TEXT: /(?:[^\W\d](?:\w)*|_(?:\w)+)/
LABEL: /'(?:(?:[^\W\d](?:\w)*|_(?:\w)+))/
INTEGER: /(?:(?:[0-9](?:[0-9_])*)|0x(?:[0-9a-fA-F_])+|0o(?:[0-7_])+|0b(?:[01_])+)/
FLOAT: /(?:(?:[0-9](?:[0-9_])*)\.[0-9](?:[0-9_])*(?:(?:[eE](?:[\+\-])?(?:[0-9_])+))?|(?:[0-9](?:[0-9_])*)(?:[eE](?:[\+\-])?(?:[0-9_])+))/
DEC_DIGITS: /[0-9](?:[0-9_])*/
EXPONENT: /[eE](?:[\+\-])?(?:[0-9_])+/
STRING: /"(?:(?:[^"\\]|(?:\\(?:[nrt0\\"'s]|x(?:[0-9a-fA-F])(?:[0-9a-fA-F])|u\{(?:(?:[0-9a-fA-F]))+\}))))*"/
BYTE_STRING: /b"(?:(?:[^"\\]|(?:\\(?:[nrt0\\"'s]|x(?:[0-9a-fA-F])(?:[0-9a-fA-F])|u\{(?:(?:[0-9a-fA-F]))+\}))))*"/
CHAR: /'(?:[^'\\\n]|(?:\\(?:[nrt0\\"'s]|x(?:[0-9a-fA-F])(?:[0-9a-fA-F])|u\{(?:(?:[0-9a-fA-F]))+\})))'/
BYTE: /b'(?:[^'\\\n]|(?:\\(?:[nrt0\\"'s]|x(?:[0-9a-fA-F])(?:[0-9a-fA-F])|u\{(?:(?:[0-9a-fA-F]))+\})))'/
ESCAPE: /\\(?:[nrt0\\"'s]|x(?:[0-9a-fA-F])(?:[0-9a-fA-F])|u\{(?:(?:[0-9a-fA-F]))+\})/
HEX: /[0-9a-fA-F]/
RAW_STRING: /b?r(#*)"[\s\S]*?"\1/
BLOCK_STRING: /r?"""[ \t]*\n(?:[^\n]*\n)*?[ \t]*"""/
TAGGED_STRING: /(?!(?:r|b|br)")[^\W\d]\w*(?:"""[ \t]*\n(?:[^\n]*\n)*?[ \t]*"""|"(?:[^"\\{}]|\\.|\{\{|\}\}|\{(?:[^{}"]|"(?:[^"\\]|\\.)*"|\{[^{}]*\})*\})*"|r(#*)"[\s\S]*?"\1)/
TAG: /(?!(?:br|r|b)\b)(?:(?:[^\W\d](?:\w)*|_(?:\w)+))/
%ignore WHITESPACE
%ignore LINE_COMMENT
%ignore BLOCK_COMMENT
