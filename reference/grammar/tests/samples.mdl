unit km = 1000 * m;
unit degC = K + 273.15;
dimension Velocity = Length / Time;

#[derive(Copy, Clone)]
struct Pair(u8, u8);

linear struct Txn { id: u64 }

view Rows<T> { buf: &[T], at: int }

gen fn guard(start: Pos) -> Action resume first: Frame {
    let mut f = first;
    loop {
        while !f.sees() { f = yield Action::Patrol }
        f = yield Action::Shout;
    }
}

