        SELECT id FROM t WHERE x = {x}
        """;
    let ok = 0 <= q < 10 && q in 1..10;
    let paths = \Order.customer.email;
    let f = |x: int| x * 2;
    let g = || 0;
    'outer: for i in 0..3 {
        if const target.os == Os::Linux { break 'outer }
        if let Some(v) = maybe && v > 0 { continue }
    }
    let wrapped = h *% 31 +% 7;
    let first = xs[.., 1..3];
    let found = try { lookup(k)? fmt"looking up {k}" } catch { NotFound => none() };
    defer { done() }
    errdefer cleanup();
    unsafe("valid: checked above") { raw() }
    x.view().default(from: 1)
