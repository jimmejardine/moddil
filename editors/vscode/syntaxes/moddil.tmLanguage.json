{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Moddil",
  "scopeName": "source.moddil",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#chars"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.moddil",
          "match": "//[/!].*$"
        },
        {
          "name": "comment.line.double-slash.moddil",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.moddil",
          "begin": "\\b(fmt)\\\"\\\"\\\"",
          "end": "\\\"\\\"\\\"",
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.macro.moddil"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "include": "#holes"
            }
          ]
        },
        {
          "name": "string.quoted.triple.moddil",
          "begin": "\\b([a-z_][a-z0-9_]*)\\\"\\\"\\\"",
          "end": "\\\"\\\"\\\"",
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.macro.moddil"
            }
          }
        },
        {
          "name": "string.quoted.triple.moddil",
          "begin": "\\\"\\\"\\\"",
          "end": "\\\"\\\"\\\"",
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "string.quoted.raw.moddil",
          "begin": "\\b([a-z_][a-z0-9_]*)?r(#*)\\\"",
          "end": "\\\"\\2",
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.macro.moddil"
            }
          }
        },
        {
          "name": "string.quoted.double.moddil",
          "begin": "\\b(fmt)\\\"",
          "end": "\\\"",
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.macro.moddil"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "include": "#holes"
            }
          ]
        },
        {
          "name": "string.quoted.double.moddil",
          "begin": "\\b([a-z_][a-z0-9_]*)\\\"",
          "end": "\\\"",
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.macro.moddil"
            }
          },
          "patterns": [
            {
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.moddil",
          "begin": "b?\\\"",
          "end": "\\\"",
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        }
      ]
    },
    "escapes": {
      "name": "constant.character.escape.moddil",
      "match": "\\\\(?:[nrt0\\\\\\\"'s]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F_]+\\})"
    },
    "holes": {
      "patterns": [
        {
          "name": "constant.character.escape.moddil",
          "match": "\\{\\{|\\}\\}"
        },
        {
          "name": "meta.interpolation.moddil",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.moddil"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.moddil"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.moddil",
      "match": "b?'(?:[^'\\\\]|\\\\(?:[nrt0\\\\\\\"'s]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F_]+\\}))'"
    },
    "attributes": {
      "name": "meta.attribute.moddil",
      "begin": "#!?\\[",
      "end": "\\]",
      "patterns": [
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.moddil",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9_]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.moddil",
          "match": "\\b(?:0x[0-9a-fA-F_]+|0o[0-7_]+|0b[01_]+|[0-9][0-9_]*)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "constant.language.boolean.moddil",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "variable.language.self.moddil",
          "match": "\\b(?:self|Self)\\b"
        },
        {
          "name": "keyword.control.moddil",
          "match": "\\b(?:always|as|bench|break|catch|const|continue|default|defer|dimension|dyn|else|ensures|enum|errdefer|escape|extern|fail|fn|for|from|gen|group|if|impl|in|inline|invariant|let|linear|loop|match|mod|mut|nondet|note|property|pub|ref|requires|resume|return|select|spawn|static|struct|super|suspend|test|trait|try|type|unit|unsafe|use|view|where|while|with|yield)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.moddil",
          "match": "\\b(?:int|bool|char|str|i8|i16|i32|i64|i128|u8|u16|u32|u64|u128|isize|usize|f32|f64)\\b"
        },
        {
          "name": "entity.name.type.moddil",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([a-z_][a-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.moddil"
            }
          }
        }
      ]
    }
  }
}
